---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AboutIntro from '@/components/about/AboutIntro.astro';
import AboutSection from '@/components/about/AboutSection.astro';
import AboutField from '@/components/about/AboutField.astro';
import SectionProgress from '@/components/about/SectionProgress.astro';
import { education, experience, sectionLabels, skills, sundial } from '@/data/about';

// Only the glyphs of the sundial's handwritten note.
const hintFont = `https://fonts.googleapis.com/css2?family=Caveat:wght@500&text=${encodeURIComponent(sundial.hint)}&display=swap`;
---

<BaseLayout title="About" overlayNav>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={hintFont} />
  </Fragment>
  <AboutIntro />

  <!-- Starts just under the hero, so it peeks into the bottom of the screen when the hero releases. -->
  <!-- Bottom padding = the fixed section indicator's backing, so the last lines scroll clear of it. -->
  <div class="mx-auto max-w-[1120px] space-y-[112px] px-12 pb-[150px]">
    <AboutSection id="education" label={sectionLabels.education}>
      <div class="space-y-16">
        {
          education.map((entry) => (
            <article>
              <h3 class="mb-5 text-[28px] leading-[1.25] font-normal tracking-[-0.01em] text-[#111]">{entry.school}</h3>
              <dl class="space-y-5">
                {entry.fields.map((field) => (
                  <AboutField {...field} />
                ))}
              </dl>
            </article>
          ))
        }
      </div>
    </AboutSection>

    <AboutSection id="experience" label={sectionLabels.experience}>
      <ul class="divide-y divide-[#e5e5e5] border-y border-[#e5e5e5]">
        {
          experience.map((entry) => (
            <li class="py-6">
              <h3 class="text-[22px] leading-[1.3] font-normal text-[#111]">{entry.org}</h3>
              <p class="mt-1 text-[18px] leading-[1.4] text-meta">{entry.role}</p>
              <p class="mt-1.5 text-[14px] leading-[1.4] text-meta">{entry.year}</p>
            </li>
          ))
        }
      </ul>
    </AboutSection>

    <AboutSection id="skills" label={sectionLabels.skills}>
      <dl class="space-y-5">
        {skills.map((group) => <AboutField label={group.label} value={group.items.join(' / ')} />)}
      </dl>
    </AboutSection>
  </div>

  <SectionProgress
    sections={[
      { id: 'education', label: sectionLabels.education },
      { id: 'experience', label: sectionLabels.experience },
      { id: 'skills', label: sectionLabels.skills },
    ]}
  />
</BaseLayout>