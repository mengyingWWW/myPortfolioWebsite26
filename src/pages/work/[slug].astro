---
import { existsSync } from 'node:fs';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import ProjectHero from '@/components/project/ProjectHero.astro';
import MetaPanel from '@/components/project/MetaPanel.astro';
import NextProject from '@/components/project/NextProject.astro';
import TableOfContents from '@/components/case-study/TableOfContents.astro';
import BackToTop from '@/components/case-study/BackToTop.astro';
import AtAGlance from '@/components/case-study/AtAGlance.astro';
import ScreenWall from '@/components/case-study/ScreenWall.astro';
import { mdxComponents } from '@/components/mdx';
import { getSortedWork, type WorkEntry } from '@/lib/work';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const projects = await getSortedWork();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: WorkEntry;
  next: WorkEntry;
}

const { project, next } = Astro.props;
const { Content } = await render(project);

// Share card: the cover, letterboxed to 1200 × 627 by `npm run og` (the homepage card until that has run).
const shareImage = `/og/work/${project.id}.png`;
const share = {
  title: `${project.data.title} — ${site.fullName}`,
  description: project.data.subtitle ?? project.data.summary.split(/(?<=\.)\s/)[0],
  image: existsSync(new URL(`../../../public${shareImage}`, import.meta.url)) ? shareImage : undefined,
  imageAlt: project.data.coverAlt ?? project.data.title,
};

const accent = {
  main: '#C2410C',
  text: '#9A3412',
  tint: '#FFF4EE',
  soft: '#FFFBF8',
  border: '#F3C9B4',
  ...project.data.accent,
};
const accentTokens = {
  '--cs-accent': accent.main,
  '--cs-accent-text': accent.text,
  '--cs-accent-tint': accent.tint,
  '--cs-accent-soft': accent.soft,
  '--cs-accent-border': accent.border,
};
---

<BaseLayout title={project.data.title} description={share.description} noindex={project.data.noindex} share={share}>
  <article style={accentTokens}>
    <ProjectHero project={project} />
    <Container class="pt-20">
      <div
        class="grid grid-cols-[minmax(0,7fr)_minmax(0,5fr)] items-start gap-x-20 border-b border-line pb-10 max-[900px]:grid-cols-1 max-[900px]:gap-y-12"
      >
        <div>
          <h2 class="text-sm font-medium tracking-wide text-muted uppercase">Overview</h2>
          <p class="mt-3 max-w-[65ch] text-xl leading-relaxed">{project.data.summary}</p>
          {
            project.data.glance && (
              <div class="mt-8 max-w-[65ch]">
                <AtAGlance items={project.data.glance} />
              </div>
            )
          }
        </div>
        <MetaPanel project={project} />
      </div>
    </Container>
    {
      project.data.screenWall && (
        <Container class="pt-32">
          <ScreenWall {...project.data.screenWall} />
        </Container>
      )
    }
    <Container class="grid grid-cols-[200px_minmax(0,1fr)] gap-x-16 max-[900px]:grid-cols-1">
      <aside class="max-[900px]:hidden">
        <TableOfContents />
      </aside>
      <div class="prose-body case-body" data-case-body>
        <Content components={mdxComponents} />
      </div>
      <div class="col-start-2 max-[900px]:col-start-1">
        <BackToTop />
      </div>
    </Container>
  </article>
  {next.id !== project.id && <NextProject project={next} />}
</BaseLayout>

<style>
  /* Clear the sticky header when a section is reached by link or by the table of contents. */
  .case-body :global(h2) {
    scroll-margin-top: calc(5rem + 24px);
  }
</style>
