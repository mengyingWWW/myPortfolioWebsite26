---
/**
 * Custom cursor: a small bright dot that eases after the mouse and grows into a
 * labeled black circle over clickable elements (a, button, [role="button"], [data-cursor]).
 *
 * Per-element overrides:
 *   data-cursor-label="EMAIL"  label shown in the circle (default "VIEW")
 *   data-cursor="default"      keep the plain dot on a clickable element
 *   data-cursor="hide"         hide the custom cursor
 *   data-cursor (any other)    show the circle, even on non-clickable elements
 */
interface Props {
  /** Label shown when an element doesn't set data-cursor-label. */
  label?: string;
}

const { label = 'VIEW' } = Astro.props;
---

<div class="cursor" data-custom-cursor aria-hidden="true">
  <div class="cursor-pos" data-custom-cursor-part="pos">
    <div class="cursor-circle">
      <span class="cursor-label" data-custom-cursor-part="label">{label}</span>
    </div>
  </div>
</div>

<style>
  .cursor {
    --cursor-size: 80px;
    /* Dot size as a fraction of the circle: 18px / 80px. */
    --cursor-dot-scale: 0.225;
    /* One on-screen pixel at dot size, since the circle is scaled down. */
    --cursor-px: calc(1px / var(--cursor-dot-scale));
    --cursor-press: 1;

    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .cursor[data-visible] {
    opacity: 1;
  }

  .cursor[data-pressed] {
    --cursor-press: 0.85;
  }

  .cursor-pos {
    position: absolute;
    top: 0;
    left: 0;
    will-change: transform;
  }

  .cursor-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--cursor-size);
    height: var(--cursor-size);
    border-radius: 9999px;
    /* Bright dot; the hairline and soft shadow keep it visible on white. */
    background-color: rgb(255 255 255 / 0.9);
    box-shadow:
      0 0 0 var(--cursor-px) rgb(0 0 0 / 0.14),
      0 calc(var(--cursor-px) * 2) calc(var(--cursor-px) * 8) rgb(0 0 0 / 0.12);
    transform: translate(-50%, -50%) scale(calc(var(--cursor-dot-scale) * var(--cursor-press)));
    transition:
      transform 250ms ease-out,
      background-color 250ms ease-out,
      box-shadow 250ms ease-out;
  }

  .cursor-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #fff;
    opacity: 0;
    transition: opacity 150ms ease-out;
  }

  .cursor[data-state='view'] .cursor-circle {
    background-color: #000;
    box-shadow:
      0 0 0 0 rgb(0 0 0 / 0),
      0 0 0 0 rgb(0 0 0 / 0);
    transform: translate(-50%, -50%) scale(var(--cursor-press));
  }

  .cursor[data-state='view'] .cursor-label {
    opacity: 1;
    transition-delay: 80ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor,
    .cursor-circle,
    .cursor-label {
      transition: none;
    }
  }

  :global(html.has-custom-cursor),
  :global(html.has-custom-cursor *) {
    cursor: none !important;
  }

  :global(
    html.has-custom-cursor
      :is(
        input:not([type='checkbox'], [type='radio'], [type='range'], [type='button'], [type='submit'], [type='reset'], [type='file'], [type='color']),
        textarea,
        [contenteditable]:not([contenteditable='false'])
      )
  ) {
    cursor: text !important;
  }
</style>

<script>
  const EASE = 0.2;
  const TEXT_FIELD =
    'input:not([type="checkbox"], [type="radio"], [type="range"], [type="button"], [type="submit"], [type="reset"], [type="file"], [type="color"]), textarea, [contenteditable]:not([contenteditable="false"])';
  const CLICKABLE = 'a[href], button, [role="button"], [data-cursor]';

  const root = document.querySelector<HTMLElement>('[data-custom-cursor]');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (root && finePointer) initCursor(root);

  function initCursor(root: HTMLElement) {
    const pos = root.querySelector<HTMLElement>('[data-custom-cursor-part="pos"]')!;
    const label = root.querySelector<HTMLElement>('[data-custom-cursor-part="label"]')!;
    const defaultLabel = label.textContent ?? '';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const mouse = { x: -100, y: -100 };
    const current = { x: -100, y: -100 };
    let inside = false;
    let hasMoved = false;
    let state = 'default';

    document.documentElement.classList.add('has-custom-cursor');

    function resolveState(target: EventTarget | null): { state: string; label?: string } {
      if (!(target instanceof Element)) return { state: 'default' };
      if (target.closest(TEXT_FIELD)) return { state: 'hide' };
      const el = target.closest<HTMLElement>(CLICKABLE);
      if (!el) return { state: 'default' };
      const mode = el.dataset.cursor;
      if (mode === 'default' || mode === 'hide') return { state: mode };
      return { state: 'view', label: el.closest<HTMLElement>('[data-cursor-label]')?.dataset.cursorLabel };
    }

    function render() {
      root.dataset.state = state;
      root.toggleAttribute('data-visible', inside && hasMoved && state !== 'hide');
    }

    // Inside the page content, excluding the scrollbar gutter.
    const inViewport = (x: number, y: number) =>
      x >= 0 && y >= 0 && x < document.documentElement.clientWidth && y < document.documentElement.clientHeight;

    document.addEventListener('pointermove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      if (!hasMoved) {
        current.x = mouse.x;
        current.y = mouse.y;
        hasMoved = true;
      }
      inside = inViewport(e.clientX, e.clientY);
      render();
    });

    // mouseleave on <html> doesn't fire reliably when leaving onto the scrollbar or out of an
    // embedded browser, which left the cursor stranded at the edge.
    document.addEventListener('mouseout', (e) => {
      if (!e.relatedTarget || !inViewport(e.clientX, e.clientY)) {
        inside = false;
        render();
      }
    });
    window.addEventListener('blur', () => {
      inside = false;
      render();
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        inside = false;
        render();
      }
    });

    document.addEventListener('pointerover', (e) => {
      const next = resolveState(e.target);
      state = next.state;
      // Keep the old label while shrinking back so it doesn't flash a different word.
      if (state === 'view') label.textContent = next.label ?? defaultLabel;
      render();
    });

    document.documentElement.addEventListener('mouseleave', () => {
      inside = false;
      render();
    });

    document.documentElement.addEventListener('mouseenter', () => {
      inside = true;
      render();
    });

    document.addEventListener('pointerdown', () => root.setAttribute('data-pressed', ''));
    document.addEventListener('pointerup', () => root.removeAttribute('data-pressed'));
    window.addEventListener('blur', () => root.removeAttribute('data-pressed'));

    let last = performance.now();
    function tick(now: number) {
      const frames = Math.min(now - last, 100) / (1000 / 60);
      last = now;
      // Frame-rate independent lerp: same feel at 60Hz and 120Hz.
      const t = reducedMotion.matches ? 1 : 1 - Math.pow(1 - EASE, frames);

      current.x += (mouse.x - current.x) * t;
      current.y += (mouse.y - current.y) * t;
      pos.style.transform = `translate3d(${current.x}px, ${current.y}px, 0)`;

      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
</script>
