---
/**
 * Custom cursor (fine pointers with hover only; touch devices keep the native one).
 *
 * Default, a 14px dot in two zones:
 *   hero   (over [data-cursor-zone="hero"]): a crisp dark dot plus a soft cast shadow
 *          that trails behind it, offset down-right as if lit by the same sun.
 *   normal (everywhere else): a white dot with difference blending.
 * Over anything clickable (CLICKABLE below) it becomes one glass circle, the same everywhere: 64px,
 * with a label naming the action. The label comes from the nearest [data-cursor-label] (e.g.
 * "CLOSE", "DRAG"); links without one say "VIEW", other controls without one show no word. The
 * cursor is aria-hidden, so controls keep their own accessible names. Text fields keep the I-beam.
 * Page-wide: <html data-cursor-hidden> hides it wherever it is (the footer logo's sun stands in).
 *
 * The glass relies on backdrop-filter, which only sees the page if no ancestor is a backdrop root
 * (mix-blend-mode, filter, opacity < 1, isolation...). So the root stays a plain fixed child of
 * <body>, blend modes apply only to the dot, the visibility fade is on the shape itself, and sizes
 * animate width/height: transforms only position.
 *
 * The blur is kept low so text under the circle stays readable. For contrast the script samples
 * what's under the pointer (walking up from the hovered element: the pixels of the first image,
 * video or canvas, or the first non-transparent background) and sets data-tone: dark text on a
 * light glass, or white text on a darkened glass.
 */
interface Props {
  /** Label shown over links without their own data-cursor-label. */
  label?: string;
}

const { label = 'VIEW' } = Astro.props;
---

<div class="cursor" data-custom-cursor data-zone="normal" data-state="default" aria-hidden="true">
  <div class="cursor-pos" data-custom-cursor-part="shadow-pos">
    <div class="cursor-stretch" data-custom-cursor-part="stretch">
      <div class="cursor-shadow"></div>
    </div>
  </div>
  <div class="cursor-pos cursor-anchor" data-custom-cursor-part="pos">
    <div class="cursor-shape" data-custom-cursor-part="shape">
      <span class="cursor-label" data-custom-cursor-part="label">{label}</span>
    </div>
  </div>
</div>

<style>
  .cursor {
    --cursor-morph: 250ms ease-out;
    --cursor-press: 1;
    --cursor-diameter: 14px;
    --cursor-fill: #fff;

    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    pointer-events: none;
  }

  .cursor * {
    pointer-events: none;
  }

  .cursor[data-pressed] {
    --cursor-press: 0.85;
  }

  /* Blend modes only work on the outermost element (inner layers are isolated). Never over a
     clickable element: a blending root would hide the page from backdrop-filter. */
  .cursor[data-zone='normal'][data-state='default'] {
    mix-blend-mode: difference;
  }

  .cursor[data-zone='hero'][data-state='default'] {
    --cursor-fill: #111;
    mix-blend-mode: multiply;
  }

  .cursor[data-state='view'] {
    --cursor-diameter: 64px;
  }

  .cursor-pos {
    position: absolute;
    top: 0;
    left: 0;
  }

  .cursor-pos:not(.cursor-anchor) {
    will-change: transform;
  }

  /* A zero-size flex box centers the shape on the pointer while it grows, without a transform. */
  .cursor-anchor {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 0;
    height: 0;
  }

  .cursor-stretch {
    position: absolute;
    top: 0;
    left: 0;
  }

  /* Glass: a light blur and tint, a soft drop shadow, and a hairline edge plus inner highlight.
     The edge is an inset shadow because Chrome rounds a 0.5px border up to 1px. Shadows stay
     declared (transparent) outside the glass state so they fade with the grow/shrink instead of
     popping; shadow lists only interpolate when their shapes match. */
  .cursor-shape {
    position: relative;
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: calc(var(--cursor-diameter) * var(--cursor-press));
    height: calc(var(--cursor-diameter) * var(--cursor-press));
    border-radius: 50%;
    background-color: var(--cursor-fill);
    box-shadow:
      0 0 0 rgb(0 0 0 / 0),
      inset 0 0 0 0 rgb(0 0 0 / 0),
      inset 0 0 0 0 rgb(255 255 255 / 0);
    opacity: 0;
    transition:
      width var(--cursor-morph),
      height var(--cursor-morph),
      background-color 200ms ease,
      box-shadow var(--cursor-morph),
      backdrop-filter var(--cursor-morph),
      -webkit-backdrop-filter var(--cursor-morph),
      opacity 150ms ease;
  }

  .cursor[data-visible] .cursor-shape {
    opacity: 1;
  }

  .cursor-shape.cursor--glass {
    background-color: rgb(255 255 255 / 0.28);
    box-shadow:
      0 4px 14px rgb(0 0 0 / 0.12),
      inset 0 0 0 0.5px rgb(0 0 0 / 0.16),
      inset 0 0 0 1px rgb(255 255 255 / 0.5);
    -webkit-backdrop-filter: blur(2px) saturate(140%);
    backdrop-filter: blur(2px) saturate(140%);
    /* No opacity fade while glass: WebKit drops the backdrop blur while a backdrop-filtered
       element animates its opacity. */
    transition-property: width, height, background-color, box-shadow, backdrop-filter, -webkit-backdrop-filter;
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .cursor-shape.cursor--glass {
      background-color: rgb(255 255 255 / 0.85);
    }
    .cursor[data-tone='dark'] .cursor-shape.cursor--glass {
      background-color: rgb(28 28 28 / 0.85);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .cursor-shape.cursor--glass {
      background-color: rgb(255 255 255 / 0.92);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    .cursor[data-tone='dark'] .cursor-shape.cursor--glass {
      background-color: rgb(28 28 28 / 0.92);
    }
  }

  /* Over a dark backdrop (data-tone, sampled in the script) the glass darkens and the label turns
     white. 0.6 keeps white text at 4.5:1 even where a small light detail the sampling can't see
     (a slider's divider or tag) passes under the label. */
  .cursor[data-tone='dark'] .cursor-shape.cursor--glass {
    background-color: rgb(17 17 17 / 0.6);
    box-shadow:
      0 4px 14px rgb(0 0 0 / 0.2),
      inset 0 0 0 0.5px rgb(255 255 255 / 0.22),
      inset 0 0 0 1px rgb(255 255 255 / 0.1);
  }

  .cursor-label {
    position: relative;
    font-size: 10px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #111;
    text-shadow: 0 0 6px rgb(255 255 255 / 0.8);
    opacity: 0;
    transition:
      opacity 150ms ease-out,
      color 200ms ease,
      text-shadow 200ms ease;
  }

  .cursor[data-tone='dark'] .cursor-label {
    color: #fff;
    text-shadow: 0 0 6px rgb(0 0 0 / 0.6);
  }

  .cursor[data-state='view'] .cursor-label {
    opacity: 1;
    transition-delay: 100ms;
  }

  /* Same gray as the darkest leaf shadow (--shadow-alpha comes from SHADOW_DARKNESS);
     multiply deepens it where it overlaps a leaf shadow, like real overlapping shade.
     --cursor-shadow-peak offsets the blur thinning the center of such a small shape. */
  .cursor-shadow {
    --cursor-shadow-peak: 1.12;
    width: 59px;
    height: 59px;
    border-radius: 46% 54% 58% 42% / 52% 44% 56% 48%;
    background-color: rgb(0 0 0 / calc(var(--shadow-alpha, 0.18) * var(--cursor-shadow-peak)));
    filter: blur(14px);
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 250ms ease-out;
    animation: cursor-dapple 4s ease-in-out infinite alternate;
  }

  .cursor[data-visible][data-zone='hero'][data-state='default'] .cursor-shadow {
    opacity: 1;
  }

  @keyframes cursor-dapple {
    to {
      border-radius: 58% 42% 44% 56% / 46% 58% 42% 54%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-shape,
    .cursor-label,
    .cursor-shadow {
      transition: none;
    }

    .cursor-shadow {
      animation: none;
    }
  }

  :global(html.has-custom-cursor),
  :global(html.has-custom-cursor *) {
    cursor: none !important;
  }

  :global(
    html.has-custom-cursor
      :is(
        input:not([type='checkbox'], [type='radio'], [type='range'], [type='button'], [type='submit'], [type='reset'], [type='file'], [type='color']),
        textarea,
        [contenteditable]:not([contenteditable='false'])
      )
  ) {
    cursor: text !important;
  }
</style>

<script>
  /** Dot follow lerp per zone (at 60fps); 1 = exactly at the pointer. */
  const DOT_EASE = { hero: 1, normal: 0.2 };
  /** Shadow follow lerp (at 60fps); lower than the dot so it trails slightly behind. */
  const SHADOW_EASE = 0.28;
  /** Resting offset of the cast shadow from the pointer, in px. */
  const SHADOW_OFFSET = { x: 14, y: 20 };
  /** Max elongation of the shadow along its direction of travel. */
  const MAX_STRETCH = 1.12;
  /** Shadow speed (px per frame) that reaches MAX_STRETCH. */
  const STRETCH_SPEED = 20;
  const TEXT_FIELD =
    'input:not([type="checkbox"], [type="radio"], [type="range"], [type="button"], [type="submit"], [type="reset"], [type="file"], [type="color"]), textarea, [contenteditable]:not([contenteditable="false"])';
  const CLICKABLE =
    'a[href], button, [role="button"], summary, label[for], [data-cursor="view"], [onclick], input[type="button"], input[type="submit"], input[type="reset"], input[type="range"]';
  const LINK = 'a[href], [data-cursor="view"]';
  const LABELLED = '[data-cursor-label]';
  const HERO_ZONE = '[data-cursor-zone="hero"]';

  type Zone = 'hero' | 'normal';
  type State = 'default' | 'view' | 'hide';
  type Tone = 'light' | 'dark';

  /** Luminance hysteresis: go dark below the first, back to light above the second. */
  const DARK_BELOW = 0.42;
  const LIGHT_ABOVE = 0.5;
  const MEDIA = 'img, video, canvas';

  type RGB = [number, number, number];
  const luma = ([r, g, b]: RGB) => (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;

  /** Downscaled width media pixels are read at; plenty for an average under a 64px circle. */
  const SAMPLE_WIDTH = 96;
  /** Radius of the view circle, and the sample grid across it: (2n+1)² points inside the circle. */
  const SAMPLE_RADIUS = 32;
  const SAMPLE_STEPS = 4;

  /** sRGB channels of an opaque-enough computed color; null when (nearly) transparent. */
  function parseColor(value: string): RGB | null {
    const m = value.match(/rgba?\(([\d.]+),\s*([\d.]+),\s*([\d.]+)(?:,\s*([\d.]+))?\)/);
    if (!m || (m[4] !== undefined && Number(m[4]) < 0.1)) return null;
    return [Number(m[1]), Number(m[2]), Number(m[3])];
  }

  const sampleCanvas = document.createElement('canvas');
  const sampleCtx = sampleCanvas.getContext('2d', { willReadFrequently: true });
  /** Still images never change, so their pixels are read once; video frames are read each time. */
  const imageCache = new WeakMap<Element, ImageData | null>();

  function mediaPixels(el: HTMLImageElement | HTMLVideoElement | HTMLCanvasElement): ImageData | null {
    if (el instanceof HTMLImageElement && imageCache.has(el)) return imageCache.get(el)!;
    const [w, h] =
      el instanceof HTMLImageElement
        ? [el.complete ? el.naturalWidth : 0, el.naturalHeight]
        : el instanceof HTMLVideoElement
          ? [el.readyState >= 2 ? el.videoWidth : 0, el.videoHeight]
          : [el.width, el.height];
    if (!w || !h || !sampleCtx) return null;
    let data: ImageData | null = null;
    try {
      sampleCanvas.width = SAMPLE_WIDTH;
      sampleCanvas.height = Math.max(1, Math.round((SAMPLE_WIDTH * h) / w));
      sampleCtx.drawImage(el, 0, 0, sampleCanvas.width, sampleCanvas.height);
      data = sampleCtx.getImageData(0, 0, sampleCanvas.width, sampleCanvas.height);
    } catch {
      data = null; // Cross-origin media taints the canvas.
    }
    if (el instanceof HTMLImageElement) imageCache.set(el, data);
    return data;
  }

  /** Average luminance of media as displayed under the circle (object-fit cover/contain/fill); null if unreadable. */
  function mediaLuma(el: HTMLImageElement | HTMLVideoElement | HTMLCanvasElement, cx: number, cy: number): number | null {
    const data = mediaPixels(el);
    if (!data) return null;
    const style = getComputedStyle(el);
    const box = el.getBoundingClientRect();
    const fit = style.objectFit;
    const sx = box.width / data.width;
    const sy = box.height / data.height;
    const [kx, ky] =
      fit === 'fill' ? [sx, sy] : fit === 'contain' ? [Math.min(sx, sy), Math.min(sx, sy)] : [Math.max(sx, sy), Math.max(sx, sy)];
    const left = box.left + (box.width - data.width * kx) / 2;
    const top = box.top + (box.height - data.height * ky) / 2;
    // A multiply-blended cover is tinted by the background behind it.
    const tint = style.mixBlendMode === 'multiply' && el.parentElement ? parseColor(getComputedStyle(el.parentElement).backgroundColor) : null;
    let sum = 0;
    let n = 0;
    for (let i = -SAMPLE_STEPS; i <= SAMPLE_STEPS; i++) {
      for (let j = -SAMPLE_STEPS; j <= SAMPLE_STEPS; j++) {
        if (i * i + j * j > SAMPLE_STEPS * SAMPLE_STEPS) continue;
        const x = cx + (i / SAMPLE_STEPS) * SAMPLE_RADIUS;
        const y = cy + (j / SAMPLE_STEPS) * SAMPLE_RADIUS;
        if (x < box.left || x >= box.right || y < box.top || y >= box.bottom) continue;
        const u = Math.floor((x - left) / kx);
        const v = Math.floor((y - top) / ky);
        if (u < 0 || v < 0 || u >= data.width || v >= data.height) continue;
        const k = (v * data.width + u) * 4;
        let c: RGB = [data.data[k], data.data[k + 1], data.data[k + 2]];
        if (tint) c = c.map((ch, ci) => (ch * tint[ci]) / 255) as RGB;
        sum += luma(c);
        n++;
      }
    }
    return n ? sum / n : null;
  }

  /**
   * Luminance (0–1) of what's under a point: walking up from the element there, the first media
   * (its pixels under the circle, or dark when they can't be read) or non-transparent background.
   */
  function backdropLuma(x: number, y: number): number {
    for (let el = document.elementFromPoint(x, y); el; el = el.parentElement) {
      if (el.matches(MEDIA)) return mediaLuma(el as HTMLImageElement | HTMLVideoElement | HTMLCanvasElement, x, y) ?? 0;
      const c = parseColor(getComputedStyle(el).backgroundColor);
      if (c) return luma(c);
    }
    return 1;
  }

  const root = document.querySelector<HTMLElement>('[data-custom-cursor]');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (root && finePointer) initCursor(root);

  function initCursor(root: HTMLElement) {
    const part = (name: string) => root.querySelector<HTMLElement>(`[data-custom-cursor-part="${name}"]`)!;
    const pos = part('pos');
    const shape = part('shape');
    const shadowPos = part('shadow-pos');
    const stretchEl = part('stretch');
    const label = part('label');
    const defaultLabel = label.textContent ?? '';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const mouse = { x: -100, y: -100 };
    const dot = { x: -100, y: -100 };
    const shadow = { x: -100, y: -100 };
    let inside = false;
    let hasMoved = false;
    let state: State = 'default';
    let zone: Zone = 'normal';
    let tone: Tone = 'light';
    /** Set when the pointer or the page moved; the tone is re-sampled on the next frame. */
    let toneDirty = true;

    let stretch = 1;
    let angle = 0;

    document.documentElement.classList.add('has-custom-cursor');

    function resolveState(target: Element | null): { state: State; label?: string } {
      if (document.documentElement.hasAttribute('data-cursor-hidden')) return { state: 'hide' };
      if (!target) return { state: 'default' };
      if (target.closest(TEXT_FIELD)) return { state: 'hide' };
      const el = target.closest(CLICKABLE);
      if (!el) return { state: 'default' };
      // Buttons and controls name their own action; only links fall back to the default word.
      const named = target.closest<HTMLElement>(LABELLED)?.dataset.cursorLabel;
      return { state: 'view', label: named ?? (el.matches(LINK) ? defaultLabel : '') };
    }

    // Overlays drawn above the hero (the nav) count as hero too, hence the rect check.
    function resolveZone(target: Element | null, x: number, y: number): Zone {
      if (target?.closest(HERO_ZONE)) return 'hero';
      for (const zoneEl of document.querySelectorAll(HERO_ZONE)) {
        const r = zoneEl.getBoundingClientRect();
        if (x >= r.left && x < r.right && y >= r.top && y < r.bottom) return 'hero';
      }
      return 'normal';
    }

    function updateTone() {
      toneDirty = false;
      const l = backdropLuma(mouse.x, mouse.y);
      if (tone === 'light' && l < DARK_BELOW) tone = 'dark';
      else if (tone === 'dark' && l > LIGHT_ABOVE) tone = 'light';
      if (root.dataset.tone !== tone) root.dataset.tone = tone;
    }

    let hovered: Element | null = null;

    function update(target: Element | null) {
      hovered = target;
      toneDirty = true;
      const next = resolveState(target);
      // Pick the tone before the circle appears, so it never flashes the wrong one.
      if (next.state === 'view' && state !== 'view') updateTone();
      state = next.state;
      zone = resolveZone(target, mouse.x, mouse.y);
      // Keep the old label while shrinking back so it doesn't flash a different word.
      if (next.label !== undefined && label.textContent !== next.label) label.textContent = next.label;
      render();
    }

    // A control can change its action under a still pointer (a clip's PLAY becomes PAUSE).
    new MutationObserver((records) => {
      if (state === 'view' && hovered && records.some((r) => r.target.contains(hovered))) update(hovered);
    }).observe(document.body, { subtree: true, attributes: true, attributeFilter: ['data-cursor-label'] });

    function render() {
      root.dataset.state = state;
      root.dataset.zone = zone;
      shape.classList.toggle('cursor--glass', state === 'view');
      root.toggleAttribute('data-visible', inside && hasMoved && state !== 'hide');
    }

    // Inside the page content, excluding the scrollbar gutter.
    const inViewport = (x: number, y: number) =>
      x >= 0 && y >= 0 && x < document.documentElement.clientWidth && y < document.documentElement.clientHeight;

    document.addEventListener('pointermove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      if (!hasMoved) {
        dot.x = mouse.x;
        dot.y = mouse.y;
        shadow.x = mouse.x + SHADOW_OFFSET.x;
        shadow.y = mouse.y + SHADOW_OFFSET.y;
        hasMoved = true;
      }
      inside = inViewport(e.clientX, e.clientY);
      update(e.target instanceof Element ? e.target : null);
    });

    // The page can scroll under a still mouse, changing both the element and the zone.
    let scrollQueued = false;
    window.addEventListener(
      'scroll',
      () => {
        if (scrollQueued || !hasMoved) return;
        scrollQueued = true;
        requestAnimationFrame(() => {
          scrollQueued = false;
          update(document.elementFromPoint(mouse.x, mouse.y));
        });
      },
      { passive: true },
    );

    // mouseleave on <html> doesn't fire reliably when leaving onto the scrollbar or out of an
    // embedded browser, which left the cursor stranded at the edge.
    const hide = () => {
      inside = false;
      render();
    };
    document.addEventListener('mouseout', (e) => {
      if (!e.relatedTarget || !inViewport(e.clientX, e.clientY)) hide();
    });
    document.documentElement.addEventListener('mouseleave', hide);
    window.addEventListener('blur', hide);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) hide();
    });

    document.addEventListener('pointerdown', () => root.setAttribute('data-pressed', ''));
    document.addEventListener('pointerup', () => root.removeAttribute('data-pressed'));
    window.addEventListener('blur', () => root.removeAttribute('data-pressed'));

    // Frame-rate independent lerp factor: same feel at 60Hz and 120Hz.
    const lerpFactor = (ease: number, frames: number) => (ease >= 1 ? 1 : 1 - Math.pow(1 - ease, frames));

    let last = performance.now();
    function tick(now: number) {
      const frames = Math.min(now - last, 100) / (1000 / 60);
      last = now;
      const reduced = reducedMotion.matches;

      const td = reduced ? 1 : lerpFactor(DOT_EASE[zone], frames);
      dot.x += (mouse.x - dot.x) * td;
      dot.y += (mouse.y - dot.y) * td;
      pos.style.transform = `translate3d(${dot.x}px, ${dot.y}px, 0)`;
      if (state === 'view' && toneDirty) updateTone();

      // The shadow trails behind and stretches along its direction of travel.
      const ts = reduced ? 1 : lerpFactor(SHADOW_EASE, frames);
      const prevX = shadow.x;
      const prevY = shadow.y;
      shadow.x += (mouse.x + SHADOW_OFFSET.x - shadow.x) * ts;
      shadow.y += (mouse.y + SHADOW_OFFSET.y - shadow.y) * ts;
      shadowPos.style.transform = `translate3d(${shadow.x}px, ${shadow.y}px, 0)`;

      const vx = (shadow.x - prevX) / Math.max(frames, 0.01);
      const vy = (shadow.y - prevY) / Math.max(frames, 0.01);
      const speed = Math.hypot(vx, vy);
      if (speed > 0.5) angle = Math.atan2(vy, vx);
      const targetStretch = reduced ? 1 : 1 + (MAX_STRETCH - 1) * Math.min(speed / STRETCH_SPEED, 1);
      stretch += (targetStretch - stretch) * (1 - Math.pow(0.8, frames));
      stretchEl.style.transform = `rotate(${angle}rad) scale(${stretch}, ${1 / Math.sqrt(stretch)}) rotate(${-angle}rad)`;

      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
</script>
