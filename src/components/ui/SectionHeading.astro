---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div class:list={['mb-12 flex items-baseline justify-between border-b border-line pb-4', className]}>
  <h2 class="text-sm font-medium tracking-wide text-muted uppercase">{title}</h2>
  <slot />
</div>
