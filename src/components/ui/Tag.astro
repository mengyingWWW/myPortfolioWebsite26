---
interface Props {
  variant?: 'outline' | 'solid';
  class?: string;
}

const { variant = 'outline', class: className } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-full px-3 py-1 text-xs leading-none',
    variant === 'solid' ? 'bg-ink text-paper' : 'border border-line text-muted',
    className,
  ]}
>
  <slot />
</span>
