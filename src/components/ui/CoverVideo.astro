---
/**
 * A looping clip laid over part of a cover image (e.g. a device screen). Decorative: the cover keeps its alt.
 * The layer covers the image box and repeats the card's cover transform (--cover-shift-x/y, --cover-scale),
 * so the clip stays on the screen however the cover is framed. Without those variables it sits untransformed.
 *   mode="hover":    loads on first hover / keyboard focus of the enclosing link, plays from the start
 *                    while hovered, then pauses and fades out. Only on devices that can hover.
 *   mode="autoplay": loads and plays while in view.
 * With reduced motion it is removed and never loads.
 */
interface Props {
  /** Path to the .mp4 under public/; a .jpg of the same name is the poster. */
  src: string;
  /** The area to cover, in % of the cover image. */
  screen: { x: number; y: number; w: number; h: number };
  mode: 'hover' | 'autoplay';
}

const { src, screen, mode } = Astro.props;
const poster = src.replace(/\.mp4$/, '.jpg');
---

<div class:list={['cv-layer', `is-${mode}`]} data-cover-video={mode} aria-hidden="true">
  <video
    class="cv-video"
    style={`left:${screen.x}%;top:${screen.y}%;width:${screen.w}%;height:${screen.h}%`}
    data-src={src}
    data-poster={poster}
    autoplay={mode === 'autoplay'}
    muted
    loop
    playsinline
    preload="none"></video>
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canHover = window.matchMedia('(hover: hover)').matches;

  for (const layer of document.querySelectorAll<HTMLElement>('[data-cover-video]')) {
    const video = layer.querySelector('video')!;
    const mode = layer.dataset.coverVideo;
    if (reduceMotion || (mode === 'hover' && !canHover)) {
      layer.remove();
      continue;
    }

    const load = () => {
      if (video.src) return;
      video.poster = video.dataset.poster!;
      video.src = video.dataset.src!;
    };
    const play = () => video.play().catch(() => {});

    if (mode === 'hover') {
      const host = layer.closest<HTMLElement>('a') ?? layer.parentElement!;
      const start = () => {
        load();
        if (video.currentTime) video.currentTime = 0;
        play();
        layer.classList.add('is-on');
      };
      const stop = () => {
        video.pause();
        layer.classList.remove('is-on');
      };
      // Rewind once hidden, so the next hover opens on the first frame (which matches the still), not the last one shown.
      video.addEventListener('transitionend', () => {
        if (!layer.classList.contains('is-on')) video.currentTime = 0;
      });
      host.addEventListener('pointerenter', start);
      host.addEventListener('pointerleave', stop);
      host.addEventListener('focusin', () => host.matches(':focus-visible') && start());
      host.addEventListener('focusout', stop);
    } else {
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          load();
          play();
        } else {
          video.pause();
        }
      }).observe(layer);
    }
  }
</script>

<style>
  .cv-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transform: translate(var(--cover-shift-x, 0%), var(--cover-shift-y, 0%)) scale(var(--cover-scale, 1));
    transform-origin: 0 0;
  }
  .cv-video {
    position: absolute;
    object-fit: cover;
    object-position: top;
    border-radius: 3px;
  }
  .is-hover .cv-video {
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .is-hover.is-on .cv-video {
    opacity: 1;
  }
</style>
