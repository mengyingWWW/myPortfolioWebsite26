---
/**
 * A looping clip laid over part of a cover image (e.g. a device screen). Decorative: the cover keeps its alt.
 * The layer covers the image box and repeats the card's cover transform (--cover-shift-x/y, --cover-scale),
 * so the clip stays on the screen however the cover is framed. Without those variables it sits untransformed.
 *   mode="card":     preloads once the enclosing link enters the viewport. With a mouse it plays
 *                    from the start while the link is hovered or keyboard-focused, then pauses and fades out.
 *                    On touch screens it plays while its card is at least 60% in view; of several such cards,
 *                    only the most visible one plays, plus any tied with it (cards side by side in one row).
 *   mode="autoplay": loads and plays while in view.
 * With reduced motion it is removed and never loads.
 */
interface Props {
  /** Path to the .mp4 under public/; a .jpg of the same name is the poster. */
  src: string;
  /** The area to cover, in % of the cover image. */
  screen: { x: number; y: number; w: number; h: number };
  mode: 'card' | 'autoplay';
  /** Match the cover image's blend (e.g. "multiply") so a full-bleed clip doesn't flash white. */
  blend?: string;
}

const { src, screen, mode, blend } = Astro.props;
const poster = src.replace(/\.mp4$/, '.jpg');
/** Blend on the layer, not the video: .cv-layer's transform creates a stacking context that would
 *  otherwise confine mix-blend-mode to the layer (so a white video never tints into the card). */
const layerStyle = blend ? `mix-blend-mode:${blend}` : undefined;
const videoStyle = `left:${screen.x}%;top:${screen.y}%;width:${screen.w}%;height:${screen.h}%`;
---

<div class:list={['cv-layer', `is-${mode}`, blend && 'is-blend']} style={layerStyle} data-cover-video={mode} aria-hidden="true">
  <video
    class="cv-video"
    style={videoStyle}
    data-src={src}
    data-poster={poster}
    autoplay={mode === 'autoplay'}
    muted
    loop
    playsinline
    preload="none"></video>
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  /** Touch: of the card clips ≥ 60% in view, the most visible one plays. Cards tied with it (e.g. side by
   *  side in one row, which are always equally visible) play too. */
  const TOUCH_MIN_RATIO = 0.6;
  const TIE = 0.02;
  const touchRatios = new Map<HTMLElement, number>();
  const touchControls = new Map<HTMLElement, { start: () => void; stop: () => void }>();
  const touchPlaying = new Set<HTMLElement>();
  const pickTouchCards = () => {
    const best = Math.max(0, ...touchRatios.values());
    for (const [layer, ratio] of touchRatios) {
      const on = best >= TOUCH_MIN_RATIO && ratio >= best - TIE;
      if (on === touchPlaying.has(layer)) continue;
      if (on) {
        touchPlaying.add(layer);
        touchControls.get(layer)!.start();
      } else {
        touchPlaying.delete(layer);
        touchControls.get(layer)!.stop();
      }
    }
  };

  for (const layer of document.querySelectorAll<HTMLElement>('[data-cover-video]')) {
    const video = layer.querySelector('video')!;
    const mode = layer.dataset.coverVideo;
    if (reduceMotion) {
      layer.remove();
      continue;
    }

    const load = () => {
      if (video.src) return;
      video.preload = 'auto';
      video.poster = video.dataset.poster!;
      video.src = video.dataset.src!;
    };
    const play = () => video.play().catch(() => {});

    if (mode === 'card') {
      const host = layer.closest<HTMLElement>('a') ?? layer.parentElement!;
      // Shown only once a frame is actually playing, so a slow first load never fades in an empty box.
      video.addEventListener('playing', () => {
        if (layer.classList.contains('is-on')) layer.classList.add('is-ready');
      });
      const start = () => {
        load();
        if (video.currentTime) video.currentTime = 0;
        play();
        layer.classList.add('is-on');
      };
      const stop = () => {
        video.pause();
        layer.classList.remove('is-on', 'is-ready');
      };
      // Rewind once hidden, so the next play opens on the first frame (which matches the still), not the last one shown.
      video.addEventListener('transitionend', () => {
        if (!layer.classList.contains('is-on')) video.currentTime = 0;
      });

      if (finePointer) {
        host.addEventListener('pointerenter', start);
        host.addEventListener('pointerleave', stop);
        host.addEventListener('focusin', () => host.matches(':focus-visible') && start());
        host.addEventListener('focusout', stop);
      } else {
        touchControls.set(layer, { start, stop });
        new IntersectionObserver(
          ([entry]) => {
            touchRatios.set(layer, entry.isIntersecting ? entry.intersectionRatio : 0);
            pickTouchCards();
          },
          { threshold: [0, 0.2, 0.4, 0.5, 0.6, 0.7, 0.8, 0.9, 1] },
        ).observe(host);
      }

      // Download once the card is on screen, ahead of the first play. No margin: the first row sits just below
      // the full-height hero, so any look-ahead would load it with the page.
      const preload = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) return;
        load();
        preload.disconnect();
      });
      preload.observe(host);
    } else {
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          load();
          play();
        } else {
          video.pause();
        }
      }).observe(layer);
    }
  }
</script>

<style>
  .cv-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transform: translate(var(--cover-shift-x, 0%), var(--cover-shift-y, 0%)) scale(var(--cover-scale, 1));
    transform-origin: 0 0;
  }
  .cv-video {
    position: absolute;
    object-fit: cover;
    object-position: top;
    border-radius: 3px;
  }
  .is-card .cv-video {
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .is-card.is-on.is-ready .cv-video {
    opacity: 1;
  }
</style>
