---
/**
 * The MW monogram. The nav mark stays two semi-transparent "glass" strokes. The live footer
 * variant is a pencil drawing (one graphite colour) with a hatched shadow and a sun that
 * follow Seattle's real sun (a hollow moon at night). Around it the pointer becomes the sun:
 * the shadow falls away from it, and it sets below the ground line.
 */
import {
  DEFAULT_SHADOW,
  GROUND,
  LIVE_VIEWBOX,
  MARK_VIEWBOX,
  M_POINTS,
  STROKE,
  SUN_R,
  W_POINTS,
  shadowPath,
  sunSpot,
  toPath,
} from '@/lib/monogram';

interface Props {
  variant?: 'mark' | 'live';
  theme?: 'light' | 'dark';
  /** Accessible name; without one the logo is decorative. */
  label?: string;
  class?: string;
}

const { variant = 'mark', theme = 'light', label, class: className } = Astro.props;
const live = variant === 'live';
const sun = sunSpot(DEFAULT_SHADOW.dir);

const LIVE_WIDTH = 262;
const [viewX, , viewWidth] = LIVE_VIEWBOX.split(' ').map(Number);
const [markX, , markWidth] = MARK_VIEWBOX.split(' ').map(Number);
/** The hint starts 20px right of the letters. */
const hintLeft = Math.round(((markX + markWidth - viewX) / viewWidth) * LIVE_WIDTH + 20);
/** Screen px → viewBox units at the live logo's width. */
const toUnits = (px: number) => (px * viewWidth) / LIVE_WIDTH;
const LETTER_W = toUnits(2.2);
const GROUND_W = toUnits(1.5);
const GROUND_EXT = toUnits(12);
/** Same clearance the shadow keeps from the drawing's edge. */
const groundX0 = viewX + STROKE * 1.5;
const groundX1 = viewX + viewWidth - STROKE * 1.5;

const Wrapper = live ? 'div' : Fragment;
const wrapperProps = live ? { class: className, 'data-mw-zone': '' } : {};
---

<Wrapper {...wrapperProps}>
  <svg
    class:list={['mw-logo block', live ? 'h-auto' : ['h-[22px] w-auto', className]]}
    style={live ? `width: ${LIVE_WIDTH}px` : undefined}
    data-mw-letter-w={live ? LETTER_W : undefined}
    data-mw-ground-w={live ? GROUND_W : undefined}
    data-mw-ground-x0={live ? groundX0 : undefined}
    data-mw-ground-x1={live ? groundX1 : undefined}
    data-mw-ground-ext={live ? GROUND_EXT : undefined}
    data-theme={theme}
    data-variant={variant}
    viewBox={live ? LIVE_VIEWBOX : MARK_VIEWBOX}
    xmlns="http://www.w3.org/2000/svg"
    role={label ? 'img' : undefined}
    aria-label={label}
    aria-hidden={label ? undefined : 'true'}
  >
    {
      live && (
        <>
          <defs>
            <pattern id="mw-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(-38)">
              <line x1="0" y1="0" x2="0" y2="5" stroke="#2A2A2A" stroke-width="1.2" />
            </pattern>
            <mask id="mw-shadow-mask" maskUnits="userSpaceOnUse" x="-500" y={GROUND - 80} width="1500" height="240">
              <path
                d={shadowPath(DEFAULT_SHADOW)}
                fill="none"
                stroke="#fff"
                stroke-width={LETTER_W}
                stroke-linecap="round"
                stroke-linejoin="round"
                data-mw-shadow
              />
            </mask>
          </defs>
          <rect
            class="mw-hatch"
            data-mw-hatch
            x="-500"
            y={GROUND - 40}
            width="1500"
            height="200"
            fill="url(#mw-hatch)"
            mask="url(#mw-shadow-mask)"
            opacity="0.55"
          />
          <g
            data-mw-ground-fallback
            fill="none"
            stroke-linecap="round"
          >
            <line x1={groundX0 - GROUND_EXT} y1={GROUND} x2={groundX0} y2={GROUND} stroke="#8E8E8E" stroke-width={GROUND_W * 0.75} />
            <line x1={groundX0} y1={GROUND} x2={groundX1} y2={GROUND} stroke="#151515" stroke-width={GROUND_W} />
            <line x1={groundX1} y1={GROUND} x2={groundX1 + GROUND_EXT} y2={GROUND} stroke="#8E8E8E" stroke-width={GROUND_W * 0.75} />
          </g>
          <g
            data-mw-fallback
            fill="none"
            stroke="#151515"
            stroke-width={LETTER_W}
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d={toPath(M_POINTS)} />
            <path d={toPath(W_POINTS)} />
          </g>
          <circle
            class="mw-sun"
            cx={sun.x}
            cy={sun.y}
            r={SUN_R}
            stroke-width="1.5"
            stroke-opacity="0"
            vector-effect="non-scaling-stroke"
            data-mw-sun
          />
        </>
      )
    }
    {
      !live && (
        <g class="mw-glass" fill="none" stroke-width={STROKE} stroke-linecap="round" stroke-linejoin="round">
          <path d={toPath(M_POINTS)} />
          <path d={toPath(W_POINTS)} />
        </g>
      )
    }
  </svg>
  {
    live && (
      <span
        class="mw-hint font-mono text-[11px] tracking-[0.04em] text-meta"
        style={`left: ${hintLeft}px`}
        aria-hidden="true"
        data-mw-hint
      >
        move the sun
      </span>
    )
  }
</Wrapper>

<style>
  .mw-logo {
    --mw-glass: rgb(0 0 0 / 0.5);
    --mw-sun: #111;
    overflow: visible;
  }
  /* The small nav mark sits over the leaf shadows, so it needs a bit more ink. */
  .mw-logo[data-variant='mark'][data-theme='light'] {
    --mw-glass: rgb(0 0 0 / 0.65);
  }
  .mw-logo[data-theme='dark'] {
    --mw-glass: rgb(255 255 255 / 0.55);
    --mw-sun: #fff;
  }
  .mw-glass {
    stroke: var(--mw-glass);
  }
  .mw-sun {
    fill: var(--mw-sun);
    stroke: var(--mw-sun);
  }

  [data-mw-zone] {
    position: relative;
  }
  /* Just above the ground line; shown by the script until the sun is first moved. */
  .mw-hint {
    position: absolute;
    bottom: 4px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms ease;
  }
  .mw-hint[data-show] {
    opacity: 1;
  }
</style>

<script>
  import {
    DEFAULT_SHADOW,
    GROUND,
    GROUND_LINE,
    MARK_VIEWBOX,
    M_POINTS,
    STROKE,
    W_POINTS,
    maxShadowK,
    shadowFromPoint,
    shadowFromSun,
    shadowPath,
    sunSpot,
    toPath,
  } from '@/lib/monogram';
  import { seattleSun } from '@/lib/seattle';
  import { rng, el, createPen, NEAR, FAR } from '@/components/hero/handDrawn.js';

  const UPDATE_EVERY = 60_000;
  /** Share of the gap to the pointer closed per 60fps frame. */
  const FOLLOW_LERP = 0.35;
  /** Back to the real sun after leaving, along an arc lifted by ARC_LIFT × the distance. */
  const RETURN_MS = 900;
  const ARC_LIFT = 0.25;
  /** Sunset / sunrise as the pointer crosses the ground line. */
  const SET_MS = 300;
  /** How far the zone reaches past the letters, in screen px. */
  const ZONE = { side: 240, above: 180, below: 40 };
  /** Clearance between the shadow's tip and the container edge, in drawing units (stroke + blur). */
  const SHADOW_MARGIN = STROKE * 1.5;
  /** Links and controls inside the zone keep their own cursor. */
  const CONTROLS = 'a[href], button, [role="button"], input, select, textarea, label, [contenteditable]';
  const HINT_KEY = 'mw-sun-moved';
  const [MARK_X, MARK_Y, MARK_W] = MARK_VIEWBOX.split(' ').map(Number);

  type State = { x: number; y: number; dir: number; k: number; night: number };
  const KEYS = ['x', 'y', 'dir', 'k', 'night'] as const;

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const easeInOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
  const mix = (a: State, b: State, t: number) =>
    Object.fromEntries(KEYS.map((key) => [key, a[key] + (b[key] - a[key]) * t])) as State;
  const approach = (value: number, to: number, step: number) =>
    value < to ? Math.min(to, value + step) : Math.max(to, value - step);

  function realState(): State {
    const { dir, k, night } = shadowFromSun(seattleSun(Date.now()));
    return { ...sunSpot(dir), dir, k, night: night ? 1 : 0 };
  }

  function hintSeen() {
    try {
      return sessionStorage.getItem(HINT_KEY) === '1';
    } catch {
      return true;
    }
  }

  document.querySelectorAll<HTMLElement>('[data-mw-zone]').forEach((zone) => {
    const svg = zone.querySelector<SVGSVGElement>('svg')!;
    const shadow = zone.querySelector<SVGPathElement>('[data-mw-shadow]')!;
    const hatch = zone.querySelector<SVGElement>('[data-mw-hatch]')!;
    const sun = zone.querySelector<SVGCircleElement>('[data-mw-sun]')!;
    const hint = zone.querySelector<HTMLElement>('[data-mw-hint]');
    const container = zone.parentElement!;

    // Pencil letters and the horizon. The plain paths stay for no-JS, then hide.
    const pen = createPen(svg, 'mw');
    pen.defs();
    const seen = new Set<string>();
    svg.querySelectorAll<SVGElement>('[id]').forEach((node) => {
      if (seen.has(node.id)) node.remove();
      else seen.add(node.id);
    });
    const letterW = Number(svg.dataset.mwLetterW);
    const groundW = Number(svg.dataset.mwGroundW);
    const x0 = Number(svg.dataset.mwGroundX0);
    const x1 = Number(svg.dataset.mwGroundX1);
    const ext = Number(svg.dataset.mwGroundExt);
    const ink = el('g', { 'data-mw-ink': '' });
    const fallback = svg.querySelector('[data-mw-fallback]')!;
    fallback.after(ink);
    const strokes = rng(7);
    pen.pencil(ink, toPath(M_POINTS), NEAR, letterW, strokes);
    pen.pencil(ink, toPath(W_POINTS), NEAR, letterW, strokes);
    fallback.setAttribute('visibility', 'hidden');
    const ground = el('g', { 'data-mw-ground': '' });
    fallback.before(ground);
    pen.pencil(ground, `M${x0} ${GROUND} L${x1} ${GROUND}`, NEAR, groundW, rng(19));
    pen.pencil(ground, `M${x0 - ext} ${GROUND} L${x0} ${GROUND}`, FAR, groundW * 0.75, rng(23));
    pen.pencil(ground, `M${x1} ${GROUND} L${x1 + ext} ${GROUND}`, FAR, groundW * 0.75, rng(29));
    svg.querySelector('[data-mw-ground-fallback]')?.setAttribute('visibility', 'hidden');

    // `night` runs 0 → 1 so the sun can fade into the moon's ring instead of snapping.
    let cur: State = { ...sunSpot(DEFAULT_SHADOW.dir), ...DEFAULT_SHADOW, night: 0 };
    let from = cur;
    // Where the pointer puts the sun. While it's set, dir and k keep the last daylight shadow.
    let target = cur;
    let mode: 'rest' | 'follow' | 'return' = 'rest';
    let startedAt = 0;
    let last = 0;
    let frame = 0;
    let mouse: { x: number; y: number } | null = null;
    let touching = false;

    if (hint && !hintSeen()) hint.setAttribute('data-show', '');

    function draw() {
      shadow.setAttribute('d', shadowPath(cur));
      const ink = zone.hasAttribute('data-mw-active') ? 0.75 : 0.55;
      hatch.style.opacity = String(ink * (1 - cur.night));
      sun.setAttribute('cx', cur.x.toFixed(1));
      sun.setAttribute('cy', cur.y.toFixed(1));
      sun.setAttribute('fill-opacity', String(1 - cur.night));
      sun.setAttribute('stroke-opacity', String(cur.night));
    }

    function tick(now: number) {
      const reduced = reduceMotion.matches;
      const elapsed = last ? now - last : 1000 / 60;
      let moving = true;
      if (mode === 'follow') {
        const night = reduced ? target.night : approach(cur.night, target.night, elapsed / SET_MS);
        cur = { ...mix(cur, target, reduced ? 1 : 1 - (1 - FOLLOW_LERP) ** (elapsed / (1000 / 60))), night };
        moving = KEYS.some((key) => Math.abs(target[key] - cur[key]) > 0.01);
      } else if (mode === 'return') {
        const t = easeInOut(Math.min(1, (now - startedAt) / RETURN_MS));
        const to = realState();
        cur = mix(from, to, t);
        cur.y -= Math.hypot(to.x - from.x, to.y - from.y) * ARC_LIFT * Math.sin(Math.PI * t);
        if (t === 1) mode = 'rest';
      }
      draw();
      moving &&= mode !== 'rest';
      last = moving ? now : 0;
      frame = moving ? requestAnimationFrame(tick) : 0;
    }

    const start = () => {
      if (!frame) frame = requestAnimationFrame(tick);
    };

    /** Ease (back) to the real sun right now. */
    function settle() {
      if (reduceMotion.matches) {
        mode = 'rest';
        cur = realState();
        draw();
        return;
      }
      mode = 'return';
      from = { ...cur };
      startedAt = performance.now();
      start();
    }

    /** Around the letters, in screen px; null while the logo isn't laid out. */
    function inZone(x: number, y: number) {
      const m = svg.getScreenCTM();
      if (!m || !m.a) return false;
      const left = m.a * MARK_X + m.e - ZONE.side;
      const right = m.a * (MARK_X + MARK_W) + m.e + ZONE.side;
      const top = m.d * MARK_Y + m.f - ZONE.above;
      const bottom = m.d * GROUND_LINE + m.f + ZONE.below;
      return x >= left && x <= right && y >= top && y <= bottom;
    }

    /** Puts the sun at a screen point. */
    function follow(x: number, y: number) {
      const m = svg.getScreenCTM();
      if (!m || !m.a) return;
      const sx = (x - m.e) / m.a;
      const sy = (y - m.f) / m.d;
      const set = sy > GROUND_LINE;
      let { dir, k } = target;
      if (!set) {
        ({ dir, k } = shadowFromPoint(sx, sy));
        const box = container.getBoundingClientRect();
        const style = getComputedStyle(container);
        const minX = (box.left + parseFloat(style.paddingLeft) - m.e) / m.a + SHADOW_MARGIN;
        const maxX = (box.right - parseFloat(style.paddingRight) - m.e) / m.a - SHADOW_MARGIN;
        k = Math.min(k, maxShadowK(dir, minX, maxX));
      }
      target = { x: sx, y: sy, dir, k, night: set ? 1 : 0 };
      if (mode !== 'follow') {
        mode = 'follow';
        zone.setAttribute('data-mw-active', '');
        if (hint?.hasAttribute('data-show')) {
          hint.removeAttribute('data-show');
          try {
            sessionStorage.setItem(HINT_KEY, '1');
          } catch {
            /* private mode: the hint just comes back next visit */
          }
        }
      }
      start();
    }

    function leave() {
      document.documentElement.removeAttribute('data-cursor-hidden');
      if (mode !== 'follow') return;
      zone.removeAttribute('data-mw-active');
      target = cur;
      settle();
    }

    // The sun stands in for the custom cursor inside the zone; links there keep the cursor.
    function pointAt(x: number, y: number, el: Element | null) {
      mouse = { x, y };
      if (inZone(x, y) && !el?.closest(CONTROLS)) {
        document.documentElement.setAttribute('data-cursor-hidden', '');
        follow(x, y);
      } else {
        leave();
      }
    }

    // Capture on window runs before the custom cursor's document listener, so it sees the flag.
    window.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'touch') pointAt(e.clientX, e.clientY, e.target instanceof Element ? e.target : null);
      },
      { capture: true, passive: true },
    );
    // The zone moves under a still mouse while scrolling.
    window.addEventListener(
      'scroll',
      () => {
        if (mouse && !touching) pointAt(mouse.x, mouse.y, document.elementFromPoint(mouse.x, mouse.y));
      },
      { passive: true },
    );
    const lost = () => {
      mouse = null;
      leave();
    };
    document.addEventListener('mouseout', (e) => {
      if (!e.relatedTarget) lost();
    });
    window.addEventListener('blur', lost);

    // Touch: a drag that starts in the zone moves the sun (and doesn't scroll) until the finger lifts.
    document.addEventListener(
      'touchstart',
      (e) => {
        const t = e.touches[0];
        const el = e.target instanceof Element ? e.target : null;
        if (e.touches.length !== 1 || !inZone(t.clientX, t.clientY) || el?.closest(CONTROLS)) return;
        touching = true;
        follow(t.clientX, t.clientY);
      },
      { passive: true },
    );
    document.addEventListener(
      'touchmove',
      (e) => {
        if (!touching) return;
        e.preventDefault();
        follow(e.touches[0].clientX, e.touches[0].clientY);
      },
      { passive: false },
    );
    const endTouch = () => {
      if (!touching) return;
      touching = false;
      leave();
    };
    document.addEventListener('touchend', endTouch);
    document.addEventListener('touchcancel', endTouch);

    settle();
    setInterval(() => {
      if (mode === 'rest') settle();
    }, UPDATE_EVERY);
  });
</script>
