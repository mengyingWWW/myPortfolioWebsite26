---
/**
 * The MW monogram as two semi-transparent "glass" strokes: where they share the vertical
 * line they overlap and read denser. The live variant adds a cast shadow and a sun that
 * follow Seattle's real sun (a hollow moon at night). Hovering around it reveals a sun-path
 * semicircle and the sun follows the pointer along it, the shadow swinging opposite.
 */
import {
  DEFAULT_SHADOW,
  GROUND,
  LIVE_VIEWBOX,
  MARK_VIEWBOX,
  M_POINTS,
  STROKE,
  SUN_PATH_D,
  SUN_R,
  W_POINTS,
  shadowPath,
  sunSpot,
  toPath,
} from '@/lib/monogram';

interface Props {
  variant?: 'mark' | 'live';
  theme?: 'light' | 'dark';
  /** Accessible name; without one the logo is decorative. */
  label?: string;
  class?: string;
}

const { variant = 'mark', theme = 'light', label, class: className } = Astro.props;
const live = variant === 'live';
const sun = sunSpot(DEFAULT_SHADOW.dir);
const blurId = `mw-blur-${Math.random().toString(36).slice(2, 8)}`;

const LIVE_WIDTH = 262;
/** SVG units per screen pixel in the live variant, for the sun path's hairline and dashes. */
const px = Number(LIVE_VIEWBOX.split(' ')[2]) / LIVE_WIDTH;

const Wrapper = live ? 'div' : Fragment;
const wrapperProps = live ? { class: className, 'data-mw-zone': '' } : {};
---

<Wrapper {...wrapperProps}>
  <svg
    class:list={['mw-logo block', live ? 'h-auto' : ['h-[22px] w-auto', className]]}
    style={live ? `width: ${LIVE_WIDTH}px` : undefined}
    data-theme={theme}
    data-variant={variant}
    viewBox={live ? LIVE_VIEWBOX : MARK_VIEWBOX}
    xmlns="http://www.w3.org/2000/svg"
    role={label ? 'img' : undefined}
    aria-label={label}
    aria-hidden={label ? undefined : 'true'}
  >
    {
      live && (
        <>
          <path
            class="mw-path"
            d={SUN_PATH_D}
            fill="none"
            stroke-width={px}
            stroke-dasharray={`${2 * px} ${4 * px}`}
            data-mw-path
          />
          <filter id={blurId} filterUnits="userSpaceOnUse" x="-500" y={GROUND - 120} width="1500" height="260">
            <feGaussianBlur stdDeviation="3" />
          </filter>
          <path
            class="mw-shadow"
            d={shadowPath(DEFAULT_SHADOW)}
            filter={`url(#${blurId})`}
            fill="none"
            stroke-width="20"
            stroke-linecap="round"
            stroke-linejoin="round"
            data-mw-shadow
          />
          <circle
            class="mw-sun"
            cx={sun.x}
            cy={sun.y}
            r={SUN_R}
            stroke-width="1.5"
            stroke-opacity="0"
            vector-effect="non-scaling-stroke"
            data-mw-sun
          />
        </>
      )
    }
    <g class="mw-glass" fill="none" stroke-width={STROKE} stroke-linecap="round" stroke-linejoin="round">
      <path d={toPath(M_POINTS)} />
      <path d={toPath(W_POINTS)} />
    </g>
  </svg>
</Wrapper>

<style>
  .mw-logo {
    --mw-glass: rgb(0 0 0 / 0.5);
    --mw-sun: #111;
    --mw-shadow: rgb(0 0 0 / 0.12);
    --mw-path: #d0d0d0;
    overflow: visible;
  }
  /* The small nav mark sits over the leaf shadows, so it needs a bit more ink. */
  .mw-logo[data-variant='mark'][data-theme='light'] {
    --mw-glass: rgb(0 0 0 / 0.65);
  }
  .mw-logo[data-theme='dark'] {
    --mw-glass: rgb(255 255 255 / 0.55);
    --mw-sun: #fff;
    --mw-shadow: rgb(255 255 255 / 0.1);
    --mw-path: #444;
  }
  .mw-glass {
    stroke: var(--mw-glass);
  }
  .mw-sun {
    fill: var(--mw-sun);
    stroke: var(--mw-sun);
  }
  .mw-shadow {
    stroke: var(--mw-shadow);
  }

  /* Hover zone: ~60px around the logo (only 12px below, so it stays off whatever follows the
     ground line). The negative margins keep it out of the layout. */
  [data-mw-zone] {
    padding: 60px 60px 12px;
    margin: -60px -60px -12px;
  }
  .mw-path {
    stroke: var(--mw-path);
    opacity: 0;
    transition: opacity 300ms ease;
  }
  [data-mw-zone][data-scrubbing] .mw-path {
    opacity: 1;
  }
</style>

<script>
  import { DEFAULT_SHADOW, shadowFromAngle, shadowFromSun, shadowPath, sunOnPath, sunSpot } from '@/lib/monogram';
  import { seattleSun } from '@/lib/seattle';

  const UPDATE_EVERY = 60_000;
  /** Share of the gap to the pointer's sun position closed per 60fps frame. */
  const SCRUB_LERP = 0.2;
  /** Easing back to the real sun, after hovering or on a minute tick. */
  const RETURN_MS = 800;

  type State = { x: number; y: number; dir: number; k: number; night: number };
  const KEYS = ['x', 'y', 'dir', 'k', 'night'] as const;

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const easeInOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
  const mix = (a: State, b: State, t: number) =>
    Object.fromEntries(KEYS.map((key) => [key, a[key] + (b[key] - a[key]) * t])) as State;

  function realState(): State {
    const { dir, k, night } = shadowFromSun(seattleSun(Date.now()));
    return { ...sunSpot(dir), dir, k, night: night ? 1 : 0 };
  }

  const scrubState = (theta: number): State => ({ ...sunOnPath(theta), ...shadowFromAngle(theta), night: 0 });

  document.querySelectorAll<HTMLElement>('[data-mw-zone]').forEach((zone) => {
    const shadow = zone.querySelector<SVGPathElement>('[data-mw-shadow]')!;
    const sun = zone.querySelector<SVGCircleElement>('[data-mw-sun]')!;

    // `night` runs 0 → 1 so the sun can fade into the moon's ring instead of snapping.
    let cur: State = { ...sunSpot(DEFAULT_SHADOW.dir), ...DEFAULT_SHADOW, night: 0 };
    let from = cur;
    let target = cur;
    let mode: 'rest' | 'scrub' | 'return' = 'rest';
    let startedAt = 0;
    let last = 0;
    let frame = 0;

    function draw() {
      shadow.setAttribute('d', shadowPath(cur));
      shadow.style.opacity = String(1 - cur.night);
      sun.setAttribute('cx', cur.x.toFixed(1));
      sun.setAttribute('cy', cur.y.toFixed(1));
      sun.setAttribute('fill-opacity', String(1 - cur.night));
      sun.setAttribute('stroke-opacity', String(cur.night));
    }

    function tick(now: number) {
      let moving = true;
      if (mode === 'scrub') {
        const frames = last ? (now - last) / (1000 / 60) : 1;
        cur = mix(cur, target, 1 - (1 - SCRUB_LERP) ** frames);
        moving = KEYS.some((key) => Math.abs(target[key] - cur[key]) > 0.01);
      } else if (mode === 'return') {
        const t = easeInOut(Math.min(1, (now - startedAt) / RETURN_MS));
        cur = mix(from, realState(), t);
        if (t === 1) mode = 'rest';
      }
      draw();
      moving &&= mode !== 'rest';
      last = moving ? now : 0;
      frame = moving ? requestAnimationFrame(tick) : 0;
    }

    const start = () => {
      if (!frame) frame = requestAnimationFrame(tick);
    };

    /** Ease (back) to the real sun right now. */
    function settle() {
      if (reduceMotion) {
        cur = realState();
        draw();
        return;
      }
      mode = 'return';
      from = { ...cur };
      startedAt = performance.now();
      start();
    }

    if (!reduceMotion) {
      // The sun stands in for the cursor while it follows the pointer.
      zone.dataset.cursor = 'hide';
      zone.addEventListener('pointermove', (e) => {
        const r = zone.getBoundingClientRect();
        const t = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
        target = scrubState(t * Math.PI);
        mode = 'scrub';
        zone.setAttribute('data-scrubbing', '');
        start();
      });
      zone.addEventListener('pointerleave', () => {
        zone.removeAttribute('data-scrubbing');
        if (mode === 'scrub') settle();
      });
    }

    settle();
    setInterval(() => {
      if (mode === 'rest') settle();
    }, UPDATE_EVERY);
  });
</script>
