---
/**
 * D2 comparison for idea-mapping: the four ways considered for showing many pins in one place.
 * Controlled comparison: the same map and the same pins in every frame; only the display changes.
 * All four were really considered; D was chosen. Wireframes are decorative; the text carries the meaning.
 */
const options = [
  { key: 'A', name: 'List', how: 'Every pin as a row.', cost: 'Loses where things are.', variant: 'list' },
  { key: 'B', name: 'Top N only', how: 'Show the nearest few pins.', cost: 'Hides things people need.', variant: 'top' },
  { key: 'C', name: 'Heatmap', how: 'Colour the map by density.', cost: 'Shows how many, not what.', variant: 'heat' },
  { key: 'D', name: 'Clusters', how: 'One marker per type with a count. Splits as you zoom in.', cost: 'One more tap when zoomed out.', variant: 'cluster', chosen: true },
];
// The same pins in every frame: [x, y, colour]
const P = '#7C5CFC', A = '#2B9A66', W = '#E8590C', L = '#4B5563';
const pins: [number, number, string][] = [
  [40, 58, P], [46, 64, P], [52, 56, P], [44, 70, P], [58, 66, P],
  [92, 92, A], [98, 98, A], [104, 90, A], [96, 104, A], [108, 100, A], [90, 110, A],
  [60, 128, W], [68, 134, W], [118, 52, L], [124, 60, L],
];
const top = pins.slice(0, 4).concat(pins.slice(6, 8));
const clusters: [number, number, string, string][] = [[48, 63, P, '5'], [98, 99, A, '6'], [64, 131, W, '2'], [121, 56, L, '2']];
---

<figure class="co">
  <ol class="co-grid">
    {options.map((o) => (
      <li class:list={['co-card', { 'is-chosen': o.chosen }]}>
        <svg class="co-art" viewBox="0 0 150 170" aria-hidden="true">
          <rect x="1" y="1" width="148" height="168" rx="14" fill="#F5F6F7" stroke="#E5E7EB" />
          <g stroke="#FFFFFF" stroke-width="7" fill="none">
            <path d="M-5 40 L160 95" /><path d="M20 175 L120 -5" /><path d="M-5 140 L160 120" />
          </g>
          <g fill="#EAECEF">
            <rect x="12" y="12" width="26" height="18" rx="2" /><rect x="110" y="128" width="28" height="22" rx="2" /><rect x="70" y="20" width="22" height="16" rx="2" />
          </g>
          {o.variant === 'list' && (
            <g>
              <rect x="10" y="44" width="130" height="118" rx="10" fill="#FFFFFF" stroke="#E5E7EB" />
              {[0, 1, 2, 3, 4, 5].map((i) => (
                <g>
                  <circle cx="24" cy={60 + i * 17} r="5" fill={[P, P, A, A, W, L][i]} />
                  <rect x="34" y={57 + i * 17} width={[70, 54, 64, 48, 60, 44][i]} height="6" rx="3" fill="#D1D5DB" />
                </g>
              ))}
            </g>
          )}
          {o.variant === 'top' && top.map(([x, y, c]) => <circle cx={x} cy={y} r="5.5" fill={c} stroke="#FFFFFF" stroke-width="1.5" />)}
          {o.variant === 'top' && <text x="75" y="160" text-anchor="middle" font-size="8" fill="#9CA3AF">+9 hidden</text>}
          {o.variant === 'heat' && (
            <g>
              <defs>
                <radialGradient id="co-h"><stop offset="0" stop-color="#DC3E42" stop-opacity=".55" /><stop offset="1" stop-color="#E8590C" stop-opacity="0" /></radialGradient>
              </defs>
              <circle cx="98" cy="99" r="30" fill="url(#co-h)" /><circle cx="48" cy="63" r="24" fill="url(#co-h)" /><circle cx="64" cy="131" r="16" fill="url(#co-h)" /><circle cx="121" cy="56" r="14" fill="url(#co-h)" />
            </g>
          )}
          {o.variant === 'cluster' && clusters.map(([x, y, c, n]) => (
            <g>
              <rect x={x - 15} y={y - 9} width="30" height="18" rx="9" fill="#FFFFFF" stroke="#E5E7EB" />
              <circle cx={x - 6} cy={y} r="5" fill={c} />
              <text x={x + 5} y={y + 3.5} text-anchor="middle" font-size="10" font-weight="700" fill="#111827">{n}</text>
            </g>
          ))}
        </svg>
        <p class="co-key">{o.key}{o.chosen && <span class="co-chosen">Chosen</span>}</p>
        <h4 class="co-name">{o.name}</h4>
        <p class="co-how">{o.how}</p>
        <p class="co-cost"><span>Trade-off</span>{o.cost}</p>
      </li>
    ))}
  </ol>
</figure>

<style>
  .co { margin: 0; }
  .co-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .co-card { display: grid; align-content: start; gap: 6px; padding: 12px; border-radius: 16px; border: 1px solid #E6E6E4; background: #FFFFFF; }
  .co-card.is-chosen { border-color: var(--cs-accent); background: var(--cs-accent-tint, #F0FDFA); }
  .co-art { display: block; width: 100%; height: auto; margin-bottom: 6px; }
  .co-key { margin: 0; display: flex; align-items: center; gap: 8px; font: 500 12px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; color: #8A8A8A; }
  .co-chosen { padding: 1px 8px; border-radius: 999px; background: var(--cs-accent); color: #FFFFFF; font: 600 11px/1.6 Inter, system-ui, sans-serif; }
  .co-name { margin: 0; font-size: 16px; font-weight: 600; line-height: 1.3; color: #111111; }
  .co-how { margin: 0; font-size: 14px; line-height: 1.45; color: #3A3A3A; }
  .co-cost { margin: 4px 0 0; padding-top: 8px; border-top: 1px solid #EFEFED; font-size: 13px; line-height: 1.45; color: #6E6E6E; }
  .co-cost span { display: block; font: 500 11px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: 0.06em; text-transform: uppercase; color: #8A8A8A; }
  @media (max-width: 900px) { .co-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
