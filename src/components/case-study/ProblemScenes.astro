---
// Four-panel comic strip for idea-ai-wiki "01 Problem".
// Minimal hand-drawn line art: black strokes, one orange accent, slight wobble, no faces, no text in the art.
// Each panel has a sketched comic frame and 1–4 dots in its bottom-right corner.
// Illustrations are decorative (aria-hidden); the captions carry the meaning.
// To swap in your own sketches later, replace each <svg> with an <img> of the same aspect ratio (4:3).
// Comic-style panel markers: 1 = ·, 2 = ··, 3 = one over two, 4 = two over two.
const DOTS: Record<number, [number, number][]> = {
  1: [[172, 124]],
  2: [[163, 124], [172, 124]],
  3: [[167.5, 115.5], [163, 124], [172, 124]],
  4: [[163, 115.5], [172, 115.5], [163, 124], [172, 124]],
};
const dots = (n: number) => DOTS[n];
---
<figure class="ps">
  <svg width="0" height="0" class="ps-defs" aria-hidden="true" focusable="false">
    <defs>
      <filter id="ps-wobble" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" />
        <feDisplacementMap in="SourceGraphic" scale="2.2" />
      </filter>
    </defs>
  </svg>
  <ol class="ps-grid">
    <li class="ps-card">
      <svg class="ps-art" viewBox="0 0 184 138" aria-hidden="true">
        <g filter="url(#ps-wobble)" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 5 L180 4 L179 133 L5 132 Z" />
          <path d="M14 20 L170 19" />
          <path d="M66 20 Q68 40 92 41 Q116 40 118 20" fill="#FFFFFF" />
          <path d="M78 30 L106 30" stroke-width="1.5" />
          <path d="M50 70 L134 68 L136 120 L52 122 Z" fill="#FFFFFF" />
          <path d="M62 84 L92 83" />
          <path d="M62 98 L122 97 M62 109 L112 108" stroke-width="1.5" />
        </g>
        <g filter="url(#ps-wobble)" fill="none" stroke="#C2410C" stroke-width="2.2" stroke-linecap="round">
          <path d="M126 26 Q133 33 126 40" />
          <path d="M135 20 Q147 33 135 46" />
          <path d="M58 26 Q51 33 58 40" />
          <path d="M49 20 Q37 33 49 46" />
        </g>
        <g filter="url(#ps-wobble)">
          <circle cx="92" cy="35" r="2.4" fill="#C2410C" />
          <circle cx="120" cy="84" r="8" fill="#C2410C" />
          <path d="M120 79.5 L120 85 M120 88.5 L120 89" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" />
        </g>
        {dots(1).map(([x, y]) => <circle cx={x} cy={y} r="2.8" fill="#111111" />)}
      </svg>
      <h3 class="ps-title">A request comes in</h3>
      <p class="ps-text">A smoke detector on the second floor keeps chirping.</p>
    </li>

    <li class="ps-card">
      <svg class="ps-art" viewBox="0 0 184 138" aria-hidden="true">
        <g filter="url(#ps-wobble)" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 5 L180 4 L179 133 L5 132 Z" />
          <circle cx="44" cy="62" r="14" fill="#FFFFFF" />
          <path d="M20 122 Q22 92 44 90 Q66 92 68 122" fill="#FFFFFF" />
          <path d="M86 40 L160 39 L161 96 L87 97 Z" fill="#FFFFFF" />
          <path d="M78 104 L168 103 L164 110 L82 111 Z" fill="#FFFFFF" />
          <path d="M96 50 L150 49 L150 60 L96 61 Z" stroke-width="1.6" />
          <circle cx="142" cy="54.5" r="3" stroke-width="1.4" />
          <path d="M144.5 57 L147 59.5" stroke-width="1.4" />
          <path d="M98 72 L148 71 M98 84 L130 83" stroke-width="1.4" stroke-dasharray="3 4" />
        </g>
        <g filter="url(#ps-wobble)">
          <path d="M101 52 L101 58" stroke="#C2410C" stroke-width="2" stroke-linecap="round" />
        </g>
        {dots(2).map(([x, y]) => <circle cx={x} cy={y} r="2.8" fill="#111111" />)}
      </svg>
      <h3 class="ps-title">The tech on shift is stuck</h3>
      <p class="ps-text">They haven't fixed one before, and nothing written down helps.</p>
    </li>

    <li class="ps-card">
      <svg class="ps-art" viewBox="0 0 184 138" aria-hidden="true">
        <g filter="url(#ps-wobble)" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 5 L180 4 L179 133 L5 132 Z" />
          <circle cx="42" cy="76" r="13" fill="#FFFFFF" />
          <path d="M28 70 Q29 54 42 54 Q55 54 56 70" fill="#FFFFFF" />
          <path d="M24 70 L60 70" />
          <path d="M20 124 Q22 96 42 94 Q62 96 64 124" fill="#FFFFFF" />
          <circle cx="64" cy="52" r="2.5" />
          <circle cx="71" cy="42" r="3.8" />
          <path d="M78 32 Q75 16 90 16 Q97 7 110 13 Q124 8 127 21 Q140 24 135 35 Q137 46 123 46 L90 46 Q76 45 78 32 Z" fill="#FFFFFF" />
          <path d="M97 38 L112 25" stroke-width="2.2" />
          <path d="M110 21 Q117 18 118 25 L114 26 L113 30 Q106 31 110 21 Z" />
          <circle cx="96" cy="39" r="3" />
          <g transform="translate(-6 -16)">
            <path d="M120 98 L132 98 L136 102 L164 102 L164 124 L120 124 Z" fill="#FFFFFF" />
            <path d="M126 92 L154 91 L155 104" stroke-width="1.6" />
            <path d="M130 86 L158 85 L159 102" stroke-width="1.6" />
          </g>
        </g>
        {dots(3).map(([x, y]) => <circle cx={x} cy={y} r="2.8" fill="#111111" />)}
      </svg>
      <h3 class="ps-title">The know-how is elsewhere</h3>
      <p class="ps-text">The fix lives in a senior tech's head, or a PDF on a shared drive.</p>
    </li>

    <li class="ps-card">
      <svg class="ps-art" viewBox="0 0 184 138" aria-hidden="true">
        <g filter="url(#ps-wobble)" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 5 L180 4 L179 133 L5 132 Z" />
          <path d="M48 40 L92 46 L86 110 L42 104 Z" fill="#FFFFFF" />
          <path d="M24 50 L70 45 L76 107 L30 112 Z" fill="#FFFFFF" />
          <path d="M37 62 L62 60 M38 74 L58 72 M40 86 L64 84 M41 97 L56 96" stroke-width="1.5" />
          <path d="M28 120 L90 121" stroke-width="1.5" />
        </g>
        <g filter="url(#ps-wobble)" stroke="#C2410C" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M136 18 Q139 38 156 41 Q139 44 136 64 Q133 44 116 41 Q133 38 136 18 Z" fill="#FFF4EE" />
          <path d="M118 78 L156 78 Q162 78 162 84 L162 98 Q162 104 156 104 L132 104 L124 112 L125 104 L118 104 Q112 104 112 98 L112 84 Q112 78 118 78 Z" fill="#FFFFFF" />
          <path d="M130 88 Q130 83 137 83 Q144 83 144 88 Q144 92 137 94 L137 96" fill="none" />
          <path d="M137 100 L137 100.5" fill="none" />
        </g>
        {dots(4).map(([x, y]) => <circle cx={x} cy={y} r="2.8" fill="#111111" />)}
      </svg>
      <h3 class="ps-title">The AI can't use it yet</h3>
      <p class="ps-text">Untagged pages give an AI agent nothing to route on.</p>
    </li>
  </ol>
</figure>

<style>
  .ps { margin: 0; }
  .ps-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .ps-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .ps-card { display: grid; grid-template-rows: auto auto 1fr; gap: 6px; }
  .ps-art { display: block; width: 100%; height: auto; margin-bottom: 10px; background: transparent; overflow: visible; }
  .ps-title { margin: 0; font-size: 16px; font-weight: 600; line-height: 1.3; color: #111111; }
  .ps-text { margin: 0; font-size: 14px; line-height: 1.5; color: #3A3A3A; }
  @media (max-width: 1000px) { .ps-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px; } }
  @media (max-width: 560px) { .ps-grid { grid-template-columns: 1fr; } .ps-art { max-width: 360px; } }
</style>
