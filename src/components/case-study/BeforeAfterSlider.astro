---
// Drag-to-compare slider. Both images must share the same size and layout.
// Accessible: native range input (arrow keys, screen readers), visible focus, works on touch.
interface Props {
  before: string; after: string;
  beforeAlt: string; afterAlt: string;
  width: number; height: number;
  status?: "Proposed" | "Shipped";
  caption?: string;
  id?: string;
}
const { before, after, beforeAlt, afterAlt, width, height, status = "Proposed", caption, id } = Astro.props;
const uid = id ?? `ba-${Math.random().toString(36).slice(2, 8)}`;
---
<figure class="ba" id={uid}>
  <div class="ba-frame" style={`--pos:50%; aspect-ratio:${width}/${height}`}>
    <img class="ba-img" src={before} alt={beforeAlt} width={width} height={height} loading="lazy" decoding="async" />
    <div class="ba-after" aria-hidden="false">
      <img class="ba-img" src={after} alt={afterAlt} width={width} height={height} loading="lazy" decoding="async" />
    </div>
    <div class="ba-handle" aria-hidden="true"><span>‹ ›</span></div>
    <span class="ba-tag ba-tag-l">Before</span>
    <span class="ba-tag ba-tag-r">After <em>· {status}</em></span>
    <input class="ba-range" type="range" min="0" max="100" value="50" step="1" data-cursor-label="DRAG"
      aria-label="Compare before and after. Move left to show more of the redesign, right to show more of the original." />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  document.querySelectorAll<HTMLElement>(".ba").forEach((fig) => {
    const frame = fig.querySelector<HTMLElement>(".ba-frame")!;
    const range = fig.querySelector<HTMLInputElement>(".ba-range")!;
    const set = (v: number) => {
      frame.style.setProperty("--pos", `${v}%`);
      range.setAttribute("aria-valuetext", `${Math.round(v)}% original, ${100 - Math.round(v)}% redesign`);
    };
    range.addEventListener("input", () => set(Number(range.value)));
    set(Number(range.value));
  });
</script>

<style>
  .ba { margin: 0; }
  .ba-frame { position: relative; width: 100%; max-width: 100%; border-radius: 10px; overflow: hidden; background: #1c1c1c; user-select: none; touch-action: pan-y; }
  .ba-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top left; display: block; }
  .ba-after { position: absolute; inset: 0; clip-path: inset(0 0 0 var(--pos)); }
  .ba-handle { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; background: #FFFFFF; transform: translateX(-1px); pointer-events: none; }
  .ba-handle span {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 44px; height: 44px; border-radius: 50%; background: #FFFFFF; color: #111111;
    display: grid; place-items: center; font: 600 14px/1 var(--font-mono, ui-monospace, monospace);
    box-shadow: 0 4px 16px rgba(0,0,0,.35);
  }
  .ba-tag {
    position: absolute; top: 14px; padding: 6px 14px; border-radius: 999px; background: #FFFFFF; color: #111111;
    font: 500 13px/1 inherit; pointer-events: none;
  }
  .ba-tag em { font-style: normal; color: #6E6E6E; }
  .ba-tag-l { left: 14px; }
  .ba-tag-r { right: 14px; }
  .ba-range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; -webkit-appearance: none; appearance: none; }
  .ba-frame:has(.ba-range:focus-visible) .ba-handle span { outline: 3px solid #C2410C; outline-offset: 2px; }
  .ba figcaption { margin-top: 10px; font-size: 14px; color: #6E6E6E; }
  @media (prefers-reduced-motion: reduce) { .ba-after, .ba-handle { transition: none; } }
</style>
