---
/** Equal-height cards, one per role: how they touch the product, their name and what they need. */
interface Props {
  roles: { name: string; tag: string; text: string; accent?: boolean }[];
}

const { roles } = Astro.props;
---

<ul class="role-cards">
  {
    roles.map(({ name, tag, text, accent }) => (
      <li class:list={['role-card', { 'is-accent': accent }]}>
        <p class="role-tag">{tag}</p>
        <h3 class="role-name">{name}</h3>
        <p class="role-text">{text}</p>
      </li>
    ))
  }
</ul>

<style>
  .role-cards {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
  }
  .role-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border: 1px solid #e6e6e4;
    padding: 20px;
  }
  .role-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-meta);
  }
  .role-name {
    font-size: 20px;
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .role-text {
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* The AI agent, matching its node in the knowledge-flow diagram. Accent text on the tint: 6.8:1 in orange, 7.2:1 in wine. */
  .is-accent {
    border-color: var(--cs-accent);
    background: var(--cs-accent-tint);
  }
  .is-accent .role-tag {
    color: var(--cs-accent-text);
  }

  @media (max-width: 1279px) {
    .role-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .role-cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
