---
/**
 * D2 floors: the constraint (real floor names) as a strip, then the final picker as a clip
 * with three numbered notes beside it.
 */
import ClipPlayer from '@/components/case-study/ClipPlayer.astro';
const floors = ['4', '3', '2', '1', 'M', 'B1', 'B2'];
const notes = [
  { t: 'Scroll the stack', d: 'Floors sit in building order, like elevator buttons. The current one is blue.' },
  { t: 'Search by name', d: 'The search button at the end jumps straight to a floor like B1.' },
  { t: 'Shrink to a pill', d: 'With a sheet open, only the current floor stays on screen.' },
];
---
<div class="fs">
  <figure class="fs-strip">
    <div class="fs-floors">{floors.map((f) => <span class:list={{ odd: /[A-Z]/.test(f) }}>{f}</span>)}</div>
    <figcaption>Main Building, top to bottom. Letters mark a mezzanine and two basements.</figcaption>
  </figure>
  <div class="fs-final">
    <div class="fs-phone"><ClipPlayer src="/work/idea-mapping/clips/clip-d3-floors" label="Floor picker: scroll, search, and the pill while a sheet is open" width={780} height={1688} /></div>
    <ol class="fs-notes">
      {notes.map((n, i) => <li><span>{i + 1}</span><b>{n.t}</b>{n.d}</li>)}
    </ol>
  </div>
</div>
<style>
  .fs { margin-top: 32px; display: grid; gap: 36px; }
  .fs-strip { margin: 0; }
  .fs-floors { display: flex; gap: 8px; flex-wrap: wrap; }
  .fs-floors span { width: 56px; height: 56px; border-radius: 14px; background: #F3F3F2; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 600; color: #8A8A8A; }
  .fs-floors span.odd { background: var(--cs-accent-tint, #F0FDFA); color: var(--cs-accent-text, #115E59); box-shadow: inset 0 0 0 1px var(--cs-accent-border, #99F6E4); }
  .fs-strip figcaption { margin-top: 10px; font-size: 14px; color: #6E6E6E; }
  .fs-final { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 40px; align-items: center; }
  .fs-phone { aspect-ratio: 780 / 1688; border-radius: 28px; overflow: hidden; border: 1px solid #E6E6E4; box-shadow: 0 10px 28px rgba(17,24,39,.08); }
  .fs-phone :global(.clip) { height: 100%; }
  .fs-phone :global(video) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fs-notes { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; max-width: 420px; }
  .fs-notes li { position: relative; padding-left: 40px; font-size: 15px; line-height: 1.55; color: #555; }
  .fs-notes span { position: absolute; left: 0; top: 0; width: 26px; height: 26px; border-radius: 999px; background: var(--cs-accent, #0F766E); color: #fff; font-size: 13px; font-weight: 600; display: flex; align-items: center; justify-content: center; }
  .fs-notes b { display: block; font-size: 16px; color: #111; margin-bottom: 2px; }
  @media (max-width: 760px) { .fs-final { grid-template-columns: 1fr; justify-items: center; } .fs-phone { width: min(260px, 75vw); } .fs-floors span { width: 44px; height: 44px; font-size: 17px; } }
</style>
