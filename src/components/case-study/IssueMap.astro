---
// Issue map for colleague-ai "03 Findings".
// Three task flows (8 study steps each = 24, plus a dashed entry and exit step outside the original map).
// Each of the 14 usability issues hangs under the step where teachers hit it, coloured by severity.
// Every issue card links to its row in the findings tabs (#issue-A1 …); TabGroup reveals the right panel.
import data from '@/data/colleague-ai/issues.json';

interface Props { caption?: string }
const {
  caption = 'All 6 blocking issues sit at the first or last steps of a task. Dashed steps sit outside the original 24-step map. Select an issue to see its details.',
} = Astro.props;

type Sev = 'high' | 'medium' | 'low';
const sevLabel: Record<Sev, string> = { high: 'High', medium: 'Medium', low: 'Low' };
const sevShort: Record<Sev, string> = { high: 'High', medium: 'Med', low: 'Low' };
const total = data.issues.length;
const count = (sev: Sev, wf?: string) =>
  data.issues.filter((i) => i.severity === sev && (!wf || i.workflow === wf)).length;
const lastStep = 9;
---

<figure class="im">
  <div class="im-legend" aria-hidden="true">
    <span>{total} issues · 24 steps · 3 tasks · 3/5 = 3 of 5 teachers</span>
    <span><i class="sw sev-high"></i>High · blocked the task ({count('high')})</span>
    <span><i class="sw sev-medium"></i>Medium ({count('medium')})</span>
    <span><i class="sw sev-low"></i>Low ({count('low')})</span>
  </div>

  <div class="im-scroll">
    <div class="im-grid">
      {data.workflows.map((wf) => {
        const issues = data.issues.filter((i) => i.workflow === wf.key);
        return (
          <section class="im-row" aria-labelledby={`im-${wf.key}`}>
            <header class="im-head">
              <span class="im-task">{wf.task}</span>
              <h4 id={`im-${wf.key}`}>{wf.label}</h4>
              <span class="im-tally">
                <span>{issues.length} issues</span>
                <span class="t-high">{count('high', wf.key)} high</span>
                <span class="t-medium">{count('medium', wf.key)} med</span>
                <span class="t-low">{count('low', wf.key)} low</span>
              </span>
            </header>
            <ol class="im-steps">
              {wf.steps.map((step, s) => {
                const here = issues.filter((i) => i.step === s);
                const outside = s === 0 || s === lastStep;
                return (
                  <li class:list={['im-step', { 'is-outside': outside, 'is-hit': here.length > 0 }]}>
                    <span class="im-node" aria-hidden="true"></span>
                    <span class="im-label">
                      {step}
                      {outside && <span class="sr-only"> (outside the 24-step map)</span>}
                    </span>
                    {here.length > 0 && (
                      <ul class="im-issues">
                        {here.map((i) => (
                          <li>
                            <a
                              class={`im-card sev-${i.severity}`}
                              href={`#issue-${i.id}`}
                              data-cursor-label="VIEW"
                              aria-label={`${i.id}, ${sevLabel[i.severity as Sev]} severity: ${i.short}. ${i.freq} of 5 teachers.`}
                            >
                              <span class="im-id">{i.id} · {sevShort[i.severity as Sev]}</span>
                              <span class="im-text">{i.short}</span>
                              <span class="im-freq">{i.freq}/5</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                );
              })}
            </ol>
          </section>
        );
      })}
    </div>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .im { margin: 0; --sev-high: #D92D20; --sev-medium: #B54708; --sev-low: #8A8A86; }
  .sev-high { --sev: var(--sev-high); }
  .sev-medium { --sev: var(--sev-medium); }
  .sev-low { --sev: var(--sev-low); }

  .im-legend {
    display: flex; flex-wrap: wrap; gap: 8px 20px; margin-bottom: 24px;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase; color: #6E6E6E;
  }
  .im-legend span { display: inline-flex; align-items: center; gap: 6px; }
  .sw { display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: var(--sev); }

  /* Positioned, so absolutely placed sr-only text is clipped here instead of widening the page. */
  .im-scroll { position: relative; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .im-grid { min-width: 1000px; }

  .im-row {
    display: grid; grid-template-columns: 150px 1fr; gap: 16px;
    padding: 22px 0; border-top: 1px solid #111111;
  }
  .im-task, .im-tally, .im-id, .im-freq {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    letter-spacing: 0.02em;
  }
  .im-task { display: block; font-size: 12px; text-transform: uppercase; color: #6E6E6E; }
  .im-head h4 { margin: 4px 0 0; font-size: 16px; line-height: 1.3; font-weight: 600; color: #111111; }
  .im-tally { display: flex; flex-wrap: wrap; gap: 0 8px; margin-top: 8px; font-size: 11px; line-height: 1.6; color: #6E6E6E; }
  .im-tally > span:first-child { flex-basis: 100%; }
  .t-high { color: var(--sev-high); }
  .t-medium { color: var(--sev-medium); }
  .t-low { color: #6E6E6E; }

  .im-steps {
    list-style: none; margin: 0; padding: 0; position: relative;
    display: grid; grid-template-columns: repeat(10, minmax(0, 1fr));
  }
  .im-steps::before {
    content: ""; position: absolute; left: 5%; right: 5%; top: 7px; height: 1px; background: #C9C9C6;
  }
  .im-step { position: relative; display: flex; flex-direction: column; align-items: center; min-width: 0; }
  .im-node {
    position: relative; z-index: 1; width: 15px; height: 15px; border-radius: 50%;
    background: #FFFFFF; border: 1.5px solid #111111;
  }
  .im-step.is-hit .im-node { background: var(--cs-accent, #111111); border-color: var(--cs-accent, #111111); }
  .im-step.is-outside .im-node { border-style: dashed; border-color: #8A8A86; }
  .im-step.is-outside.is-hit .im-node { border-style: solid; }
  .im-label {
    margin-top: 6px; padding: 0 3px; text-align: center;
    font-size: 12px; line-height: 1.25; color: #3A3A3A;
  }
  .im-step.is-outside .im-label { color: #6E6E6E; }

  .im-issues { list-style: none; margin: 10px 0 0; padding: 0 3px; width: 100%; display: grid; gap: 6px; }
  .im-card {
    display: grid; gap: 3px; padding: 7px 8px; border-radius: 4px;
    border-left: 3px solid var(--sev); background: #F6F6F4;
    color: #111111; text-decoration: none;
    transition: background-color .15s ease, box-shadow .15s ease;
  }
  .im-card:hover { background: var(--cs-accent-tint, #F0F0EE); }
  .im-card:focus-visible { outline: 2px solid var(--cs-accent, #111111); outline-offset: 2px; }
  .im-id { font-size: 10.5px; white-space: nowrap; font-weight: 600; text-transform: uppercase; color: var(--sev); }
  .sev-low .im-id { color: #6E6E6E; }
  .im-text { font-size: 12px; line-height: 1.3; }
  .im-freq { font-size: 11px; color: #6E6E6E; }

  .im figcaption { margin-top: var(--space-caption, 16px); font-size: 14px; color: #6E6E6E; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .im-card { transition: none; } }
</style>
