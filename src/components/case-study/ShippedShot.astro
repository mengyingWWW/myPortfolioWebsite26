---
/**
 * A live screenshot with a pin per shipped change. A pin highlights its area, dims the rest and opens
 * a card with the original audit gap and what shipped. The pins and cards behave as in every pinned
 * screenshot (pin-figure.ts): Prev / Next, auto-open in view, one card open on the page at a time.
 * The rows under the image open the same cards. At 900px and below only a plain list shows, with
 * each gap linking to the audit.
 * Data: src/data/idea-ai-wiki/outcome-shipped.json (one entry per screen).
 */
import PinCard from './PinCard.astro';
import './pin-figure.css';

type Status = 'Shipped' | 'Partly shipped' | 'Added';
interface Item {
  id: string;
  status: Status;
  shipped: string;
  box: { x: number; y: number; w: number; h: number };
  pin: { x: number; y: number };
  gapTitle?: string;
  gapBody?: string;
}
interface Props {
  /** Unique per page; prefixes the popover ids. */
  name: string;
  shot: { title: string; image: string; width: number; height: number; alt: string; items: Item[] };
  /** A chip in the heading row saying how to use the pins; hidden with them at 900px and below. */
  hint?: string;
  /** No longer used: every figure opens its first card once when half in view. */
  autoOpen?: boolean;
}

const { name, shot, hint } = Astro.props;
const tone: Record<Status, string> = { Shipped: 'is-shipped', 'Partly shipped': 'is-partly', Added: 'is-added' };
// Near an edge the bubble hangs to one side of its tail, so it stays inside the image.
const align = (x: number) => (x > 93 ? 'is-r' : x < 7 ? 'is-l' : '');
const popId = (id: string) => `ss-${name}-${id}`;
const total = shot.items.length;
---

<section class="ss" aria-labelledby={`ss-${name}`} data-shipped-shot data-pin-figure>
  <div class="ss-head">
    <h3 class="ss-title" id={`ss-${name}`}>{shot.title}</h3>
    <span class="ss-live">Live</span>
    {
      hint && (
        <p class="ss-hint">
          <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true">
            <path d="M3 1.5h8a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H8.6L7 12.2 5.4 9.5H3a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2Z" fill="#067647" />
          </svg>
          {hint}
        </p>
      )
    }
  </div>

  <div class="ss-stage" data-pin-stage>
    <div class="ss-frame">
      <img src={shot.image} width={shot.width} height={shot.height} alt={shot.alt} loading="lazy" decoding="async" />
      <div class="pf-hl" aria-hidden="true" data-pin-hl></div>
    </div>
    {
      shot.items.map((item, i) => (
        <>
          <button
            type="button"
            class:list={['ss-pin', 'pf-pin', tone[item.status], align(item.pin.x)]}
            style={`left:${item.pin.x}%;top:${item.pin.y}%`}
            data-pin
            data-box={`${item.box.x},${item.box.y},${item.box.w},${item.box.h}`}
            data-tip={`${item.id} · ${item.gapTitle ?? 'Added beyond the audit'} — click to see`}
            aria-expanded="false"
            aria-controls={popId(item.id)}
            aria-label={`${item.id}: ${item.gapTitle ?? 'Added beyond the audit'}, ${item.status.toLowerCase()}`}
            data-cursor-label="VIEW"
          >
            {item.id}
          </button>
          <PinCard id={popId(item.id)} label={`${item.id} details`} index={i} total={total}>
            <div class="pf-pop-head">
              {item.gapTitle ? (
                <>
                  <p class="ss-pop-label">Original gap</p>
                  <p class="ss-pop-title">
                    {item.id} · {item.gapTitle}
                  </p>
                </>
              ) : (
                <p class="ss-pop-label">Added beyond the audit</p>
              )}
            </div>
            {item.gapBody && <p class="ss-pop-body">{item.gapBody}</p>}
            <div class="ss-pop-ship">
              <span class:list={['ss-status', tone[item.status]]}>{item.status}</span>
              <p>{item.shipped}</p>
            </div>
            {item.gapTitle && (
              <a class="ss-pop-link" href={`#issue-${item.id}`} data-pin-link>
                See it in the audit →
              </a>
            )}
          </PinCard>
        </>
      ))
    }
    <span class="pf-tip" aria-hidden="true" data-pin-tip></span>
  </div>

  <ol class="ss-list ss-rows">
    {
      shot.items.map((item) => (
        <li>
          <button type="button" class="ss-row" aria-controls={popId(item.id)} aria-expanded="false" data-pin-row>
            <span class:list={['ss-id', tone[item.status]]}>{item.id}</span>
            <span class="ss-list-status">{item.status}</span>
            <span class="ss-list-text">
              {item.gapTitle && (
                <>
                  <span class="ss-list-gap">{item.gapTitle}</span>{' '}
                  <span aria-hidden="true">→</span>{' '}
                </>
              )}
              {item.shipped}
            </span>
          </button>
        </li>
      ))
    }
  </ol>

  <ol class="ss-list ss-plain pf-plain">
    {
      shot.items.map((item) => (
        <li>
          {item.gapTitle ? (
            <a class:list={['ss-id', tone[item.status]]} href={`#issue-${item.id}`}>
              <span class="sr-only">issue </span>
              {item.id}
            </a>
          ) : (
            <span class:list={['ss-id', tone[item.status]]}>{item.id}</span>
          )}
          <span class="ss-list-status">{item.status}</span>
          <p class="ss-list-text">
            {item.gapTitle && (
              <>
                <span class="ss-list-gap">{item.gapTitle}</span>{' '}
                <span aria-hidden="true">→</span>{' '}
              </>
            )}
            {item.shipped}
          </p>
        </li>
      ))
    }
  </ol>
</section>

<script>
  import { initPinFigures } from './pin-figure';
  initPinFigures();
</script>

<style>
  .ss {
    display: grid;
    gap: 16px;
  }
  .ss-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ss-title {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.4;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #111;
  }
  .ss-live {
    padding: 4px 8px;
    border-radius: 999px;
    background: #ecfdf3;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #067647;
  }
  .ss-hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    padding: 5px 12px 5px 10px;
    border-radius: 999px;
    background: #f2f2f0;
    font-size: 13px;
    line-height: 1.3;
    color: #111;
  }
  .ss-hint svg {
    flex-shrink: 0;
  }

  .ss-stage {
    position: relative;
  }
  .ss-frame {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    background: #1c1c1c;
  }
  .ss-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The tail's tip sits on the pin point, and the pin scales about it (transform-origin 0 0 is that point). */
  .ss-pin {
    position: absolute;
    z-index: 1;
    min-width: 30px;
    height: 24px;
    padding: 0 7px;
    border: 2px solid #fff;
    border-radius: 999px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    line-height: 20px;
    color: #fff;
    cursor: pointer;
    transform: translate(-50%, calc(-100% - 6px));
    transform-origin: 0 0;
    transition:
      scale 150ms ease,
      box-shadow 150ms ease;
  }
  .ss-pin::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 50%;
    width: 8px;
    height: 8px;
    border-right: 2px solid #fff;
    border-bottom: 2px solid #fff;
    border-right-style: inherit;
    border-bottom-style: inherit;
    background: inherit;
    transform: translateX(-50%) rotate(45deg);
  }
  .ss-pin.is-r {
    transform: translate(calc(-100% + 11px), calc(-100% - 6px));
  }
  .ss-pin.is-r::after {
    left: auto;
    right: 11px;
    transform: translateX(50%) rotate(45deg);
  }
  .ss-pin.is-l {
    transform: translate(-13px, calc(-100% - 6px));
  }
  .ss-pin.is-l::after {
    left: 13px;
  }
  .ss-pin:focus-visible {
    outline: 2px solid #111;
    outline-offset: 2px;
  }
  .ss-pin:hover,
  .ss-pin:focus-visible,
  .ss-pin.is-linked {
    scale: 1.12;
  }
  .ss-pin.is-linked {
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.3),
      0 0 0 5px color-mix(in srgb, var(--tone) 55%, transparent);
  }

  .is-shipped {
    --tone: #067647;
  }
  .is-partly {
    --tone: #b54708;
  }
  .is-added {
    --tone: #067647;
  }
  .ss-pin.is-shipped,
  .ss-pin.is-partly,
  .ss-pin.is-added {
    background: var(--tone);
  }
  .ss-pin.is-added {
    border-style: dashed;
  }

  .ss-pop-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-meta);
  }
  .ss-pop-title {
    margin-top: 6px;
    font-size: 15px;
    line-height: 1.35;
    font-weight: 600;
    color: #111;
  }
  .ss-pop-body {
    margin-top: 4px;
    font-size: 14px;
    line-height: 1.45;
    color: #6e6e6e;
  }
  .ss-pop-ship {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid #e6e6e4;
  }
  .pf-pop-head + .ss-pop-ship {
    margin-top: 8px;
    padding-top: 0;
    border-top: 0;
  }
  .ss-pop-ship p {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.45;
    color: #111;
  }
  .ss-pop-link {
    display: inline-block;
    margin-top: 12px;
    font-size: 13px;
    color: #111;
  }

  .ss-status {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 999px;
    font-size: 12px;
    line-height: 1.2;
    font-weight: 500;
  }
  .ss-status.is-shipped,
  .ss-status.is-added {
    background: #ecfdf3;
    color: #067647;
  }
  .ss-status.is-partly {
    background: #fef6e7;
    color: #93370d;
  }

  .ss-list {
    border-top: 1px solid #e6e6e4;
  }
  .ss-list li {
    border-bottom: 1px solid #e6e6e4;
  }
  .ss-plain li,
  .ss-row {
    display: grid;
    grid-template-columns: 44px 112px minmax(0, 1fr);
    align-items: baseline;
    gap: 12px;
    padding: 10px 0;
  }
  .ss-row {
    width: 100%;
    font: inherit;
    text-align: left;
    background: transparent;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      box-shadow 150ms ease;
  }
  .ss-row:hover,
  .ss-row.is-linked,
  .ss-row[aria-expanded='true'] {
    background: #f6f6f4;
    box-shadow:
      -8px 0 0 #f6f6f4,
      8px 0 0 #f6f6f4;
  }
  .ss-row:focus-visible {
    outline: 2px solid #111;
    outline-offset: 2px;
  }
  .ss-id {
    justify-self: start;
    padding: 2px 7px;
    border-radius: 999px;
    background: var(--tone);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.4;
    color: #fff;
    text-decoration: none;
  }
  .ss-id.is-added {
    outline: 1px dashed var(--tone);
    outline-offset: 1px;
  }
  a.ss-id:hover {
    text-decoration: underline;
  }
  .ss-list-status {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-meta);
  }
  .ss-list-text {
    font-size: 14px;
    line-height: 1.5;
    color: #3a3a3a;
  }
  .ss-list-gap {
    font-weight: 600;
    color: #111;
  }

  @media (max-width: 900px) {
    .ss-hint,
    .ss-rows {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ss-pin,
    .ss-row {
      transition: none;
    }
  }
</style>
