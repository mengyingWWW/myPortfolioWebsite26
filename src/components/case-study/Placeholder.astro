---
/**
 * Stand-in for a figure that doesn't exist yet, at its final aspect ratio so nothing shifts when the
 * real asset arrives. Children (e.g. <StatusBadge>) are laid over the box.
 */
interface Props {
  label: string;
  /** e.g. "16/10" */
  ratio?: string;
  kind?: 'image' | 'motion' | 'diagram' | 'interactive';
  /** have: asset exists · need: must be obtained · make: must be created */
  source?: 'have' | 'need' | 'make';
  caption?: string;
  class?: string;
}

const { label, ratio = '16/10', kind = 'image', source = 'make', caption, class: className } = Astro.props;
const SOURCE = { have: 'Have', need: 'Need', make: 'To make' };
---

<figure class:list={['placeholder', className]}>
  <div class="frame">
    <div class="box" role="img" aria-label={label} style={`aspect-ratio: ${ratio.replace('/', ' / ')}`}>
      <span class="tags">
        <span class="tag">{kind}</span>
        {kind === 'motion' && <span class="tag">▶ GIF</span>}
      </span>
      <span class="label">{label}</span>
      <span class="tag">{SOURCE[source]}</span>
    </div>
    <slot />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .placeholder {
    max-width: 100%;
  }
  .frame {
    position: relative;
  }
  .box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 24px;
    border: 1px solid #e6e6e4;
    background: #f2f2f0;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    text-align: center;
    color: var(--color-meta);
  }
  .tags {
    display: flex;
    gap: 6px;
  }
  .tag {
    padding: 2px 6px;
    border: 1px solid #dcdcda;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .label {
    max-width: 48ch;
    color: #2a2a2a;
  }
  figcaption {
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-meta);
  }
</style>
