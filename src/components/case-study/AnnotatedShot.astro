---
// Annotated "before" screenshot for one flow: numbered pins on the image + the issue list beside it.
// Data: src/data/idea-ai-wiki/audit-issues.json (one entry per flow).
// Static for now; pins and list items share ids so an interactive version can be added later.
interface Issue { id: string; x: number; y: number; cause: string; title: string; body: string }
interface Props {
  flow: { title: string; image: string; width: number; height: number; alt: string; fix: string; issues: Issue[] };
  index: string; // "01"
}
const { flow, index } = Astro.props;
---
<section class="as" aria-labelledby={`as-${flow.title.toLowerCase()}`}>
  <h3 class="as-title" id={`as-${flow.title.toLowerCase()}`}>
    <span class="as-idx">{index}</span>{' '}{flow.title}{' '}
    <span class="as-count">{flow.issues.length} gaps</span>{' '}
    <span class="as-badge">Before</span>
  </h3>
  <div class="as-grid">
    <figure class="as-figure">
      <div class="as-frame">
        <img src={flow.image} width={flow.width} height={flow.height} alt={flow.alt} loading="lazy" decoding="async" />
        {flow.issues.map((i) => (
          <a class="as-pin" href={`#issue-${i.id}`} style={`left:${i.x}%;top:${i.y}%`} aria-label={`${i.id}: ${i.title}`}>
            {i.id}
          </a>
        ))}
      </div>
    </figure>
    <ol class="as-list">
      {flow.issues.map((i) => (
        <li id={`issue-${i.id}`}>
          <div class="as-head">
            <span class="as-code">{i.id}</span>
            <span class={`as-cause ${i.cause === "Uncategorized" ? "is-accent" : ""}`}>{i.cause}</span>
          </div>
          <p class="as-issue">{i.title}</p>
          <p class="as-body">{i.body}</p>
          <a class="as-fix" href={flow.fix}>See the fix →</a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .as { display: grid; gap: 20px; }
  .as-title { display: flex; align-items: baseline; gap: 12px; margin: 0; font-size: 22px; font-weight: 600; }
  .as-idx, .as-count, .as-code, .as-cause, .as-badge {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 12px; letter-spacing: 0.04em; font-weight: 400;
  }
  .as-idx, .as-count { color: #6E6E6E; }
  .as-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 32px; align-items: start; }
  .as-figure { margin: 0; min-width: 0; }
  .as-frame { position: relative; border-radius: 8px; overflow: hidden; background: #1c1c1c; }
  .as-frame img { display: block; width: 100%; height: auto; }
  .as-pin {
    position: absolute; transform: translate(-50%, -50%);
    min-width: 24px; height: 22px; padding: 0 5px; border-radius: 999px;
    background: #C2410C; color: #FFFFFF; border: 1.5px solid #FFFFFF;
    display: grid; place-items: center; text-decoration: none;
    font: 600 10px/1 var(--font-mono, ui-monospace, monospace);
    box-shadow: 0 2px 8px rgba(0,0,0,.35);
  }
  .as-pin:focus-visible { outline: 2px solid #FFFFFF; outline-offset: 2px; }
  .as-badge { margin-left: auto; padding: 3px 10px; border-radius: 999px; background: #F2F2F0; color: #111111; border: 1px solid #E6E6E4; }
  .as-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border-top: 1px solid #E6E6E4; }
  .as-list li { padding: 14px 0; border-bottom: 1px solid #E6E6E4; scroll-margin-top: 120px; }
  .as-list li:target { background: #FFF4EE; box-shadow: -8px 0 0 #FFF4EE, 8px 0 0 #FFF4EE; }
  .as-head { display: flex; align-items: center; gap: 10px; }
  .as-code { color: #FFFFFF; background: #C2410C; border-radius: 999px; padding: 2px 8px; }
  .as-cause { color: #6E6E6E; }
  .as-cause.is-accent { color: #9A3412; }
  .as-issue { margin: 8px 0 4px; font-size: 15px; font-weight: 600; color: #111111; }
  .as-body { margin: 0; font-size: 14px; line-height: 1.45; color: #3A3A3A; }
  .as-fix { display: inline-block; margin-top: 8px; font-size: 13px; color: #111111; text-underline-offset: 3px; }
  @media (max-width: 900px) {
    .as-grid { grid-template-columns: 1fr; }
    .as-pin { min-width: 20px; height: 18px; font-size: 9px; padding: 0 3px; }
  }
</style>
