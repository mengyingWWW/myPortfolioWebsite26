---
/**
 * One key decision told AKOOL-style: number + short heading, a one- or two-sentence lead (the problem),
 * then an earlier design round next to the final round (not two products: rounds of one iteration), each with its own one-line reasoning,
 * then where each side carries its own one-line reasoning, then a trade-off card.
 * `before` is optional (D2 shows explored options in the "explore" slot instead).
 * Media: a still (src with extension) or a looping clip (src without extension, clip: true).
 */
import ClipPlayer from '@/components/case-study/ClipPlayer.astro';

interface Side {
  src: string;
  alt: string;
  /** Short bold line: what it is. */
  title: string;
  /** One sentence: why it worked / didn't. */
  note: string;
  clip?: boolean;
}
interface Props {
  id: string;
  n: string;
  title: string;
  lead: string;
  before?: Side;
  after: Side;
  tradeoff: string;
  /** Pill text, e.g. "Round 1". Defaults: "Earlier round" / "Final round". */
  beforeLabel?: string;
  afterLabel?: string;
}
const {
  id, n, title, lead, before, after, tradeoff,
  beforeLabel = 'Earlier round', afterLabel = 'Final round',
} = Astro.props;
const hasExplore = Astro.slots.has('explore');
---

<article class="dc" id={id}>
  <header class="dc-head">
    <span class="dc-n">{n}</span>
    <h3 class="dc-title">{title}</h3>
    <p class="dc-lead">{lead}</p>
  </header>

  {hasExplore && <div class="dc-explore"><slot name="explore" /></div>}

  <div class:list={['dc-compare', { 'is-single': !before }]}>
    {before && (
      <figure class="dc-side is-before">
        <span class="dc-pill">{beforeLabel}</span>
        <div class="dc-phone">
          {before.clip
            ? <ClipPlayer src={before.src} label={before.alt} width={780} height={1688} />
            : <img src={before.src} alt={before.alt} loading="lazy" decoding="async" />}
        </div>
        <figcaption><b>{before.title}</b>{before.note}</figcaption>
      </figure>
    )}
    {before && <span class="dc-arrow" aria-hidden="true">→</span>}
    <figure class="dc-side is-after">
      <span class="dc-pill">{afterLabel}</span>
      <div class="dc-phone">
        {after.clip
          ? <ClipPlayer src={after.src} label={after.alt} width={780} height={1688} />
          : <img src={after.src} alt={after.alt} loading="lazy" decoding="async" />}
      </div>
      <figcaption><b>{after.title}</b>{after.note}</figcaption>
    </figure>
  </div>

  <div class="dc-trade">
    <span class="dc-trade-pill">Trade-off</span>
    <p>{tradeoff}</p>
  </div>
</article>

<style>
  .dc { scroll-margin-top: calc(5rem + 24px); }
  .dc + .dc { margin-top: 96px; }
  .dc-head { max-width: 62ch; }
  .dc-n { display: inline-block; font: 500 12px/1.4 var(--font-mono, ui-monospace, monospace); letter-spacing: .06em; color: var(--cs-accent-text, #115E59); }
  .dc-title { margin-top: 8px; font-size: 24px; line-height: 1.25; font-weight: 600; color: #111; }
  .dc-lead { margin-top: 10px; font-size: 17px; line-height: 1.6; color: #3a3a3a; }
  .dc-explore { margin-top: 32px; }

  .dc-compare { margin-top: 32px; display: grid; grid-template-columns: minmax(0,1fr) auto minmax(0,1fr); align-items: center; gap: 14px; }
  .dc-arrow { font-size: 22px; color: var(--cs-accent, #0F766E); }
  .dc-side { align-self: stretch; }
  .dc-compare.is-single { grid-template-columns: minmax(0, 560px); justify-content: center; }
  .dc-side { margin: 0; border-radius: 20px; padding: 24px 24px 26px; display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .is-before { background: #F3F3F2; }
  .is-after { background: var(--cs-accent-tint, #F0FDFA); box-shadow: inset 0 0 0 1px var(--cs-accent-border, #99F6E4); }

  .dc-pill { align-self: flex-start; display: inline-flex; align-items: center; gap: 4px; height: 28px; padding: 0 12px; border-radius: 999px; font-size: 13px; font-weight: 600; }
  .dc-pill em { font-style: normal; font-weight: 400; opacity: .75; }
  .is-before .dc-pill { background: #E2E2E0; color: #555; }
  .is-after .dc-pill { background: var(--cs-accent, #0F766E); color: #fff; }

  .dc-phone { width: min(100%, 250px); aspect-ratio: 780 / 1688; border-radius: 26px; overflow: hidden; background: #fff; border: 1px solid #E6E6E4; box-shadow: 0 10px 28px rgba(17, 24, 39, .08); }
  .dc-phone :global(.clip) { height: 100%; }
  .dc-phone :global(img), .dc-phone :global(video) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .is-before .dc-phone { filter: grayscale(.35); opacity: .9; box-shadow: none; }

  figcaption { align-self: stretch; font-size: 15px; line-height: 1.5; color: #555; text-align: left; }
  figcaption b { display: block; margin-bottom: 2px; font-weight: 600; color: #111; }

  .dc-trade { margin-top: 20px; display: flex; align-items: center; gap: 14px; padding: 16px 20px; border: 1px solid #E6E6E4; border-radius: 14px; background: #fff; }
  .dc-trade-pill { flex: none; height: 26px; padding: 0 10px; display: inline-flex; align-items: center; border-radius: 999px; background: #F3F3F2; font-size: 12px; font-weight: 600; color: #555; }
  .dc-trade p { margin: 0; font-size: 15px; line-height: 1.5; color: #3a3a3a; }

  @media (max-width: 640px) {
    .dc + .dc { margin-top: 64px; }
    .dc-title { font-size: 21px; }
    .dc-compare { gap: 6px; }
    .dc-arrow { font-size: 16px; }
    .dc-side { padding: 14px 12px 16px; gap: 14px; border-radius: 16px; }
    .dc-phone { border-radius: 16px; }
    figcaption { font-size: 13px; }
    .dc-trade { align-items: flex-start; flex-direction: column; gap: 8px; }
  }
</style>
