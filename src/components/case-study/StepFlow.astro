---
/**
 * A linear process as a row of steps. Highlighted steps carry the accent and a short note under them
 * (e.g. where people get stuck). An ordered list, so the sequence is announced; wraps to a column
 * on narrow screens.
 */
interface Props {
  steps: { name: string; note?: string; highlight?: boolean }[];
  caption?: string;
  ariaLabel?: string;
}
const { steps, caption, ariaLabel } = Astro.props;
---

<figure class="sf">
  <ol aria-label={ariaLabel} style={`--n:${steps.length}`}>
    {steps.map((s) => (
      <li class:list={[{ hi: s.highlight }]}>
        <span class="name">{s.name}</span>
        {s.note && <span class="note">{s.note}</span>}
      </li>
    ))}
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  ol {
    display: grid;
    grid-template-columns: repeat(var(--n, 5), minmax(0, 1fr));
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
  }
  li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    counter-increment: step;
  }
  li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 28px;
    right: -22px;
    width: 16px;
    height: 1px;
    background: var(--color-meta);
  }
  .name {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 8px 14px;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    font-size: 15px;
    line-height: 1.3;
    color: var(--color-meta);
    background: var(--color-paper);
  }
  .hi .name {
    border-color: var(--cs-accent, #4f46e5);
    background: var(--cs-accent-tint, #eef2ff);
    color: var(--cs-accent-text, #4338ca);
    font-weight: 500;
  }
  .note {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-meta);
  }
  figcaption { margin-top: 16px; font-size: 14px; line-height: 1.5; color: var(--color-meta); }

  @media (max-width: 640px) {
    ol { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    li { flex-direction: row; align-items: center; gap: 12px; }
    li::after { display: none; }
    .name { min-height: 44px; flex: 0 0 55%; }
  }
</style>
