---
// One "moment that stopped teachers" for colleague-ai "03 Findings": an annotated screen from the study
// sandbox (sample data only, names replaced), the issues it shows, what happened and one verbatim quote.
// Pins are numbered markers at x/y (% of the image); their notes are listed under the image, so nothing
// is hover-only. Issue chips link to the full list (#issue-XX).
interface Pin { x: number; y: number; note: string }
interface Props {
  ids: string[];
  title: string;
  text: string;
  quote?: string;
  quoteBy?: string;
  image: string;
  width: number;
  height: number;
  alt: string;
  pins?: Pin[];
}
const { ids, title, text, quote, quoteBy, image, width, height, alt, pins = [] } = Astro.props;
---

<article class="ms">
  <figure class="ms-figure">
    <div class="ms-stage">
      <img src={image} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
      {pins.map((p, n) => (
        <span class="ms-pin" style={`left:${p.x}%;top:${p.y}%`} aria-hidden="true">{n + 1}</span>
      ))}
    </div>
    {pins.length > 0 && (
      <ol class="ms-notes">
        {pins.map((p) => <li>{p.note}</li>)}
      </ol>
    )}
    <figcaption class="sr-only">Study sandbox with sample data. Names replaced.</figcaption>
  </figure>
  <div class="ms-text">
    <p class="ms-ids">
      {ids.map((id) => <a href={`#issue-${id}`} data-cursor-label="VIEW" aria-label={`Issue ${id}`}>{id}</a>)}
    </p>
    <h4 class="ms-title">{title}</h4>
    <p class="ms-body">{text}</p>
    {quote && (
      <blockquote class="ms-quote">
        <p>“{quote}”</p>
        {quoteBy && <footer>{quoteBy}</footer>}
      </blockquote>
    )}
  </div>
</article>

<style>
  .ms { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 32px; align-items: start; }
  .ms + :global(.ms) { margin-top: 64px; }
  .ms-figure { margin: 0; }
  .ms-stage { position: relative; border: 1px solid #E6E6E4; border-radius: 8px; overflow: hidden; background: #FFFFFF; }
  .ms-stage img { display: block; width: 100%; height: auto; }
  .ms-pin {
    position: absolute; transform: translate(-50%, -50%);
    display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%;
    background: var(--cs-accent, #111111); color: #FFFFFF; box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.9);
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace); font-size: 13px; font-weight: 600;
  }
  .ms-notes {
    margin: 12px 0 0; padding: 0; list-style: none; counter-reset: n; display: grid; gap: 6px;
    font-size: 14px; line-height: 1.45; color: #3A3A3A;
  }
  .ms-notes li { counter-increment: n; display: grid; grid-template-columns: 22px 1fr; gap: 6px; }
  .ms-notes li::before {
    content: counter(n); display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%;
    background: var(--cs-accent-tint, #F6F6F4); color: var(--cs-accent-text, #111111);
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace); font-size: 11px; font-weight: 600;
  }

  .ms-ids { display: flex; gap: 6px; margin: 0; }
  .ms-ids a {
    display: inline-flex; align-items: center; min-height: 28px; padding: 2px 10px; border-radius: 999px;
    background: var(--cs-accent-tint, #F6F6F4); color: var(--cs-accent-text, #111111);
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace); font-size: 12px; font-weight: 600;
    text-decoration: none;
  }
  .ms-ids a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .ms-ids a:focus-visible { outline: 2px solid var(--cs-accent, #111111); outline-offset: 2px; }
  .ms-title { margin: 12px 0 0; font-size: 20px; line-height: 1.3; font-weight: 500; letter-spacing: -0.01em; color: #111111; }
  .ms-body { margin: 8px 0 0; font-size: 16px; line-height: 1.6; color: #3A3A3A; }
  .ms-quote { margin: 20px 0 0; padding-left: 16px; border-left: 3px solid var(--cs-accent, #111111); }
  .ms-quote p { margin: 0; font-family: var(--font-serif, Georgia, serif); font-style: italic; font-size: 19px; line-height: 1.45; color: #111111; }
  .ms-quote footer {
    margin-top: 8px; font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 12px; letter-spacing: 0.04em; color: #6E6E6E;
  }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 900px) { .ms { grid-template-columns: 1fr; gap: 20px; } }
</style>
