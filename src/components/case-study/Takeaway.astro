---
/**
 * One numbered takeaway: mono index, title and a paragraph. Renders an <li>, so wrap the items in
 * an <ol>; the visible index is hidden from screen readers, which already announce the list number.
 */
interface Props {
  n: number;
  title: string;
}

const { n, title } = Astro.props;
---

<li class="tk">
  <p class="tk-index" aria-hidden="true">{String(n).padStart(2, '0')}</p>
  <h3 class="tk-title">{title}</h3>
  <p class="tk-body"><slot /></p>
</li>

<style>
  .tk + .tk {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid #e6e6e4;
  }

  .tk-index {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--color-meta);
  }
  .tk-title {
    margin-top: 8px;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 600;
    color: #111;
  }
  .tk-body {
    max-width: 680px;
    margin-top: 8px;
    font-size: 18px;
    line-height: 1.6;
    color: #3a3a3a;
  }

  @media (max-width: 900px) {
    .tk + .tk {
      margin-top: 16px;
      padding-top: 16px;
    }
  }
</style>
