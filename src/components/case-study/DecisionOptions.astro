---
// Design-decision comparison for idea-ai-wiki "06 Redesign · Contribute".
// Controlled comparison: the same editor, procedure and steps in all three frames.
// Only the Tags control changes. A and B existed in the engineering prototype; C was chosen.
// Wireframes are decorative (aria-hidden); all meaning is in the text.
const options = [
  {
    key: "A", src: "In the prototype", variant: "free",
    name: "Free-text fields",
    how: "Type every tag by hand.",
    result: "Fields left blank.",
    cost: "Every author spells tags differently.",
  },
  {
    key: "B", src: "In the prototype", variant: "list",
    name: "Fixed category list",
    how: "Pick one from a set list.",
    result: "3 of 18 pages categorized.",
    cost: "The list never covers every job.",
  },
  {
    key: "C", src: "Chosen", variant: "suggest", chosen: true,
    name: "AI suggests, author confirms",
    how: "Tags come from the steps. One click accepts them.",
    result: "Tags added in one click.",
    cost: "Depends on good suggestions.",
  },
];
---
<figure class="do">
  <p class="do-q">How should a page get its tags?</p>
  <ol class="do-grid">
    {options.map((o) => (
      <li class={`do-card ${o.chosen ? "is-chosen" : ""}`}>
        <div class="do-head">
          <span class="do-letter">{o.key}</span>
          {o.chosen ? <span class="do-badge">{o.src}</span> : <span class="do-src">{o.src}</span>}
        </div>

        <svg class="do-wire" viewBox="0 0 280 176" aria-hidden="true">
          <rect x="0.5" y="0.5" width="279" height="175" rx="6" fill="#FAFAF8" stroke="#E6E6E4" />
          <text x="16" y="24" class="w-title">Replace air filter</text>
          <g class="w-step">
            <circle cx="24" cy="44" r="8" fill="#FFFFFF" stroke="#D9D9D6" />
            <text x="24" y="47.5" text-anchor="middle" class="w-num">1</text>
            {o.variant === "suggest"
              ? <text x="40" y="47.5">Turn off the <tspan class="w-hit">HVAC</tspan> unit.</text>
              : <text x="40" y="47.5">Turn off the HVAC unit.</text>}
            <circle cx="24" cy="66" r="8" fill="#FFFFFF" stroke="#D9D9D6" />
            <text x="24" y="69.5" text-anchor="middle" class="w-num">2</text>
            {o.variant === "suggest"
              ? <text x="40" y="69.5">Swap the <tspan class="w-hit">air filter</tspan>.</text>
              : <text x="40" y="69.5">Swap the air filter.</text>}
          </g>
          <line x1="16" y1="86" x2="264" y2="86" stroke="#E6E6E4" />
          <text x="16" y="104" class="w-label">Tags</text>

          {o.variant === "free" && (
            <g>
              <rect x="16" y="112" width="248" height="26" rx="4" fill="#FFFFFF" stroke="#D9D9D6" />
              <line x1="25" y1="118" x2="25" y2="132" stroke="#111111" stroke-width="1.5" />
              <text x="31" y="129" class="w-ph">Type tags</text>
              <text x="16" y="158" class="w-hint">Comma-separated</text>
            </g>
          )}
          {o.variant === "list" && (
            <g>
              <rect x="16" y="112" width="248" height="26" rx="4" fill="#FFFFFF" stroke="#D9D9D6" />
              <text x="26" y="129" class="w-ph">Select a category</text>
              <path d="M244 122 l5 5 l5 -5" fill="none" stroke="#6E6E6E" stroke-width="1.5" />
              <text x="16" y="158" class="w-hint">One category per page</text>
            </g>
          )}
          {o.variant === "suggest" && (
            <g>
              <rect x="16" y="112" width="66" height="26" rx="13" fill="#FFF4EE" stroke="#C2410C" stroke-dasharray="3 2" />
              <text x="49" y="129" text-anchor="middle" class="w-chip">HVAC ✓</text>
              <rect x="88" y="112" width="84" height="26" rx="13" fill="#FFF4EE" stroke="#C2410C" stroke-dasharray="3 2" />
              <text x="130" y="129" text-anchor="middle" class="w-chip">Air filter ✓</text>
              <rect x="178" y="112" width="54" height="26" rx="13" fill="#FFFFFF" stroke="#D9D9D6" />
              <text x="205" y="129" text-anchor="middle" class="w-ph">+ Add</text>
              <text x="16" y="158" class="w-hint is-accent">Suggested from steps 1–2</text>
            </g>
          )}
        </svg>

        <h4 class="do-name">{o.name}</h4>
        <p class="do-how">{o.how}</p>
        <div class="do-row do-result"><span class="do-label">Result</span><p>{o.result}</p></div>
        <div class="do-row"><span class="do-label">Trade-off</span><p>{o.cost}</p></div>
      </li>
    ))}
  </ol>
  <figcaption>Same editor, same steps. Only the tag control changes. A and B were already in the prototype.</figcaption>
</figure>

<style>
  .do { margin: 0; }
  .do-q { margin: 0 0 16px; font-size: 18px; font-weight: 600; color: #111111; }
  .do-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .do-card { display: grid; grid-row: span 6; grid-template-rows: subgrid; row-gap: 10px; padding: 16px; border: 1px solid #E6E6E4; border-radius: 10px; background: #FFFFFF; }
  .do-card.is-chosen { border: 1.5px solid #C2410C; background: #FFFBF8; }
  .do-head { display: flex; align-items: center; justify-content: space-between; }
  .do-letter, .do-src, .do-badge, .do-label {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 12px; letter-spacing: 0.04em;
  }
  .do-letter { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: #F2F2F0; color: #111111; }
  .is-chosen .do-letter { background: #C2410C; color: #FFFFFF; }
  .do-src { color: #6E6E6E; }
  .do-badge { padding: 3px 10px; border-radius: 999px; background: #C2410C; color: #FFFFFF; }

  .do-wire { display: block; width: 100%; height: auto; }
  .do-wire text { font-family: inherit; font-size: 10.5px; fill: #3A3A3A; }
  .do-wire .w-title { font-size: 12px; font-weight: 600; fill: #111111; }
  .do-wire .w-num { font-size: 9px; fill: #6E6E6E; }
  .do-wire .w-hit { fill: #9A3412; font-weight: 600; text-decoration: underline; }
  .do-wire .w-label { font-size: 10px; fill: #6E6E6E; }
  .do-wire .w-ph { fill: #8A8A87; }
  .do-wire .w-chip { fill: #9A3412; }
  .do-wire .w-hint { font-size: 9.5px; fill: #8A8A87; }
  .do-wire .w-hint.is-accent { fill: #9A3412; }

  .do-name { margin: 4px 0 0; font-size: 16px; font-weight: 600; color: #111111; }
  .is-chosen .do-name { color: #9A3412; }
  .do-how { margin: 0; font-size: 14px; line-height: 1.45; color: #3A3A3A; }
  .do-row { display: grid; gap: 2px; align-content: start; }
  .do-result { padding-top: 10px; border-top: 1px solid #E6E6E4; }
  .do-label { color: #6E6E6E; text-transform: uppercase; }
  .do-row p { margin: 0; font-size: 14px; line-height: 1.4; color: #111111; }
  .do figcaption { margin-top: 12px; font-size: 14px; color: #6E6E6E; }
  @media (max-width: 760px) { .do-grid { grid-template-columns: 1fr; } }
  @supports not (grid-template-rows: subgrid) { .do-card { display: flex; flex-direction: column; } .do-result { margin-top: auto; } }
</style>
