---
// Design-decision comparison for idea-ai-wiki "06 Redesign · Govern".
// Controlled comparison: the same procedure and the same suggested edit in all three frames.
// Only the review model changes. A is the prototype; C is Mengying's proposal and shipped.
// Wireframes are decorative (aria-hidden); all meaning is in the text.
const options = [
  {
    key: "A", src: "In the prototype", variant: "page",
    name: "Page-level accept",
    how: "Accept or decline the whole edit.",
    result: "Only step 1 shows what changed.",
    cost: "One bad step sinks the whole edit.",
  },
  {
    key: "B", src: "Considered", variant: "step",
    name: "Approve each step",
    how: "Accept or reject every step on its own.",
    result: "A page can go live half-approved.",
    cost: "Steps that depend on each other split apart.",
  },
  {
    key: "C", src: "Chosen · Shipped", variant: "comment", chosen: true,
    name: "Step comments, one decision",
    how: "See every change, comment on a step, decide once.",
    result: "Feedback lands on the exact step.",
    cost: "Reviewers read the full page before deciding.",
  },
];
---
<figure class="ro">
  <p class="ro-q">How should a reviewer approve an edit?</p>
  <ol class="ro-grid">
    {options.map((o) => (
      <li class={`ro-card ${o.chosen ? "is-chosen" : ""}`}>
        <div class="ro-head">
          <span class="ro-letter">{o.key}</span>
          {o.chosen ? <span class="ro-badge">{o.src}</span> : <span class="ro-src">{o.src}</span>}
        </div>

        <svg class="ro-wire" viewBox="0 0 280 176" aria-hidden="true">
          <rect x="0.5" y="0.5" width="279" height="175" rx="6" fill="#FAFAF8" stroke="#E6E6E4" />
          <text x="16" y="24" class="w-title">Replace air filter</text>
          <text x="264" y="24" text-anchor="end" class="w-meta">Suggested edit</text>

          <circle cx="24" cy="44" r="8" fill="#FFFFFF" stroke="#D9D9D6" />
          <text x="24" y="47.5" text-anchor="middle" class="w-num">1</text>
          <text x="40" y="47.5">Turn off the <tspan class="w-del">fan</tspan> <tspan class="w-add">HVAC unit</tspan>.</text>

          <circle cx="24" cy="66" r="8" fill="#FFFFFF" stroke="#D9D9D6" />
          <text x="24" y="69.5" text-anchor="middle" class="w-num">2</text>
          {o.variant === "page"
            ? <text x="40" y="69.5">Swap the 20×25 air filter.</text>
            : <text x="40" y="69.5">Swap the <tspan class="w-add">20×25</tspan> air filter.</text>}

          {o.variant === "step" && (
            <g>
              <rect x="226" y="36" width="38" height="16" rx="8" fill="#ECFDF3" stroke="#067647" />
              <text x="245" y="47.5" text-anchor="middle" class="w-ok">✓ Yes</text>
              <rect x="226" y="58" width="38" height="16" rx="8" fill="#FEF3F2" stroke="#D92D20" />
              <text x="245" y="69.5" text-anchor="middle" class="w-no">✗ No</text>
            </g>
          )}
          {o.variant === "comment" && (
            <g>
              <circle cx="256" cy="66" r="6" fill="#FEF0C7" stroke="#B54708" />
            </g>
          )}

          <line x1="16" y1="86" x2="264" y2="86" stroke="#E6E6E4" />

          {o.variant === "comment" && (
            <g>
              <rect x="16" y="94" width="248" height="20" rx="3" fill="#FFFFFF" stroke="#E6E6E4" />
              <rect x="16" y="94" width="3" height="20" fill="#B54708" />
              <text x="26" y="107.5" class="w-cmt">Step 2: Is the size on every unit?</text>
            </g>
          )}

          {o.variant === "page" && (
            <g>
              <rect x="16" y="122" width="64" height="22" rx="4" fill="#111111" />
              <text x="48" y="136.5" text-anchor="middle" class="w-btn-on">Accept</text>
              <rect x="86" y="122" width="64" height="22" rx="4" fill="#FFFFFF" stroke="#D9D9D6" />
              <text x="118" y="136.5" text-anchor="middle" class="w-btn">Decline</text>
              <text x="16" y="164" class="w-hint">One decision for the whole page</text>
            </g>
          )}
          {o.variant === "step" && (
            <g>
              <rect x="16" y="122" width="150" height="22" rx="4" fill="#111111" />
              <text x="91" y="136.5" text-anchor="middle" class="w-btn-on">Publish approved (1 of 2)</text>
              <text x="16" y="164" class="w-hint">One decision per step</text>
            </g>
          )}
          {o.variant === "comment" && (
            <g>
              <rect x="16" y="122" width="62" height="22" rx="4" fill="#111111" />
              <text x="47" y="136.5" text-anchor="middle" class="w-btn-on">Approve</text>
              <rect x="84" y="122" width="104" height="22" rx="4" fill="#FFFFFF" stroke="#D9D9D6" />
              <text x="136" y="136.5" text-anchor="middle" class="w-btn">Request changes</text>
              <rect x="194" y="122" width="52" height="22" rx="4" fill="#FFFFFF" stroke="#D9D9D6" />
              <text x="220" y="136.5" text-anchor="middle" class="w-btn">Reject</text>
              <text x="16" y="164" class="w-hint is-accent">Comments per step, one decision per page</text>
            </g>
          )}
        </svg>

        <h4 class="ro-name">{o.name}</h4>
        <p class="ro-how">{o.how}</p>
        <div class="ro-row ro-result"><span class="ro-label">Result</span><p>{o.result}</p></div>
        <div class="ro-row"><span class="ro-label">Trade-off</span><p>{o.cost}</p></div>
      </li>
    ))}
  </ol>
  <figcaption>Same procedure, same edit. Only the review model changes. Red is removed text, green is added, amber is a comment.</figcaption>
</figure>

<style>
  .ro { margin: 0; }
  .ro-q { margin: 0 0 16px; font-size: 18px; font-weight: 600; color: #111111; }
  .ro-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .ro-card { display: grid; grid-row: span 6; grid-template-rows: subgrid; row-gap: 10px; padding: 16px; border: 1px solid #E6E6E4; border-radius: 10px; background: #FFFFFF; }
  .ro-card.is-chosen { border: 1.5px solid #C2410C; background: #FFFBF8; }
  .ro-head { display: flex; align-items: center; justify-content: space-between; }
  .ro-letter, .ro-src, .ro-badge, .ro-label {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 12px; letter-spacing: 0.04em;
  }
  .ro-letter { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: #F2F2F0; color: #111111; }
  .is-chosen .ro-letter { background: #C2410C; color: #FFFFFF; }
  .ro-src { color: #6E6E6E; }
  .ro-badge { padding: 3px 10px; border-radius: 999px; background: #C2410C; color: #FFFFFF; }

  .ro-wire { display: block; width: 100%; height: auto; }
  .ro-wire text { font-family: inherit; font-size: 10.5px; fill: #3A3A3A; }
  .ro-wire .w-title { font-size: 12px; font-weight: 600; fill: #111111; }
  .ro-wire .w-meta { font-size: 9.5px; fill: #8A8A87; }
  .ro-wire .w-num { font-size: 9px; fill: #6E6E6E; }
  .ro-wire .w-del { fill: #D92D20; text-decoration: line-through; }
  .ro-wire .w-add { fill: #067647; font-weight: 600; }
  .ro-wire .w-ok { font-size: 9px; fill: #067647; }
  .ro-wire .w-no { font-size: 9px; fill: #D92D20; }
  .ro-wire .w-cmt { font-size: 9.5px; fill: #3A3A3A; }
  .ro-wire .w-btn { font-size: 9.5px; fill: #111111; }
  .ro-wire .w-btn-on { font-size: 9.5px; fill: #FFFFFF; }
  .ro-wire .w-hint { font-size: 9.5px; fill: #8A8A87; }
  .ro-wire .w-hint.is-accent { fill: #9A3412; }

  .ro-name { margin: 4px 0 0; font-size: 16px; font-weight: 600; color: #111111; }
  .is-chosen .ro-name { color: #9A3412; }
  .ro-how { margin: 0; font-size: 14px; line-height: 1.45; color: #3A3A3A; }
  .ro-row { display: grid; gap: 2px; align-content: start; }
  .ro-result { padding-top: 10px; border-top: 1px solid #E6E6E4; }
  .ro-label { color: #6E6E6E; text-transform: uppercase; }
  .ro-row p { margin: 0; font-size: 14px; line-height: 1.4; color: #111111; }
  .ro figcaption { margin-top: 12px; font-size: 14px; color: #6E6E6E; }
  @media (max-width: 760px) { .ro-grid { grid-template-columns: 1fr; } }
  @supports not (grid-template-rows: subgrid) { .ro-card { display: flex; flex-direction: column; } .ro-result { margin-top: auto; } }
</style>
