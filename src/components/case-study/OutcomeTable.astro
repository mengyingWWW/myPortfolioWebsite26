---
/**
 * Where each audit gap ended up: one row per status, with a labelled pill (so the status never relies on
 * colour alone), a count, and the gaps in it. Gap ids link to their #issue-<id> item in the audit.
 */
type Status = 'Shipped' | 'Partly shipped' | 'Next phase' | 'Added';
interface Props {
  rows: { status: Status; gaps: { id?: string; title: string }[] }[];
  caption?: string;
}

const { rows, caption } = Astro.props;
const tone: Record<Status, string> = { Shipped: 'is-shipped', 'Partly shipped': 'is-partly', 'Next phase': 'is-next', Added: 'is-added' };
---

<div class="table-scroll">
  <table>
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>
        <th scope="col">Status</th>
        <th scope="col">Gaps</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map(({ status, gaps }) => (
          <tr>
            <th scope="row">
              <span class:list={['pill', tone[status]]}>{status}</span>{' '}
              <span class="count">({gaps.length})</span>
            </th>
            <td>
              <ul>
                {gaps.map(({ id, title }) => (
                  <li>
                    {id && (
                      <a class="id" href={`#issue-${id}`}>
                        <span class="sr-only">issue </span>
                        {id}
                      </a>
                    )}
                    {id && ' '}
                    {title}
                  </li>
                ))}
              </ul>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-scroll {
    overflow-x: auto;
  }
  table {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
  }
  caption {
    padding-bottom: 16px;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.4;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #111;
  }
  thead th {
    padding: 0 16px 12px 0;
    border-bottom: 1px solid #111;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-meta);
  }
  tbody th,
  td {
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--color-line);
    vertical-align: top;
    text-align: left;
    font-size: 15px;
    line-height: 1.5;
    font-weight: 400;
    color: #111;
  }
  tbody th {
    width: 200px;
    white-space: nowrap;
  }
  ul {
    display: grid;
    gap: 6px;
  }
  .id {
    display: inline-block;
    min-width: 32px;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .count {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-meta);
  }

  .pill {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 12px;
    line-height: 1.2;
    font-weight: 500;
    white-space: nowrap;
  }
  .is-shipped,
  .is-added {
    background: #ecfdf3;
    color: #067647;
  }
  .is-partly {
    background: #fef6e7;
    color: #b54708;
  }
  .is-next {
    background: #f2f2f0;
    color: #6e6e6e;
  }
</style>
