<style>
  .ia { margin: 0; }
  .ia-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .ia svg { display: block; width: 100%; height: auto; }
  @media (max-width: 900px) { .ia svg { min-width: 1000px; } }
  .ia text { font-family: inherit; font-size: 13px; }
  .ia .b { font-weight: 600; font-size: 14px; }
  .ia .lbl, .ia .lg text { font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace); font-size: 12px; letter-spacing: .06em; fill: #6E6E6E; }
  .ia .bul { font-size: 12px; fill: #6E6E6E; }
  .ia .ln { fill: none; stroke: #9A9A96; stroke-width: 1.25; }
  .ia .dot { fill: #9A9A96; }
  .ia .sep { stroke: #E6E6E4; }
  .ia .flow { fill: none; stroke: #6E6E6E; stroke-width: 1.25; stroke-dasharray: 4 4; }
  .ia .fl { font-family: var(--font-mono, ui-monospace, monospace); font-size: 11px; fill: #6E6E6E; }
  .ia .n-same { fill: #EDEDEB; }
  .ia .t-n-same { fill: #3A3A3A; }
  .ia .n-changed { fill: #FFFFFF; stroke: #111111; stroke-width: 1.5; }
  .ia .t-n-changed { fill: #111111; }
  .ia .n-new { fill: #111111; }
  .ia .t-n-new { fill: #FFFFFF; }
  .ia .n-ai { fill: var(--cs-accent-tint); stroke: var(--cs-accent); stroke-width: 1.5; }
  .ia .t-n-ai { fill: var(--cs-accent-text); }
</style>
