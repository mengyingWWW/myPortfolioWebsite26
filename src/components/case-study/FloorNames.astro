---
/** D2 constraint: the real floor names of one building, letters highlighted. */
interface Props { floors?: string[]; caption?: string }
const { floors = ['4', '3', '2', '1', 'M', 'B1', 'B2'], caption = 'Main Building, top to bottom. Letters mark a mezzanine and two basements.' } = Astro.props;
---
<figure class="fn">
  <div class="fn-row">{floors.map((f) => <span class:list={{ lt: /[A-Z]/.test(f) }}>{f}</span>)}</div>
  <figcaption>{caption}</figcaption>
</figure>
<style>
  .fn { margin: 28px 0 0; }
  .fn-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .fn-row span { width: 56px; height: 56px; border-radius: 14px; background: #F3F3F2; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 600; color: #8A8A8A; }
  .fn-row span.lt { background: var(--cs-accent-tint, #F0FDFA); color: var(--cs-accent-text, #115E59); box-shadow: inset 0 0 0 1px var(--cs-accent-border, #99F6E4); }
  figcaption { margin-top: var(--space-caption); font-size: 14px; color: #6E6E6E; }
  @media (max-width: 640px) { .fn-row span { width: 44px; height: 44px; font-size: 17px; } }
</style>
