---
/**
 * Centered signature footer: the live MW logo standing on a ground line (Seattle's real sun
 * and shadow; around it the pointer becomes the sun), a mailto line and contact links.
 */
import Container from './Container.astro';
import MWLogo from '@/components/ui/MWLogo.astro';
import { footerLinks, site } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="bg-white pt-24 pb-12">
  <Container class="flex flex-col items-center text-center">
    <MWLogo variant="live" label="Mengying Wang" class="relative z-[1]" />
    <span class="h-px w-full max-w-[720px] bg-[#e5e5e5]" aria-hidden="true"></span>

    <a
      href={`mailto:${site.email}`}
      class="mt-7 text-[22px] font-medium text-[#111] transition-colors duration-200 hover:text-[#555] mobile:py-2"
    >
      Let’s work together.<span class="sr-only"> (email)</span>
    </a>

    <nav aria-label="Contact" class="mt-5">
      <ul class="footer-links flex items-center gap-3.5 text-[13px] tracking-[0.08em] text-[#111] uppercase mobile:flex-wrap mobile:justify-center mobile:gap-x-7 mobile:gap-y-0">
        {
          footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="footer-link"
                target={link.newTab ? '_blank' : undefined}
                rel={link.newTab ? 'noopener noreferrer' : undefined}
              >
                <span class="footer-link-label">{link.label}</span>
                {link.newTab && <span class="footer-link-ext" aria-hidden="true"> ↗</span>}
                {link.newTab && <span class="sr-only"> (opens in a new tab)</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="mt-8 font-mono text-[11px] tracking-[0.04em] text-meta">
      No shadow was harmed in the making of this site<span class="mobile:hidden"> ·</span>{' '}<span class="mobile:block">© {year}</span>
    </p>
  </Container>
</footer>

<style>
  .footer-links li + li::before {
    content: '·' / '';
    margin-right: 14px;
  }
  /* Phones: the links may wrap, so they're spaced instead (no separator at the start of a line). */
  @media (width < 768px) {
    .footer-links li + li::before {
      content: none;
    }
  }

  /* Same On-style underline as the nav, at 1px. The line sits on the label only, so a ↗ is not covered. */
  .footer-link {
    text-decoration: none;
  }
  /* Phones: 44px tap targets. */
  @media (width < 768px) {
    .footer-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
  .footer-link:focus-visible {
    outline: 2px solid #111;
    outline-offset: 4px;
  }
  .footer-link-label {
    position: relative;
    display: inline-block;
  }
  .footer-link-label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(1em + 6px);
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .footer-link:hover .footer-link-label::after,
  .footer-link:focus-visible .footer-link-label::after {
    transform: scaleX(1);
    transform-origin: left;
  }
</style>
