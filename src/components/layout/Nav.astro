---
import Container from './Container.astro';
import MWLogo from '@/components/ui/MWLogo.astro';
import { navLinks } from '@/data/site';

interface Props {
  /** Transparent while the page's [data-hero] is in view, so a full-bleed hero shows through. */
  overlay?: boolean;
  /** Fade up on page load, as the first step of the hero entrance. */
  animateIn?: boolean;
}

const { overlay = false, animateIn = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

/** WORK is current on every /work/* case study; other links match the path exactly. */
const isCurrent = (href: string) => {
  if (href === '/#work' || href.startsWith('/work')) return currentPath.startsWith('/work');
  const path = href.replace(/\/$/, '') || '/';
  return path === currentPath;
};
---

<header class="nav text-glow sticky top-0 z-20" data-nav-overlay={overlay ? '' : undefined}>
  <Container as="nav" class:list={['flex h-20 items-center justify-between', animateIn && 'enter [--enter:0]']}>
    <a href="/" class="flex items-center" aria-label="Mengying Wang — Home">
      <MWLogo variant="mark" theme="light" />
    </a>
    <ul class="flex items-center gap-14 text-xs font-medium tracking-wider uppercase">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link"
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              target={link.newTab ? '_blank' : undefined}
              rel={link.newTab ? 'noopener noreferrer' : undefined}
            >
              <span class="nav-link-label">{link.label}</span>
              {link.newTab && (
                <>
                  {' '}
                  <span class="nav-link-ext text-[0.85em]" aria-hidden="true">
                    ↗
                  </span>
                  <span class="sr-only"> (opens in a new tab)</span>
                </>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</header>

<style>
  /* Frosted, never solid. The hairline is an inset shadow so it doesn't add height. */
  .nav {
    background-color: rgb(255 255 255 / 0.72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: inset 0 -1px 0 rgb(0 0 0 / 0.05);
    transition:
      background-color 300ms ease,
      backdrop-filter 300ms ease,
      -webkit-backdrop-filter 300ms ease,
      box-shadow 300ms ease;
  }

  .nav[data-nav-overlay]:not([data-scrolled]) {
    background-color: rgb(255 255 255 / 0);
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    box-shadow: inset 0 -1px 0 rgb(0 0 0 / 0);
  }

  /* On-style underline: draws in from the left, retracts to the right. The line sits on the
     label only, so the ↗ on RESUME is not covered. */
  .nav-link {
    text-decoration: none;
  }
  .nav-link:focus-visible {
    outline: 2px solid #111;
    outline-offset: 4px;
  }
  .nav-link-label {
    position: relative;
    display: inline-block;
  }
  .nav-link-label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(1em + 6px);
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .nav-link:hover .nav-link-label::after,
  .nav-link:focus-visible .nav-link-label::after,
  .nav-link[aria-current='page'] .nav-link-label::after {
    transform: scaleX(1);
    transform-origin: left;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav-overlay]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (header && hero) {
    // Frosted only once the whole hero has passed under the nav.
    new IntersectionObserver(
      ([entry]) => header.toggleAttribute('data-scrolled', !entry.isIntersecting),
      { rootMargin: `-${header.offsetHeight}px 0px 0px 0px` },
    ).observe(hero);
  } else if (header) {
    header.setAttribute('data-scrolled', '');
  }
</script>
