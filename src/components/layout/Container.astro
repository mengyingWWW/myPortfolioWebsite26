---
interface Props {
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav' | 'article';
  class?: string;
  id?: string;
}

const { as: Tag = 'div', class: className, id } = Astro.props;
---

<Tag id={id} class:list={['mx-auto w-full max-w-site px-[clamp(20px,4vw,40px)]', className]}>
  <slot />
</Tag>
