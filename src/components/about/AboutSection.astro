---
/** An About section: sticky mono name on the left, content on the right. */
interface Props {
  id: string;
  label: string;
}

const { id, label } = Astro.props;
---

<section id={id} class="grid scroll-mt-20 grid-cols-[22%_78%] mobile:grid-cols-1">
  <!-- 40px below the sticky nav (h-20). Phones: the label sits above the content.
       Fade only: a transform here would make the sticky label jump. It reveals with the section's first row. -->
  <h2
    data-reveal-item="fade"
    style="--i:0"
    class="sticky top-[calc(5rem+40px)] self-start pr-6 font-mono text-[13px] leading-[1.5] text-meta mobile:static mobile:mb-5 mobile:pr-0"
  >
    {label}
  </h2>
  <div class="max-w-[760px]">
    <slot />
  </div>
</section>
