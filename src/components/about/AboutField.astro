---
/** Mono label over a value. A term/description pair: place inside a <dl>. */
interface Props {
  label: string;
  value: string;
  /** Stagger index when this row fades in inside a reveal group. */
  revealIndex?: number;
}

const { label, value, revealIndex } = Astro.props;
---

<div data-reveal-item={revealIndex !== undefined ? '' : undefined} style={revealIndex !== undefined ? `--i:${revealIndex}` : undefined}>
  <dt class="font-mono text-[13px] leading-[1.5] text-meta">{label}</dt>
  <dd class="mt-1 text-[17px] leading-[1.55] font-normal text-[#2a2a2a]">{value}</dd>
</div>
