---
/**
 * Hand-drawn sundial as a tap-through story. A jittered ink sketch of each place (src/data/citySketches.ts)
 * stands on a hand-drawn ground line; its strokes cast a hatched shadow from that place's own light moment
 * (latitude + time of day on the equinox arc).
 * - Story bar above the scene: one segment per city, with its name. Buttons; arrow keys move between them.
 * - Tapping the right half of the scene goes to the next city, the left half to the previous one (wrapping);
 *   hand-drawn ‹ › buttons beside the scene do the same. The › nudges once as a hint when the story ends.
 * - A hand-drawn ink dot is part of each picture: a stopped clock, a bicycle's front hub, a coconut, a crow. On a
 *   city change it hops to its place in the new picture, along an arc, with a small squash as it lands.
 * - Once it lands, the dot's parts fade in (the clock's white hands; the crow's head, beak, tail and legs, whose
 *   head tilts once), and fade out before the next hop.
 * - The sun (an outline) moves every time: it sweeps the city's own window of the day over ~4s while the shadow
 *   follows, then breathes (a slow ±0.1h drift).
 * Ported from about-sketch-sundial-v7.html.
 * - Auto-play once per session (sessionStorage "tourSeen"): when the dot is first shown, ~5.4s per city
 *   while its segment fills; it stops at Seattle or on any input.
 * - awaitLanding: the dot stays hidden (and the sun and auto-play wait) until the page sets data-landed, i.e.
 *   the portrait has flown into it.
 * Reduced motion: no auto-play, sweep, drift, hop or draw-in; the dot and the sun jump.
 */
import { sundial } from '@/data/about';
import { cityDotParts, cityDots, citySketches } from '@/data/citySketches';

interface Props {
  class?: string;
  awaitLanding?: boolean;
}

const { class: className, awaitLanding = false } = Astro.props;
const { stops } = sundial;
const latLine = (stop: (typeof stops)[number]) => `${stop.latitude.toFixed(1)}°N`;
const clientStops = stops.map((stop) => ({
  place: stop.place,
  latitude: stop.latitude,
  hours: stop.hours,
  latLine: latLine(stop),
  caption: stop.caption,
  strokes: citySketches[stop.key],
  dot: cityDots[stop.key],
  parts: cityDotParts[stop.key] ?? '',
  sceneLabel: stop.sceneLabel,
}));
---

<div
  class:list={['sks', className]}
  data-sundial
  data-stops={JSON.stringify(clientStops)}
  data-await-landing={awaitLanding ? '' : undefined}
>
  <nav class="sks-story" aria-label={sundial.storyLabel} data-story>
    {
      stops.map((stop, i) => (
        <button
          type="button"
          class="sks-story-btn tap-target"
          aria-current={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-city={i}
        >
          <span class="sks-story-track" aria-hidden="true">
            <span class="sks-story-fill" style={i === 0 ? '--fill: 100%' : undefined} data-seg-fill />
          </span>
          <span class="sks-story-name">{stop.place}</span>
        </button>
      ))
    }
  </nav>

  <!-- Pointer only: the story bar is the keyboard route. -->
  <div class="sks-stage" data-cursor-label="NEXT →" data-scene>
    <svg class="sks-svg" viewBox="0 0 720 300" role="img" aria-label={stops[0].sceneLabel} data-svg>
      <defs>
        <filter id="sks-ink" x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence type="fractalNoise" baseFrequency="1.1" numOctaves="2" seed="4" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="1.4" />
        </filter>
        <pattern id="sks-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(-38)">
          <line x1="0" y1="0" x2="0" y2="5" stroke="#2A2A2A" stroke-width="1.2" />
        </pattern>
        <filter id="sks-hatch-ink" x="-5%" y="-20%" width="110%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="2" seed="9" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="2.2" />
        </filter>
      </defs>
      <g class="sks-shadow" filter="url(#sks-hatch-ink)" data-shadow></g>
      <g filter="url(#sks-ink)" data-art></g>
      <g filter="url(#sks-ink)" data-ground></g>
      <g class="sks-sun" data-sun>
        <circle r="20" fill="none" stroke="#EDEDED" stroke-width="1" data-halo2></circle>
        <circle r="13" fill="none" stroke="#DADADA" stroke-width="1" data-halo></circle>
        <circle r="8" fill="#fff" stroke="#111" stroke-width="1.4"></circle>
      </g>
      <!-- The ink dot, part of each picture; the portrait flies into it. Its blob and outline are drawn by the script. -->
      <g class="sks-dot" filter="url(#sks-ink)" data-dot-g>
        <g data-dot></g>
        <g class="sks-dot-parts" opacity="0" data-dot-parts></g>
      </g>
    </svg>
    <button type="button" class="sks-nav prev" aria-label="Previous place" data-cursor-label="← PREV" data-nav="-1">
      <svg class="sks-chevron" width="14" height="28" viewBox="0 0 14 28" aria-hidden="true"><g filter="url(#sks-ink)" data-chevron="-1"></g></svg>
    </button>
    <button type="button" class="sks-nav next" aria-label="Next place" data-cursor-label="NEXT →" data-nav="1">
      <svg class="sks-chevron" width="14" height="28" viewBox="0 0 14 28" aria-hidden="true"><g filter="url(#sks-ink)" data-chevron="1"></g></svg>
    </button>
  </div>

  <!-- Every caption sits invisibly in the same cell, so the box always has the longest one's height. -->
  <div class="sks-captions">
    {
      clientStops.map((stop) => (
        <div class="sks-caption-ghost" aria-hidden="true">
          <p class="sks-caption">{stop.caption}</p>
          <p class="sks-latline">{stop.latLine}</p>
        </div>
      ))
    }
    <div class="sks-caption-cell" aria-live="polite" data-caption-cell>
      <p class="sks-caption" data-caption>{clientStops[0].caption}</p>
      <p class="sks-latline" data-latline>{clientStops[0].latLine}</p>
    </div>
  </div>
</div>

<style>
  .sks {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Story bar: segments with tiny labels, like stories. */
  .sks-story {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    width: min(100%, 520px);
  }
  .sks-story-btn {
    padding: 10px 0 0;
    text-align: left;
    cursor: pointer;
  }
  .sks-story-btn:focus-visible {
    outline: 2px solid #111;
    outline-offset: 3px;
    border-radius: 2px;
  }
  .sks-story-track {
    display: block;
    height: 2px;
    overflow: hidden;
    border-radius: 2px;
    background: #e6e6e6;
  }
  .sks-story-fill {
    display: block;
    width: var(--fill, 0%);
    height: 100%;
    background: #111;
  }
  /* #767676 is the lightest grey that keeps 4.5:1 on white. */
  .sks-story-name {
    display: block;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #767676;
    transition: color 200ms ease;
  }
  .sks-story-btn[aria-current='true'] .sks-story-name,
  .sks-story-btn:hover .sks-story-name {
    color: #111;
  }

  /* Leaves room on each side for the ‹ › (53px), which sit outside the drawing. */
  .sks-stage {
    position: relative;
    width: min(100% - 106px, var(--sundial-max-width, 760px));
    margin-top: 40px;
    cursor: pointer;
  }

  /* ‹ › beside the scene: 44px hit areas, each chevron 24px outside the drawing's edge. */
  .sks-nav {
    position: absolute;
    top: 50%;
    width: 44px;
    height: 44px;
    margin-top: -22px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #bdbdbd;
    cursor: pointer;
    transition: color 150ms ease;
  }
  .sks-nav.prev {
    left: calc(-24px - 7px - 22px);
  }
  .sks-nav.next {
    right: calc(-24px - 7px - 22px);
  }
  .sks-chevron {
    display: block;
    overflow: visible;
    transition: transform 150ms ease;
  }
  .sks-nav:is(:hover, :focus-visible),
  .sks[data-hover-side='prev'] .sks-nav.prev,
  .sks[data-hover-side='next'] .sks-nav.next {
    color: #111;
  }
  .sks-nav.prev:is(:hover, :focus-visible) .sks-chevron {
    transform: translateX(-3px);
  }
  .sks-nav.next:is(:hover, :focus-visible) .sks-chevron {
    transform: translateX(3px);
  }
  .sks-nav:focus-visible {
    outline: 2px solid #111;
    outline-offset: 4px;
  }
  /* Narrow windows: below the scene, at its two ends, instead of over the drawing. */
  @media (max-width: 600px) {
    .sks-stage {
      width: min(100%, var(--sundial-max-width, 760px));
      padding-bottom: 48px;
    }
    .sks-nav {
      top: auto;
      bottom: 0;
      margin-top: 0;
    }
    .sks-nav.prev {
      left: -15px;
    }
    .sks-nav.next {
      right: -15px;
    }
  }

  .sks-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    user-select: none;
  }

  .sks-shadow {
    transition: opacity 0.4s ease;
  }

  .sks-dot-parts {
    transition: opacity 0.35s;
  }

  /* Until the portrait has flown into it, the dot isn't there. */
  @media (prefers-reduced-motion: no-preference) {
    .sks[data-await-landing]:not([data-landed]) .sks-dot {
      visibility: hidden;
    }
  }

  .sks :global(.sks-draw) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: sks-draw 1.2s cubic-bezier(0.4, 0.1, 0.2, 1) forwards;
  }
  @keyframes sks-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .sks-captions {
    display: grid;
    width: 100%;
    max-width: 600px;
    margin-top: 22px;
    text-align: center;
  }
  .sks-caption-ghost,
  .sks-caption-cell {
    grid-area: 1 / 1;
  }
  .sks-caption-ghost {
    visibility: hidden;
  }
  .sks-caption {
    font-family: var(--font-serif);
    font-size: 17px;
    font-style: italic;
    line-height: 1.5;
    text-wrap: balance;
    color: #555;
  }
  .sks-latline {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-meta);
  }

  .sks-caption-cell {
    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
  }
  .sks-caption-cell[data-swapping] {
    opacity: 0;
    transform: translateY(6px);
  }

  @media (prefers-reduced-motion: reduce) {
    .sks-nav .sks-chevron {
      transform: none !important;
    }
    .sks-shadow,
    .sks-dot-parts,
    .sks-nav,
    .sks-chevron,
    .sks-story-name,
    .sks-caption-cell {
      transition: none;
    }
    .sks :global(.sks-draw) {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  type Stroke = { d: string; weight?: 'thin' | 'light'; noShadow?: boolean };
  type Stop = { place: string; latitude: number; hours: [number, number]; latLine: string; caption: string; strokes: Stroke[]; dot: [number, number]; parts: string; sceneLabel: string };
  type Pt = [number, number];

  const NS = 'http://www.w3.org/2000/svg';
  /** Scene (viewBox 720 × 300): the ground line, and where the 200 × 140 sketch space lands (centre, scale). */
  const G = 214;
  const CX = 360;
  const SC = 1.25;
  const toScene = (x: number, y: number): Pt => [CX + (x - 100) * SC, G + (y - 118) * SC];
  const GROUND = 'M30 214 C200 212 360 216 520 213 C600 212 660 215 690 214';
  /** The day arc runs from 06:00 at XL to 18:00 at XR. */
  const XL = 70;
  const XR = 650;
  /** The dot's hop to a new picture: duration, arc height (at least HOP_MIN, or a share of the distance), squash. */
  const HOP_MS = 1100;
  const HOP_MIN = 50;
  const HOP_RATIO = 0.35;
  const SQUASH = 0.18;
  /** After landing, the crow cocks its head once: this far, over this long, after this pause. */
  const NOD_DEG = -14;
  const NOD_MS = 650;
  const NOD_DELAY = 500;
  /** Then the sun sweeps the city's window of the day, and afterwards breathes: ± this many hours, on a slow sine. */
  const SWEEP_MS = 4000;
  const DRIFT_HOURS = 0.1;
  const DRIFT_RATE = 1 / 1600;
  const STOP_MS = 5400;
  /** Caption fades out for this long before the text changes. */
  const CAPTION_SWAP = 220;
  /** A tap nudges the scene this far toward the tapped side and back. */
  const NUDGE_PX = 6;
  const NUDGE_MS = 180;
  /** The one-time hint on the › arrow: out and back twice. */
  const HINT_PX = 6;
  const HINT_MS = 900;
  const TOUR_KEY = 'tourSeen';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const remembered = (key: string) => {
    try {
      return sessionStorage.getItem(key) === '1';
    } catch {
      return false;
    }
  };
  const remember = (key: string) => {
    try {
      sessionStorage.setItem(key, '1');
    } catch {
      // Storage blocked: the story just plays again next time.
    }
  };
  const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2);
  const easeInOutQuad = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);

  /** Seeded, so a city's sketch has the same wobble every time it's drawn. */
  function rng(seed: number) {
    let s = seed;
    return () => (s = (s * 16807) % 2147483647) / 2147483647;
  }

  document.querySelectorAll<HTMLElement>('[data-sundial]').forEach((root) => {
    const stops: Stop[] = JSON.parse(root.dataset.stops ?? '[]');
    if (!stops.length) return;
    const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const svg = q<SVGSVGElement>('[data-svg]');
    const stage = q<HTMLElement>('[data-scene]');
    const shadow = q<SVGGElement>('[data-shadow]');
    const art = q<SVGGElement>('[data-art]');
    const ground = q<SVGGElement>('[data-ground]');
    const sun = q<SVGGElement>('[data-sun]');
    const halo = q<SVGCircleElement>('[data-halo]');
    const halo2 = q<SVGCircleElement>('[data-halo2]');
    const dotG = q<SVGGElement>('[data-dot-g]');
    const dotShape = q<SVGGElement>('[data-dot]');
    const dotParts = q<SVGGElement>('[data-dot-parts]');
    const captionCell = q<HTMLElement>('[data-caption-cell]');
    const caption = q<HTMLElement>('[data-caption]');
    const latline = q<HTMLElement>('[data-latline]');
    const story = q<HTMLElement>('[data-story]');
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-city]')];
    const fills = buttons.map((b) => b.querySelector<HTMLElement>('[data-seg-fill]')!);

    // ---------- hand-line renderer: a jittered double stroke ----------
    /** A path's outline as runs of points (split where it jumps), mapped through tf. */
    function samplePath(d: string, tf?: (x: number, y: number) => Pt): Pt[][] {
      const p = document.createElementNS(NS, 'path');
      p.setAttribute('d', d);
      svg.appendChild(p);
      const length = p.getTotalLength();
      const runs: Pt[][] = [];
      let run: Pt[] = [];
      let prev: Pt | null = null;
      for (let t = 0; t <= length; t += 1.2) {
        const q = p.getPointAtLength(t);
        const pt: Pt = tf ? tf(q.x, q.y) : [q.x, q.y];
        if (prev && Math.hypot(pt[0] - prev[0], pt[1] - prev[1]) > 6) {
          if (run.length > 1) runs.push(run);
          run = [];
        }
        run.push(pt);
        prev = pt;
      }
      if (run.length > 1) runs.push(run);
      p.remove();
      return runs;
    }

    function handLine(runs: Pt[][], opt: { col: string; w: number; anim: boolean }, R: () => number, delay: number) {
      const out: SVGPathElement[] = [];
      for (let pass = 0; pass < 2; pass++) {
        const ph1 = R() * 6.28;
        const ph2 = R() * 6.28;
        const amp = pass ? 0.9 : 0.55;
        const f = 0.03 + R() * 0.03;
        let d = '';
        for (const s of runs) {
          let acc = 0;
          s.forEach((q, i) => {
            const n = s[Math.min(s.length - 1, i + 1)];
            const pv = s[Math.max(0, i - 1)];
            let nx = -(n[1] - pv[1]);
            let ny = n[0] - pv[0];
            const l = Math.hypot(nx, ny) || 1;
            nx /= l;
            ny /= l;
            if (i) acc += Math.hypot(q[0] - s[i - 1][0], q[1] - s[i - 1][1]);
            const o = amp * (Math.sin(acc * f * 6.28 + ph1) * 0.7 + Math.sin(acc * f * 2.3 * 6.28 + ph2) * 0.3) + (pass ? 0.5 : 0);
            d += `${i ? 'L' : 'M'}${(q[0] + nx * o).toFixed(1)} ${(q[1] + ny * o).toFixed(1)} `;
          });
        }
        const e = document.createElementNS(NS, 'path');
        e.setAttribute('d', d);
        e.setAttribute('fill', 'none');
        e.setAttribute('stroke', opt.col);
        e.setAttribute('stroke-width', String(pass ? opt.w * 0.55 : opt.w));
        e.setAttribute('stroke-linecap', 'round');
        e.setAttribute('stroke-linejoin', 'round');
        e.setAttribute('opacity', pass ? '0.45' : '0.92');
        if (opt.anim) {
          e.setAttribute('pathLength', '1');
          e.classList.add('sks-draw');
          e.style.animationDelay = `${delay + pass * 0.2}s`;
        }
        out.push(e);
      }
      return out;
    }

    // ---------- state ----------
    let cur = 0;
    let lat = stops[0].latitude;
    let hour = stops[0].hours[0];
    let drift = 0;
    /** The dot, in scene units. */
    let dot: Pt = toScene(...stops[0].dot);
    let casters: Pt[][] = [];
    let flight = 0;
    let swapTimer = 0;
    let inView = true;
    /** Share of the sundial on screen; below 0.9 during the story means the visitor is scrolling on. */
    let visible = 1;
    let hinted = false;

    const awaitLanding = root.hasAttribute('data-await-landing') && !reduceMotion;
    const landed = () => !awaitLanding || root.hasAttribute('data-landed');

    // ---------- sun & shadow (equinox day, local solar time) ----------
    const sunAlt = (h: number) => {
      const H = ((h - 12) * 15 * Math.PI) / 180;
      const p = (lat * Math.PI) / 180;
      return (Math.asin(Math.cos(p) * Math.cos(H)) * 180) / Math.PI;
    };
    const sunXY = (h: number): Pt => [XL + ((h - 6) / 12) * (XR - XL), G - (Math.max(sunAlt(h), -4) / 90) * 200 - 8];

    function update() {
      const h = hour + drift;
      const [sx, sy] = sunXY(h);
      const alt = sunAlt(h);
      sun.setAttribute('transform', `translate(${sx.toFixed(1)} ${sy.toFixed(1)})`);
      dotG.setAttribute('transform', `translate(${dot[0].toFixed(1)} ${dot[1].toFixed(1)})`);
      // Halos widen as the sun sinks and tighten at midday.
      const low = 1 - Math.min(1, Math.max(0, alt) / 60);
      halo.setAttribute('r', (10 + low * 6).toFixed(1));
      halo2.setAttribute('r', (16 + low * 14).toFixed(1));
      halo2.setAttribute('opacity', (0.35 + low * 0.65).toFixed(2));

      // Every caster point is projected away from the sun onto a slightly tilted ground plane.
      shadow.replaceChildren();
      if (alt > 1.5 && casters.length) {
        const k = Math.min(4.2, 1 / Math.tan((alt * Math.PI) / 180));
        const dir = h < 12 ? 1 : -1;
        const horiz = Math.abs(Math.sin(((h - 12) / 6) * (Math.PI / 2)));
        let dd = '';
        for (const s of casters) {
          s.forEach(([x, y], i) => {
            const hh = Math.max(0, G - y);
            const px = x + dir * hh * k * (0.35 + 0.65 * horiz);
            const py = G + hh * Math.min(k, 2.2) * 0.42 * (1 - horiz * 0.45) + 1.5;
            dd += `${i ? 'L' : 'M'}${px.toFixed(1)} ${py.toFixed(1)} `;
          });
          dd += 'Z ';
        }
        const e = document.createElementNS(NS, 'path');
        e.setAttribute('d', dd);
        e.setAttribute('fill', 'url(#sks-hatch)');
        e.setAttribute('stroke', 'url(#sks-hatch)');
        e.setAttribute('stroke-width', '3');
        shadow.appendChild(e);
        shadow.style.opacity = (0.45 + 0.35 * Math.min(1, alt / 30)).toFixed(2);
      }
    }

    // ---------- the sun's sweep through the city's window, then breathing ----------
    const sweep = { on: false, elapsed: 0, last: 0 };
    function startSweep() {
      if (reduceMotion) return;
      sweep.on = true;
      sweep.elapsed = 0;
      sweep.last = 0;
    }

    /** The dot hops to its place in the new picture; meanwhile the sun moves to the start of that city's window. */
    function travel(to: Stop) {
      cancelAnimationFrame(flight);
      flight = 0;
      sweep.on = false;
      drift = 0;
      const target = toScene(...to.dot);
      dotParts.setAttribute('opacity', '0');
      if (reduceMotion) {
        lat = to.latitude;
        hour = to.hours[0];
        dot = target;
        showParts(to);
        return update();
      }
      const from = { lat, hour, dot: [...dot] as Pt };
      const lift = Math.max(HOP_MIN, Math.abs(target[0] - from.dot[0]) * HOP_RATIO);
      let t0 = 0;
      const step = (now: number) => {
        t0 ||= now;
        const t = Math.min(1, (now - t0) / HOP_MS);
        const e = easeInOutCubic(t);
        dot = [from.dot[0] + (target[0] - from.dot[0]) * e, from.dot[1] + (target[1] - from.dot[1]) * e - Math.sin(Math.PI * e) * lift];
        // A small squash as it lands.
        const sq = t > 0.85 && t < 1 ? 1 - SQUASH * Math.sin(((t - 0.85) / 0.15) * Math.PI) : 1;
        dotShape.setAttribute('transform', `scale(${(2 - sq).toFixed(3)} ${sq.toFixed(3)})`);
        lat = from.lat + (to.latitude - from.lat) * e;
        hour = from.hour + (to.hours[0] - from.hour) * e;
        if (t < 1) flight = requestAnimationFrame(step);
        else {
          flight = 0;
          showParts(to);
          startSweep();
        }
      };
      flight = requestAnimationFrame(step);
    }

    /** The dot's parts for this city fade in; a `data-nod` part (the crow's head) tilts once. */
    function showParts(stop: Stop) {
      dotParts.innerHTML = stop.parts;
      dotParts.setAttribute('opacity', '1');
      const head = dotParts.querySelector<SVGGElement>('[data-nod]');
      if (!head || reduceMotion) return;
      head.style.transformBox = 'view-box';
      head.style.transformOrigin = '3px -2px';
      head.animate([{ transform: 'rotate(0deg)' }, { transform: `rotate(${NOD_DEG}deg)` }, { transform: 'rotate(0deg)' }], {
        duration: NOD_MS,
        delay: NOD_DELAY,
        easing: 'ease-in-out',
      });
    }

    // ---------- city ----------
    function drawSketch(i: number, animate: boolean) {
      art.replaceChildren();
      const R = rng(i * 97 + 5);
      casters = [];
      stops[i].strokes.forEach((stroke, j) => {
        const runs = samplePath(stroke.d, toScene);
        const light = stroke.weight === 'light';
        const w = light ? 1 : stroke.weight === 'thin' ? 1.15 : 1.8;
        art.append(...handLine(runs, { col: light ? '#8E8E8E' : '#151515', w, anim: animate }, R, j * 0.07));
        if (!stroke.noShadow) casters.push(...runs);
      });
    }

    /** Cities before i are done, city i is `fill` (0–1) of the way through, later ones are empty. */
    function setProgress(i: number, fill: number) {
      fills.forEach((f, j) => f.style.setProperty('--fill', `${j < i ? 100 : j === i ? fill * 100 : 0}%`));
    }

    function swapCaption(stop: Stop, instant: boolean) {
      window.clearTimeout(swapTimer);
      const apply = () => {
        caption.textContent = stop.caption;
        latline.textContent = stop.latLine;
        captionCell.removeAttribute('data-swapping');
      };
      if (instant) return apply();
      captionCell.setAttribute('data-swapping', '');
      swapTimer = window.setTimeout(apply, CAPTION_SWAP);
    }

    /** init: first paint, no animation. auto: the story playing. user: a tap, a segment or an arrow key. */
    function select(i: number, source: 'init' | 'auto' | 'user', nudge = 0) {
      i = (i + stops.length) % stops.length;
      if (source === 'user' && i === cur && !nudge) return;
      const same = i === cur;
      cur = i;
      const stop = stops[i];
      const instant = source === 'init' || reduceMotion;
      drawSketch(i, !instant);
      svg.setAttribute('aria-label', stop.sceneLabel);
      if (source === 'init') {
        lat = stop.latitude;
        hour = stop.hours[0];
        dot = toScene(...stop.dot);
        showParts(stop);
      } else if (same) startSweep();
      else travel(stop);
      buttons.forEach((b, j) => {
        b.setAttribute('aria-current', String(j === i));
        b.tabIndex = j === i ? 0 : -1;
      });
      setProgress(i, source === 'auto' ? 0 : 1);
      swapCaption(stop, instant);
      if (nudge && !reduceMotion)
        stage.animate(
          [{ transform: 'translateX(0)' }, { transform: `translateX(${NUDGE_PX * nudge}px)` }, { transform: 'translateX(0)' }],
          { duration: NUDGE_MS, easing: 'ease-out' },
        );
      update();
    }

    // ---------- auto-play (once per session) ----------
    const auto = { on: false, elapsed: 0, last: 0 };

    function startAuto() {
      auto.on = true;
      auto.elapsed = 0;
      auto.last = 0;
      remember(TOUR_KEY);
      root.setAttribute('data-touring', '');
      // The story's own changes aren't announced; the visitor's are.
      captionCell.setAttribute('aria-live', 'off');
      select(0, 'auto');
    }

    function stopAuto() {
      if (!auto.on) return;
      auto.on = false;
      root.removeAttribute('data-touring');
      captionCell.setAttribute('aria-live', 'polite');
      setProgress(cur, 1);
    }

    // ---------- the loop: breathing light + story progress, only while on screen ----------
    let frame = 0;
    function loop(now: number) {
      frame = 0;
      if (sweep.on) {
        const dt = sweep.last ? Math.min(now - sweep.last, 100) : 0;
        sweep.last = now;
        // Holds while the portrait is back in Act 1.
        if (landed()) sweep.elapsed += dt;
        const t = Math.min(1, sweep.elapsed / SWEEP_MS);
        const [from, to] = stops[cur].hours;
        hour = from + (to - from) * easeInOutQuad(t);
        drift = t >= 1 ? Math.sin(now * DRIFT_RATE) * DRIFT_HOURS : 0;
      }
      if (auto.on) {
        const dt = auto.last ? Math.min(now - auto.last, 100) : 0;
        auto.last = now;
        // Holds while the portrait is back in Act 1.
        if (landed()) auto.elapsed += dt;
        const t = Math.min(1, auto.elapsed / STOP_MS);
        setProgress(cur, t);
        if (t >= 1) {
          if (cur < stops.length - 1) {
            if (cur === 0 && visible < 0.9) hintArrow();
            auto.elapsed = 0;
            select(cur + 1, 'auto');
          } else {
            stopAuto();
            hintArrow();
          }
        }
      }
      update();
      if (inView && (!reduceMotion || auto.on || flight)) frame = requestAnimationFrame(loop);
    }
    const run = () => {
      if (!frame) frame = requestAnimationFrame(loop);
    };

    // ---------- input ----------
    buttons.forEach((b, i) =>
      b.addEventListener('click', () => {
        stopAuto();
        select(i, 'user');
      }),
    );
    story.addEventListener('keydown', (e) => {
      const to =
        e.key === 'ArrowRight' ? cur + 1 : e.key === 'ArrowLeft' ? cur - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? stops.length - 1 : null;
      if (to === null) return;
      e.preventDefault();
      stopAuto();
      select(to, 'user');
      buttons[cur].focus();
    });

    // ‹ › buttons: the same as tapping that half of the scene.
    const navs = [...root.querySelectorAll<HTMLButtonElement>('[data-nav]')];
    navs.forEach((nav) => {
      const step = Number(nav.dataset.nav);
      const chevron = nav.querySelector<SVGGElement>('[data-chevron]')!;
      const d = step > 0 ? 'M2 2 L12 14 L2 26' : 'M12 2 L2 14 L12 26';
      chevron.append(...handLine(samplePath(d), { col: 'currentColor', w: 1.4, anim: false }, rng(step > 0 ? 61 : 67), 0));
      nav.addEventListener('click', (e) => {
        e.stopPropagation();
        stopAuto();
        select(cur + step, 'user', step);
      });
    });
    /** Once: the › arrow nudges outward and back twice, then stays still. */
    function hintArrow() {
      if (hinted || reduceMotion) return;
      hinted = true;
      const x = `translateX(${HINT_PX}px)`;
      root.querySelector('.sks-nav.next .sks-chevron')?.animate(
        [{ transform: 'none' }, { transform: x }, { transform: 'none' }, { transform: x }, { transform: 'none' }],
        { duration: HINT_MS, easing: 'ease-in-out' },
      );
    }

    // Story taps: right half → next city, left half → previous.
    const sideOf = (e: MouseEvent) => {
      const r = stage.getBoundingClientRect();
      return e.clientX >= r.left + r.width / 2 ? 1 : -1;
    };
    stage.addEventListener('click', (e) => {
      const step = sideOf(e);
      stopAuto();
      select(cur + step, 'user', step);
    });
    stage.addEventListener('pointermove', (e) => {
      const side = sideOf(e) > 0 ? 'next' : 'prev';
      const label = side === 'next' ? 'NEXT →' : '← PREV';
      if (stage.dataset.cursorLabel !== label) stage.dataset.cursorLabel = label;
      // The arrow on that side darkens too, so it agrees with the cursor.
      if (root.dataset.hoverSide !== side) root.dataset.hoverSide = side;
    });
    stage.addEventListener('pointerleave', () => delete root.dataset.hoverSide);

    // ---------- landing (the portrait has flown into the dot) ----------
    function onLanding() {
      if (!landed() || auto.on || reduceMotion) return;
      if (!remembered(TOUR_KEY)) startAuto();
      else if (!sweep.on && !flight) startSweep();
      run();
    }

    ground.append(...handLine(samplePath(GROUND), { col: '#151515', w: 1.6, anim: false }, rng(31), 0));
    // The ink dot: a wobbly filled blob and a loose scribbled outline, in the sketch's ink (scene units).
    {
      const R = rng(404);
      let blob = '';
      for (let k = 0; k <= 22; k++) {
        const a = (k / 22) * Math.PI * 2;
        const r = 4.6 * (1 + (R() - 0.5) * 0.16);
        blob += `${k ? 'L' : 'M'}${(Math.cos(a) * r).toFixed(2)} ${(Math.sin(a) * r * 0.94).toFixed(2)} `;
      }
      let ring = '';
      for (let k = 0; k <= 30; k++) {
        const a = (k / 30) * Math.PI * 2.15 + 0.4;
        const r = 5.1 + (R() - 0.5) * 0.7;
        ring += `${k ? 'L' : 'M'}${(Math.cos(a) * r).toFixed(2)} ${(Math.sin(a) * r * 0.95).toFixed(2)} `;
      }
      const fill = document.createElementNS(NS, 'path');
      fill.setAttribute('d', `${blob}Z`);
      fill.setAttribute('fill', '#1A1A1A');
      fill.setAttribute('opacity', '0.92');
      const outline = document.createElementNS(NS, 'path');
      outline.setAttribute('d', ring);
      outline.setAttribute('fill', 'none');
      outline.setAttribute('stroke', '#151515');
      outline.setAttribute('stroke-width', '1.1');
      outline.setAttribute('stroke-linecap', 'round');
      outline.setAttribute('opacity', '0.85');
      dotShape.prepend(fill, outline);
    }
    select(0, 'init');
    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        visible = entry.intersectionRatio;
        if (inView) run();
      },
      { threshold: [0, 0.9] },
    ).observe(root);
    new MutationObserver(onLanding).observe(root, { attributes: true, attributeFilter: ['data-landed'] });
    onLanding();
  });
</script>
