---
/**
 * Fixed sun-path indicator at the bottom of the viewport for the About page's sections, drawn
 * as a small solar study: a gnomon on the ground, the sun on its path, the ray and cast shadow.
 * The sun rises when the first section starts, peaks around the middle one and sets at the
 * end of the last. Shows the current section's name; clicking goes to the next section
 * (or back to the top after the last).
 */
import { SUN_PATH, sunPathGeometry } from '@/lib/sunPath';

interface Props {
  sections: { id: string; label: string }[];
}

const { sections } = Astro.props;

const { ground: G, cx, rx, ry, gnomonHeight } = SUN_PATH;
const SHADOW_H = 3.6;
const geo = sunPathGeometry(0);
---

<div class="section-progress" data-section-progress>
  <div class="section-progress-fade" aria-hidden="true"></div>
  <button
    type="button"
    class="section-progress-button"
    aria-label={`Next section: ${sections[1]?.label ?? 'top'}`}
    data-section-progress-button
  >
    <svg width="200" height="70" viewBox="0 0 200 70" class="block overflow-visible" aria-hidden="true">
      <path
        d={`M ${cx - rx} ${G} A ${rx} ${ry} 0 0 1 ${cx + rx} ${G}`}
        fill="none"
        stroke="#cfcfcf"
        stroke-width="0.8"
        stroke-dasharray="2 3"
      />
      <!-- A plain rect, not blurred: filters make zero-height elements disappear. -->
      <rect
        x={geo.shadow.x}
        y={G - SHADOW_H / 2}
        width={geo.shadow.width}
        height={SHADOW_H}
        rx={SHADOW_H / 2}
        fill="rgba(0,0,0,0.26)"
        data-section-progress-shadow
      />
      <line x1="18" y1={G} x2="182" y2={G} stroke="#111" stroke-width="0.8" />
      <line
        x1={geo.ray.x1}
        y1={geo.ray.y1}
        x2={geo.ray.x2}
        y2={geo.ray.y2}
        stroke="#111"
        stroke-width="0.5"
        stroke-dasharray="1.5 2.5"
        opacity="0.55"
        data-section-progress-ray
      />
      <line x1={cx} y1={G} x2={cx} y2={G - gnomonHeight} stroke="#111" stroke-width="1.2" />
      <circle cx={geo.sun.x} cy={geo.sun.y} r="4.2" fill="#111" data-section-progress-sun />
    </svg>
    <span class="section-progress-labels" aria-hidden="true">
      {
        sections.map((section, i) => (
          <span class="section-progress-label" data-section-progress-label={section.id} data-active={i ? undefined : ''}>
            {section.label}
          </span>
        ))
      }
    </span>
  </button>
</div>

<style>
  .section-progress {
    position: fixed;
    inset: auto 0 0;
    z-index: 15;
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 300ms ease,
      visibility 0s linear 300ms;
  }
  .section-progress[data-visible] {
    visibility: visible;
    opacity: 1;
    transition: opacity 300ms ease;
  }

  .section-progress-fade {
    position: absolute;
    inset: auto 0 0;
    height: 128px;
    background: linear-gradient(to top, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0));
  }

  .section-progress-button {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin: 0 auto 24px;
    pointer-events: auto;
    transform: translateY(6px);
    transition: transform 300ms ease;
  }
  .section-progress[data-visible] .section-progress-button {
    transform: none;
  }

  /* Labels share one cell, so switching sections is a true crossfade. */
  .section-progress-labels {
    display: grid;
  }
  .section-progress-label {
    grid-area: 1 / 1;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #333;
    opacity: 0;
    transition: opacity 250ms ease;
  }
  .section-progress-label[data-active] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .section-progress,
    .section-progress[data-visible],
    .section-progress-button,
    .section-progress-label {
      transition: none;
    }
  }
</style>

<script>
  import { sunPathGeometry } from '@/lib/sunPath';

  /** Share of the remaining distance the sun covers per 60fps frame. */
  const EASE = 0.15;
  const SETTLED = 0.0005;
  /** A section becomes current once its top passes this far down the viewport. */
  const CURRENT_LINE = 2 / 3;

  const root = document.querySelector<HTMLElement>('[data-section-progress]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root) {
    const button = root.querySelector<HTMLButtonElement>('[data-section-progress-button]')!;
    const sun = root.querySelector<SVGCircleElement>('[data-section-progress-sun]')!;
    const ray = root.querySelector<SVGLineElement>('[data-section-progress-ray]')!;
    const shadow = root.querySelector<SVGRectElement>('[data-section-progress-shadow]')!;
    const labels = [...root.querySelectorAll<HTMLElement>('[data-section-progress-label]')];
    const sections = labels.map((l) => document.getElementById(l.dataset.sectionProgressLabel!)!).filter(Boolean);
    const footer = document.querySelector('footer');

    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    let target = 0;
    let cur = 0;
    let current = 0;
    let frame = 0;
    let last = 0;
    let queued = false;

    function placeSun(t: number) {
      const g = sunPathGeometry(t);
      sun.setAttribute('cx', String(g.sun.x));
      sun.setAttribute('cy', String(g.sun.y));
      ray.setAttribute('x1', String(g.ray.x1));
      ray.setAttribute('y1', String(g.ray.y1));
      ray.setAttribute('x2', String(g.ray.x2));
      ray.setAttribute('y2', String(g.ray.y2));
      shadow.setAttribute('x', String(g.shadow.x));
      shadow.setAttribute('width', String(g.shadow.width));
    }

    function glide(now: number) {
      const frames = last ? Math.min((now - last) / (1000 / 60), 4) : 1;
      last = now;
      cur += (target - cur) * (1 - Math.pow(1 - EASE, frames));
      const settled = Math.abs(target - cur) < SETTLED;
      if (settled) cur = target;
      placeSun(cur);
      frame = settled ? 0 : requestAnimationFrame(glide);
    }

    function setCurrent(i: number) {
      if (i === current) return;
      current = i;
      labels.forEach((l, j) => l.toggleAttribute('data-active', j === i));
      const next = labels[i + 1];
      button.setAttribute('aria-label', next ? `Next section: ${next.textContent!.trim()}` : 'Back to top');
    }

    // Scroll positions (window.scrollY) where the indicator appears and leaves.
    function bounds() {
      const vh = window.innerHeight;
      const y = window.scrollY;
      // Leaves just before whatever follows the sections (the footer) scrolls into view.
      const after = (footer ?? sections[sections.length - 1]).getBoundingClientRect();
      return {
        start: y + sections[0].getBoundingClientRect().top - vh / 2,
        end: y + (footer ? after.top : after.bottom) - vh,
      };
    }

    function update() {
      queued = false;
      const vh = window.innerHeight;
      const mid = vh / 2;
      const y = window.scrollY;
      const { start, end } = bounds();

      // Shown from when the first section reaches mid-screen until just before the footer.
      root!.toggleAttribute('data-visible', y >= start && y < end);

      let i = 0;
      sections.forEach((s, j) => {
        if (s.getBoundingClientRect().top <= vh * CURRENT_LINE) i = j;
      });
      setCurrent(i);

      // Piecewise over scroll position: 0 as it appears, ½ with the middle section centered, 1 as it leaves.
      const middle = sections[Math.floor(sections.length / 2)].getBoundingClientRect();
      const peak = y + (middle.top + middle.bottom) / 2 - mid;
      target =
        peak > start && peak < end
          ? y < peak
            ? 0.5 * clamp01((y - start) / (peak - start))
            : 0.5 + 0.5 * clamp01((y - peak) / (end - peak))
          : clamp01((y - start) / (end - start));

      if (reduceMotion) {
        cur = target;
        placeSun(cur);
      } else if (!frame) {
        last = 0;
        frame = requestAnimationFrame(glide);
      }
    }

    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    button.addEventListener('click', () => {
      const behavior = reduceMotion ? 'auto' : 'smooth';
      const next = sections[current + 1];
      if (!next) {
        window.scrollTo({ top: 0, behavior });
        return;
      }
      // Stop short of where the indicator leaves, so a short last section keeps it on screen.
      const top =
        window.scrollY + next.getBoundingClientRect().top - (parseFloat(getComputedStyle(next).scrollMarginTop) || 0);
      window.scrollTo({ top: Math.min(top, bounds().end - 2), behavior });
    });

    update();
    cur = target;
    placeSun(cur);
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
  }
</script>
