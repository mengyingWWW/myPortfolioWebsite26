---
import { Image } from 'astro:assets';
import Container from '@/components/layout/Container.astro';
import CoverPlaceholder from '@/components/ui/CoverPlaceholder.astro';
import { workUrl, type WorkEntry } from '@/lib/work';

interface Props {
  project: WorkEntry;
}

const { project } = Astro.props;
const { title, subtitle, cover } = project.data;
---

<Container as="section" class="pt-40">
  <a href={workUrl(project)} data-cursor="view" class="group grid grid-cols-12 items-center gap-8 border-t border-line pt-12">
    <div class="col-span-7">
      <p class="text-sm font-medium tracking-wide text-muted uppercase">Next project</p>
      <p class="mt-4 text-4xl font-medium tracking-tight group-hover:underline group-hover:underline-offset-4">
        {title} →
      </p>
      <p class="mt-3 text-muted">{subtitle}</p>
    </div>
    <div class="col-span-5 aspect-[16/9] overflow-hidden">
      {
        cover ? (
          <Image src={cover} alt={`${title} cover`} class="h-full w-full object-cover" />
        ) : (
          <CoverPlaceholder title={title} class="h-full w-full" />
        )
      }
    </div>
  </a>
</Container>
