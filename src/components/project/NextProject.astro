---
import { Image } from 'astro:assets';
import Container from '@/components/layout/Container.astro';
import CoverPlaceholder from '@/components/ui/CoverPlaceholder.astro';
import { workUrl, type WorkEntry } from '@/lib/work';

interface Props {
  project: WorkEntry;
}

const { project } = Astro.props;
const { title, subtitle, cover } = project.data;
---

<Container as="section" class="pt-24">
  <a href={workUrl(project)} data-cursor="view" class="group grid grid-cols-12 items-center gap-8 border-t border-line pt-12 mobile:grid-cols-1 mobile:gap-6">
    <div class="col-span-7 mobile:col-span-1">
      <p class="text-sm font-medium tracking-wide text-muted uppercase">Next project</p>
      <p class="mt-4 text-4xl font-medium tracking-tight group-hover:underline group-hover:underline-offset-4 mobile:text-[28px]">
        {title} <span aria-hidden="true">→</span>
      </p>
      {subtitle && <p class="mt-3 text-muted">{subtitle}</p>}
    </div>
    <div class="col-span-5 aspect-[16/9] overflow-hidden mobile:col-span-1">
      {
        cover ? (
          <Image src={cover} alt="" class="h-full w-full object-cover" />
        ) : (
          <CoverPlaceholder title={title} class="h-full w-full" />
        )
      }
    </div>
  </a>
</Container>
