---
/**
 * One homepage chapter: the title and subtitle beside a drawing, then its project cards.
 * The drawing comes from the named "art" slot.
 */
import ProjectCard from './ProjectCard.astro';
import type { WorkEntry } from '@/lib/work';

interface Props {
  label: string;
  title: string;
  subtitle: string;
  projects: WorkEntry[];
  /** id of the heading, so the chapter can be labelled by it. */
  headingId: string;
}

const { label, title, subtitle, projects, headingId } = Astro.props;
---

<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-10 mobile:grid-cols-1 mobile:gap-6">
  <div>
    <p class="mb-4 font-mono text-[13px] leading-5 tracking-[0.06em] text-meta uppercase">{label}</p>
    <h2 id={headingId} class="text-[48px] leading-[1.1] font-bold tracking-[-0.025em] text-[#111] mobile:text-[36px]">
      {title}
    </h2>
    <p class="mt-4 max-w-[580px] text-[20px] leading-[1.5] text-[#3a3a3a] mobile:text-[18px]">{subtitle}</p>
  </div>
  <div class="mr-4 w-[300px] justify-self-end mobile:mr-0 mobile:w-[260px] mobile:justify-self-start">
    <slot name="art" />
  </div>
</div>
<div class="mt-8 grid grid-cols-2 gap-x-10 mobile:grid-cols-1 mobile:gap-y-14">
  {projects.map((project) => <ProjectCard project={project} />)}
</div>
