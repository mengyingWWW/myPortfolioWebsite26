---
/**
 * The homepage's three chapter strips, in place of the Selected Work grid.
 * The first strip is the #work target the hero's "View my work" scrolls to.
 */
import { getCollection } from 'astro:content';
import Container from '@/components/layout/Container.astro';
import ChapterStrip from './ChapterStrip.astro';
import LampSketch from '@/components/chapters/LampSketch.astro';
import TalkSketch from '@/components/chapters/TalkSketch.astro';
import PencilSketch from '@/components/chapters/PencilSketch.astro';
import { chapters } from '@/data/home';

const byId = new Map((await getCollection('work')).map((entry) => [entry.id, entry]));
const strips = chapters.map((chapter) => ({
  ...chapter,
  entries: chapter.projects.map((slug) => {
    const entry = byId.get(slug);
    if (!entry) throw new Error(`Chapter "${chapter.id}" references missing work slug "${slug}".`);
    return entry;
  }),
}));
---

<section class="pt-[120px] pb-32">
  <Container>
    {
      strips.map((strip, i) => (
        <div
          id={i === 0 ? 'work' : undefined}
          class:list={[i === 0 ? 'scroll-mt-[calc(5rem+32px)]' : 'mt-[160px]']}
          aria-labelledby={strip.id}
        >
          <ChapterStrip label={strip.label} title={strip.title} subtitle={strip.subtitle} projects={strip.entries} headingId={strip.id}>
            {strip.id === 'make-the-call' ? (
              <LampSketch slot="art" />
            ) : strip.id === 'sit-with-people' ? (
              <TalkSketch slot="art" />
            ) : (
              <PencilSketch slot="art" />
            )}
          </ChapterStrip>
        </div>
      ))
    }
    <div class="mt-12 flex justify-end font-mono text-[13px] leading-5 tracking-[0.06em] uppercase">
      <a href="/work" class="tap-target text-[#111]">All work <span aria-hidden="true">→</span></a>
    </div>
  </Container>
</section>

<script>
  // Back from a case study ("All work"): highlight the card the visitor came from. pageshow also covers a
  // page restored from the back/forward cache, where scripts don't run again.
  const RETURN_KEY = 'work-return';

  window.addEventListener('pageshow', () => {
    let id: string | null = null;
    try {
      id = sessionStorage.getItem(RETURN_KEY);
      sessionStorage.removeItem(RETURN_KEY);
    } catch {
      // Storage blocked: fall back to the hash.
    }
    id ??= location.hash.startsWith('#work-') ? decodeURIComponent(location.hash.slice(1)) : null;
    if (!id || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const card = document.getElementById(id);
    if (!card?.matches('[data-project-card]')) return;
    card.classList.remove('is-returning');
    void card.offsetWidth;
    card.classList.add('is-returning');
    setTimeout(() => card.classList.remove('is-returning'), 1300);
  });
</script>
