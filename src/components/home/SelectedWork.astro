---
import Container from '@/components/layout/Container.astro';
import ProjectCard from './ProjectCard.astro';
import MoreProjects from './MoreProjects.astro';
import { getFeaturedWork, yearRange } from '@/lib/work';

const projects = await getFeaturedWork();
---

<section class="pt-[120px] pb-32">
  <Container>
    <!-- The jump target is the label row: it lands 32px below the 80px sticky nav. -->
    <div
      id="work"
      class="mb-12 flex scroll-mt-[calc(5rem+32px)] items-baseline justify-between font-mono text-[13px] leading-5 tracking-[0.06em] uppercase"
    >
      <h2 class="text-[#111]">Selected Work</h2>
      <p class="text-meta">{yearRange(projects)}</p>
    </div>
    <div class="grid grid-cols-2 items-start gap-x-10 gap-y-[88px] mobile:grid-cols-1 mobile:gap-y-14">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
    <MoreProjects />
    <div class="mt-12 flex justify-end font-mono text-[13px] leading-5 tracking-[0.06em] uppercase">
      <a href="/work" class="tap-target text-[#111]">All work <span aria-hidden="true">→</span></a>
    </div>
  </Container>
</section>

<script>
  // Back from a case study ("All work"): highlight the card the visitor came from. pageshow also covers a
  // page restored from the back/forward cache, where scripts don't run again.
  const RETURN_KEY = 'work-return';

  window.addEventListener('pageshow', () => {
    let id: string | null = null;
    try {
      id = sessionStorage.getItem(RETURN_KEY);
      sessionStorage.removeItem(RETURN_KEY);
    } catch {
      // Storage blocked: fall back to the hash.
    }
    id ??= location.hash.startsWith('#work-') ? decodeURIComponent(location.hash.slice(1)) : null;
    if (!id || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const card = document.getElementById(id);
    if (!card?.matches('[data-project-card]')) return;
    card.classList.remove('is-returning');
    void card.offsetWidth;
    card.classList.add('is-returning');
    setTimeout(() => card.classList.remove('is-returning'), 1300);
  });
</script>
