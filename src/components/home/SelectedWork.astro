---
import Container from '@/components/layout/Container.astro';
import DisplayHeading from '@/components/ui/DisplayHeading.astro';
import ProjectCard from './ProjectCard.astro';
import { getSortedWork } from '@/lib/work';

const projects = await getSortedWork();
---

<section id="work" class="scroll-mt-20 pt-24 pb-32">
  <Container>
    <DisplayHeading italic="Selected" text="Projects" class="mb-12" />
  </Container>
  <!-- Full bleed: each card is half the viewport wide, no gaps. -->
  <div class="grid grid-cols-2 items-start">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
