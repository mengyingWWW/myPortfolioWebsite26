---
import Container from '@/components/layout/Container.astro';
import DisplayHeading from '@/components/ui/DisplayHeading.astro';
import ProjectCard from './ProjectCard.astro';
import { getSortedWork } from '@/lib/work';

const projects = await getSortedWork();
---

<Container as="section" id="work" class="scroll-mt-20 pt-24 pb-32">
  <DisplayHeading italic="Selected" text="Work" class="mb-12" />
  <div class="grid grid-cols-2 gap-x-10 gap-y-20">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</Container>
