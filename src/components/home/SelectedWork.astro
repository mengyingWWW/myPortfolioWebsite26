---
import Container from '@/components/layout/Container.astro';
import DisplayHeading from '@/components/ui/DisplayHeading.astro';
import ProjectCard from './ProjectCard.astro';
import { getSortedWork } from '@/lib/work';

const projects = await getSortedWork();
---

<section class="pt-24 pb-32">
  <Container>
    <!-- The jump target is the heading itself: it lands 32px below the 80px sticky nav. -->
    <div id="work" class="scroll-mt-[calc(5rem+32px)]">
      <DisplayHeading italic="Selected" text="Work" class="mb-12" />
    </div>
    <div class="grid grid-cols-2 items-start gap-x-10 gap-y-[88px]">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </Container>
</section>
