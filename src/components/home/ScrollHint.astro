---
/**
 * "View my work" hint at the bottom of the hero. Smooth-scrolls to the target
 * section on click and fades out once the page has scrolled.
 */
interface Props {
  /** id of the section to scroll to. */
  target: string;
  label?: string;
  class?: string;
  /** Fade out once the page has scrolled. Turn off when the page drives the fade itself. */
  autoHide?: boolean;
  /** Set the label in the monospace font. */
  mono?: boolean;
}

const { target, label = 'View my work', class: className, autoHide = true, mono = false } = Astro.props;
---

<div class:list={['absolute inset-x-0 bottom-8 z-10 flex justify-center', className]}>
  <a
    href={`#${target}`}
    class="scroll-hint text-glow"
    data-scroll-hint
    data-auto-hide={autoHide ? '' : undefined}
  >
    <span class="scroll-hint-label" data-mono={mono ? '' : undefined}>{label}</span>
    <span class="scroll-hint-track" aria-hidden="true">
      <span class="scroll-hint-line">
        <span class="scroll-hint-dot"></span>
      </span>
    </span>
  </a>
</div>

<style>
  .scroll-hint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    transition: opacity 300ms ease-out;
  }

  .scroll-hint[data-hidden] {
    opacity: 0;
    pointer-events: none;
  }

  .scroll-hint-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #333;
    transition: letter-spacing 300ms ease-out;
  }
  .scroll-hint-label[data-mono] {
    font-family: var(--font-mono);
    font-weight: 400;
  }

  /* Reserves room for the extended line so hovering doesn't push the label up. */
  .scroll-hint-track {
    display: flex;
    justify-content: center;
    height: 56px;
  }

  .scroll-hint-line {
    position: relative;
    width: 1px;
    height: 40px;
    background-color: #333;
    transition: height 300ms ease-out;
  }

  .scroll-hint-dot {
    position: absolute;
    top: 0;
    left: 50%;
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background-color: #000;
    transform: translate(-50%, -50%);
    animation: scroll-hint-travel 2.2s ease-in-out infinite;
  }

  @keyframes scroll-hint-travel {
    0% {
      top: 0;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    70% {
      opacity: 1;
    }
    90%,
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  .scroll-hint:is(:hover, :focus-visible) .scroll-hint-label {
    letter-spacing: 0.22em;
  }

  .scroll-hint:is(:hover, :focus-visible) .scroll-hint-line {
    height: 56px;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint,
    .scroll-hint-label,
    .scroll-hint-line {
      transition: none;
    }

    .scroll-hint-dot {
      animation: none;
    }
  }
</style>

<script>
  const SCROLL_THRESHOLD = 80;

  document.querySelectorAll<HTMLAnchorElement>('[data-scroll-hint]').forEach((hint) => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const target = document.querySelector(hint.hash);
    hint.addEventListener('click', (e) => {
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: reducedMotion.matches ? 'auto' : 'smooth' });
    });

    if (!hint.hasAttribute('data-auto-hide')) return;
    const update = () => hint.toggleAttribute('data-hidden', window.scrollY > SCROLL_THRESHOLD);
    update();
    window.addEventListener('scroll', update, { passive: true });
  });
</script>
