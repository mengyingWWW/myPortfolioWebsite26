---
import Container from '@/components/layout/Container.astro';
import LeafShadow from './LeafShadow.astro';
import ScrollHint from './ScrollHint.astro';
import { hero } from '@/data/home';
---

<!--
  Pulled up under the nav (h-20) so the hero spans exactly one viewport from the top.
  data-hero: the nav stays transparent while this is in view.
  data-cursor-zone="hero": the cursor becomes a leaf shadow over it.
  Entrance order continues from the nav (step 0).
-->
<section class="hero relative -mt-20 flex items-center overflow-hidden pt-20" data-hero data-cursor-zone="hero">
  <Container class="relative z-10 -mt-20 text-center">
    <div class="text-glow" data-hero-content>
      <h1 class="text-6xl leading-[1.15] font-medium tracking-tight">
        <span class="enter block [--enter:1]">
          {hero.greeting}{' '}<a href="/about" class="hero-link" data-cursor="invert"
            ><span class="hero-name font-serif font-normal italic">{hero.name}</span><span
              class="hero-period"
              aria-hidden="true"
              ><span class="hero-arrow"
                ><svg
                  viewBox="0 -40 90 60"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><g opacity="0.8">
                    <line class="hero-arrow-shaft" x1="7.95" y1="-6.46" x2="45.95" y2="-6.46"></line>
                    <polyline class="hero-arrow-head" points="37.52,-13.53 45.95,-6.46 37.52,0.61" pathLength="1"
                    ></polyline>
                  </g></svg
                ></span
              ><span class="hero-period-dot">.</span></span
            ></a
          >
        </span>
        <span class="enter block [--enter:2]">{hero.tagline}</span>
      </h1>
      <p class="enter mt-10 text-lg leading-relaxed [--enter:3]">
        <em class="font-serif text-[#555]">{hero.introLead}</em>{' '}{hero.introRest}
        <br />
        {hero.introLine2}
      </p>
    </div>
  </Container>

  <div class="hero-leaves pointer-events-none absolute inset-0 z-0">
    <LeafShadow />
  </div>
  <div class="hero-name-shadow" lang="zh-CN" aria-hidden="true">{hero.nameShadow}</div>
  <ScrollHint target="work" class="enter [--enter:4]" />
</section>

<style>
  .hero {
    height: 100vh;
    height: 100dvh;
    min-height: 640px;
  }

  .hero-link {
    color: inherit;
    text-decoration: none;
  }
  .hero-link:focus-visible {
    outline: none;
  }

  /* Dotted underline on the name only; on hover/focus a solid line fades in over it (an overlay,
     so the swap doesn't move anything). */
  .hero-name {
    position: relative;
    border-bottom: 2px dotted #bdbdbd;
    padding-bottom: 2px;
    transition: border-color 200ms ease;
  }
  .hero-name::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: #111;
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .hero-link:is(:hover, :focus-visible) .hero-name {
    border-bottom-color: transparent;
  }
  .hero-link:is(:hover, :focus-visible) .hero-name::after {
    opacity: 1;
  }

  /* Period → thin arrow. The real "." keeps its box (so the centered line never shifts); the SVG
     sits on the baseline at the period's left edge and overflows to the right. SVG units are
     0.01em (stroke 2.5 = 1.5px at the 60px headline). The shaft runs through the center of the
     Inter 500 dot (0.08em into the period's box, 0.065em above the baseline) and is 0.38em long;
     the chevron's arms are 0.11em at 40°. */
  /* Zero-size and in flow: its bottom edge is the baseline, and it adds no width. */
  .hero-arrow {
    position: relative;
    display: inline-block;
    width: 0;
    height: 0;
    vertical-align: baseline;
  }
  .hero-arrow svg {
    position: absolute;
    left: 0;
    bottom: -0.2em;
    width: 0.9em;
    height: 0.6em;
    overflow: visible;
    color: #111;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0s linear 200ms;
  }
  .hero-period-dot {
    transition: opacity 200ms ease;
  }
  .hero-arrow-shaft {
    stroke-dasharray: 0 100;
    transition: stroke-dasharray 200ms ease-in;
  }
  .hero-arrow-head {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    opacity: 0;
    transition:
      stroke-dashoffset 100ms ease-in,
      opacity 100ms ease-in;
  }

  .hero-link:is(:hover, :focus-visible) .hero-period-dot {
    opacity: 0;
    transition: opacity 160ms ease-out;
  }
  .hero-link:is(:hover, :focus-visible) .hero-arrow svg {
    opacity: 1;
    transition: none;
  }
  .hero-link:is(:hover, :focus-visible) .hero-arrow-shaft {
    stroke-dasharray: 38 100;
    transition: stroke-dasharray 240ms ease-out;
  }
  .hero-link:is(:hover, :focus-visible) .hero-arrow-head {
    stroke-dashoffset: 0;
    opacity: 1;
    transition:
      stroke-dashoffset 120ms ease-out 100ms,
      opacity 120ms ease-out 100ms;
  }

  /* Easter egg: the Chinese name cast on the wall while the name is hovered/focused.
     Between the leaf shadows (z-0) and the text (z-10); multiply so it reads as the same light.
     The font must match the glyph-subset stylesheet linked in pages/index.astro; to swap, change
     both (e.g. 'Ma Shan Zheng', cursive at 400:
     https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&text=梦嬴&display=swap). */
  .hero-name-shadow {
    --name-shadow-font: 'LXGW WenKai TC', 'Kaiti SC', 'STKaiti', serif;
    --name-shadow-weight: 300;
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 52%;
    transform: translate(-44%, -46%) skewX(-10deg);
    font-family: var(--name-shadow-font);
    font-size: min(30vw, 46vh);
    font-weight: var(--name-shadow-weight);
    line-height: 1;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: rgba(0, 0, 0, 0.13);
    mix-blend-mode: multiply;
    pointer-events: none;
    user-select: none;
    opacity: 0;
    filter: blur(22px);
    transition:
      opacity 1.6s ease,
      filter 1.6s ease;
    /* Paused rather than removed when hidden, so it doesn't jump back while dissolving. */
    animation: name-shadow-drift 9s ease-in-out infinite alternate paused;
  }
  .hero:has(.hero-link:is(:hover, :focus-visible)) .hero-name-shadow {
    opacity: 1;
    filter: blur(6px);
    transition:
      opacity 1.1s ease,
      filter 1.1s ease;
    animation-play-state: running;
  }

  /* The leaves step back a little meanwhile, so the name reads as the nearer shadow. */
  .hero-leaves {
    transition: opacity 1.6s ease;
  }
  .hero:has(.hero-link:is(:hover, :focus-visible)) .hero-leaves {
    opacity: 0.7;
    transition: opacity 1s ease;
  }
  @keyframes name-shadow-drift {
    from {
      translate: -3px 2px;
    }
    to {
      translate: 4px -3px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-name,
    .hero-name::after {
      transition: none;
    }
    /* Period and full arrow crossfade; nothing stretches or draws. */
    .hero-period-dot,
    .hero-link:is(:hover, :focus-visible) .hero-period-dot,
    .hero-arrow svg,
    .hero-link:is(:hover, :focus-visible) .hero-arrow svg {
      transition: opacity 200ms ease;
    }
    .hero-arrow-shaft,
    .hero-link:is(:hover, :focus-visible) .hero-arrow-shaft {
      stroke-dasharray: 38 100;
      transition: none;
    }
    .hero-arrow-head,
    .hero-link:is(:hover, :focus-visible) .hero-arrow-head {
      stroke-dashoffset: 0;
      opacity: 1;
      transition: none;
    }
    .hero-name-shadow,
    .hero:has(.hero-link:is(:hover, :focus-visible)) .hero-name-shadow {
      filter: blur(6px);
      animation: none;
    }
    .hero-name-shadow {
      transition: opacity 1.6s ease;
    }
    .hero:has(.hero-link:is(:hover, :focus-visible)) .hero-name-shadow {
      transition: opacity 1.1s ease;
    }
  }
</style>
