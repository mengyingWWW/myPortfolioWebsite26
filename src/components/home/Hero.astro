---
import Container from '@/components/layout/Container.astro';
import { hero } from '@/data/home';
---

<section class="relative flex min-h-[calc(100vh-5rem)] items-center overflow-hidden">
  <Container class="relative z-10 -mt-20 text-center">
    <h1 class="text-6xl leading-[1.15] font-medium tracking-tight">
      {hero.greeting}{' '}
      <em
        class="font-serif font-normal underline decoration-subtle decoration-dotted decoration-2 underline-offset-[10px]"
      >
        {hero.name}</em
      >.
      <br />
      {hero.tagline}
    </h1>
    <p class="mt-10 text-lg leading-relaxed">
      <em class="font-serif text-muted">{hero.introLead}</em>{' '}{hero.introRest}
      <br />
      {hero.introLine2}
    </p>
    <p class="mt-5 font-serif text-base text-muted italic">{hero.education}</p>
    <p class="mt-6 inline-flex items-center gap-2 text-sm">
      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 21s-7-6.1-7-11a7 7 0 1 1 14 0c0 4.9-7 11-7 11z"></path>
        <circle cx="12" cy="10" r="2.5"></circle>
      </svg>
      {hero.location}
      <span class="h-3.5 border-l border-subtle" aria-hidden="true"></span>
      {hero.availability}
    </p>
  </Container>

  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[55%] blur-2xl [mask-image:linear-gradient(to_bottom,transparent,black_45%,black_70%,transparent)]"
    style="background: radial-gradient(ellipse 60% 70% at 25% 75%, var(--color-glow-1), transparent), radial-gradient(ellipse 60% 70% at 75% 80%, var(--color-glow-2), transparent), radial-gradient(ellipse 80% 60% at 50% 70%, var(--color-glow-3), transparent);"
    aria-hidden="true"
  >
  </div>
</section>
