---
import Container from '@/components/layout/Container.astro';
import RotatingWord from '@/components/hero/RotatingWord.astro';
import ScrollHint from './ScrollHint.astro';
import SunReadout from './SunReadout.astro';
import { hero } from '@/data/home';
---

<!--
  Pulled up under the nav (h-20) so the hero spans exactly one viewport from the top.
  data-hero: the nav stays transparent while this is in view.
  data-cursor-zone="hero": the cursor becomes a leaf shadow over it.
  Entrance order continues from the nav (step 0).
-->
<section class="hero relative -mt-20 flex items-center overflow-hidden pt-20" data-hero data-cursor-zone="hero">
  <Container class="relative z-10 -mt-20 text-center">
    <div class="text-glow" data-hero-content>
      <h1>
        <span class="hero-enter block text-[96px] leading-[1.1] font-medium tracking-tight mobile:text-[clamp(34px,9.4vw,96px)]">
          {hero.greeting}{' '}<a href="/about" class="hero-link whitespace-nowrap mobile:py-1"
            ><span class="hero-name">{hero.name}</span><span
              class="hero-period"
              aria-hidden="true"
              ><span class="hero-arrow"
                ><svg
                  viewBox="0 -40 90 60"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><g opacity="0.8">
                    <line class="hero-arrow-shaft" x1="7.95" y1="-6.46" x2="45.95" y2="-6.46"></line>
                    <polyline class="hero-arrow-head" points="37.52,-13.53 45.95,-6.46 37.52,0.61" pathLength="1"
                    ></polyline>
                  </g></svg
                ></span
              ><span class="hero-period-dot">.</span></span
            ></a
          >
        </span>
        <span class="sr-only">{hero.taglineSpoken}</span>
        <span
          class="hero-enter mt-6 block text-[52px] leading-[1.25] font-medium tracking-normal text-balance mobile:text-[clamp(22px,6vw,52px)]"
          aria-hidden="true">{hero.taglineLead}</span
        >
        <span
          class="hero-enter block text-[52px] leading-[1.25] font-medium tracking-normal text-balance mobile:text-[clamp(22px,6vw,52px)]"
          aria-hidden="true"
          >{hero.taglineBefore}<RotatingWord words={hero.taglineWords} />{hero.taglineAfter}</span
        >
      </h1>
      <p class="hero-enter mt-10 text-[20px] leading-relaxed text-balance text-[#555] mobile:text-[16px]">{hero.intro}</p>
      <p class="hero-enter mt-3 text-[20px] leading-relaxed text-[#555] mobile:text-[16px]">
        {hero.education.map((item, i) => (
          <>
            {i > 0 && <> <span aria-hidden="true">·</span> </>}
            <span class="whitespace-nowrap">{item}</span>
          </>
        ))}
      </p>
    </div>
  </Container>

  <ScrollHint target="work" class="enter [--enter:4]" />
  <SunReadout />
</section>

<style>
  .hero {
    height: 100vh;
    height: 100dvh;
    min-height: 640px;
  }

  /* Visible from the first frame: no fade and no delay, so it never waits on the leaf shadow's
     start-up work. */
  .hero-enter {
    animation: hero-rise 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes hero-rise {
    from {
      transform: translateY(8px);
    }
  }

  .hero-link {
    color: inherit;
    text-decoration: none;
  }
  .hero-link:focus-visible {
    outline: none;
  }

  /* Dotted underline on the name only; on hover/focus a solid line fades in over it (an overlay,
     so the swap doesn't move anything). */
  .hero-name {
    position: relative;
    border-bottom: 2px dotted var(--color-meta);
    padding-bottom: 2px;
    transition: border-color 200ms ease;
  }
  .hero-name::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: #111;
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .hero-link:is(:hover, :focus-visible) .hero-name {
    border-bottom-color: transparent;
  }
  .hero-link:is(:hover, :focus-visible) .hero-name::after {
    opacity: 1;
  }

  /* Period → thin arrow. The real "." keeps its box (so the centered line never shifts); the SVG
     sits on the baseline at the period's left edge and overflows to the right. SVG units are
     0.01em (stroke 2.5 = 1.5px at the 60px headline). The shaft runs through the center of the
     Inter 500 dot (0.08em into the period's box, 0.065em above the baseline) and is 0.38em long;
     the chevron's arms are 0.11em at 40°. */
  /* Zero-size and in flow: its bottom edge is the baseline, and it adds no width. */
  .hero-arrow {
    position: relative;
    display: inline-block;
    width: 0;
    height: 0;
    vertical-align: baseline;
  }
  .hero-arrow svg {
    position: absolute;
    left: 0;
    bottom: -0.2em;
    width: 0.9em;
    height: 0.6em;
    overflow: visible;
    color: #111;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0s linear 200ms;
  }
  .hero-period-dot {
    transition: opacity 200ms ease;
  }
  .hero-arrow-shaft {
    stroke-dasharray: 0 100;
    transition: stroke-dasharray 200ms ease-in;
  }
  .hero-arrow-head {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    opacity: 0;
    transition:
      stroke-dashoffset 100ms ease-in,
      opacity 100ms ease-in;
  }

  .hero-link:is(:hover, :focus-visible) .hero-period-dot {
    opacity: 0;
    transition: opacity 160ms ease-out;
  }
  .hero-link:is(:hover, :focus-visible) .hero-arrow svg {
    opacity: 1;
    transition: none;
  }
  .hero-link:is(:hover, :focus-visible) .hero-arrow-shaft {
    stroke-dasharray: 38 100;
    transition: stroke-dasharray 240ms ease-out;
  }
  .hero-link:is(:hover, :focus-visible) .hero-arrow-head {
    stroke-dashoffset: 0;
    opacity: 1;
    transition:
      stroke-dashoffset 120ms ease-out 100ms,
      opacity 120ms ease-out 100ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      animation: none;
    }
    .hero-name,
    .hero-name::after {
      transition: none;
    }
    /* Period and full arrow crossfade; nothing stretches or draws. */
    .hero-period-dot,
    .hero-link:is(:hover, :focus-visible) .hero-period-dot,
    .hero-arrow svg,
    .hero-link:is(:hover, :focus-visible) .hero-arrow svg {
      transition: opacity 200ms ease;
    }
    .hero-arrow-shaft,
    .hero-link:is(:hover, :focus-visible) .hero-arrow-shaft {
      stroke-dasharray: 38 100;
      transition: none;
    }
    .hero-arrow-head,
    .hero-link:is(:hover, :focus-visible) .hero-arrow-head {
      stroke-dashoffset: 0;
      opacity: 1;
      transition: none;
    }
  }
</style>
