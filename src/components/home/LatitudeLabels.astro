---
/**
 * Clickable latitude annotations. Choosing one dispatches a `sun-city-change`
 * event on window with `detail` = city name, or null when deselected.
 */
import { CITIES, CHOSEN_DATE } from '@/data/sunlight';

const dateLabel = new Date(2000, CHOSEN_DATE.month - 1, CHOSEN_DATE.day).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
});

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={[
    'text-glow flex justify-center gap-3 text-[11px] tracking-[0.12em] text-[#8a8a8a] tabular-nums',
    className,
  ]}
  data-latitude-labels
>
  {
    CITIES.map((city, i) => (
      <>
        {i > 0 && <span aria-hidden="true">·</span>}
        <button
          type="button"
          class="decoration-dotted underline-offset-4 hover:underline aria-pressed:underline"
          data-city={city.name}
          data-cursor="default"
          aria-pressed="false"
          aria-label={`Show ${city.name} sunlight on ${dateLabel}`}
        >
          {city.label}
        </button>
      </>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-latitude-labels]').forEach((root) => {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-city]'));
    let chosen: string | null = null;

    for (const button of buttons) {
      button.addEventListener('click', () => {
        chosen = chosen === button.dataset.city ? null : button.dataset.city!;
        for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.city === chosen));
        window.dispatchEvent(new CustomEvent('sun-city-change', { detail: chosen }));
      });
    }
  });
</script>
