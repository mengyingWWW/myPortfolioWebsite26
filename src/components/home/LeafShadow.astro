---
/**
 * Full-bleed leaf-shadow photo, animated in WebGL (breeze warp + cursor wind) and lit by
 * Seattle's real sun: the shadows lengthen and lean with its altitude and azimuth, their edges
 * soften near the horizon, and the wall and shadow colours follow the time of day.
 * Place inside a positioned section; it fills it. If the section contains [data-hero-content],
 * shadows are lightened behind it. Tuning constants live at the top of the <script> below.
 */
interface Props {
  /** Shadow photo, relative to /public. Any size or aspect works (cover fit). */
  src?: string;
}

const { src = '/images/hero/leaf-shadow.png' } = Astro.props;
---

<div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
  <div class="leaf-shadow absolute inset-0 bg-cover bg-center" data-leaf-fallback></div>
  <canvas class="leaf-shadow absolute inset-0 h-full w-full" data-leaf-shadow data-src={src}></canvas>
</div>

<style>
  .leaf-shadow {
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .leaf-shadow[data-ready] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .leaf-shadow {
      transition: none;
    }
  }
</style>

<script>
  import type { SunPosition } from '@/lib/sun';
  import { everyMinute, seattleNow, seattleSun } from '@/lib/seattle';
  // Darkest shadow brightness; shared with the cursor's cast shadow.
  import { SHADOW_DARKNESS, SHADOW_ALPHA } from '@/data/shadow';

  const rgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);

  // ---- Tuning -------------------------------------------------------------
  /** Steepness of the tone curve; higher = whiter lights and more defined shadows. */
  const CONTRAST = 2.6;
  /** Breeze warp amplitude, in UV units. */
  const BREEZE_AMOUNT = 0.006;
  /** Speed of the breeze sway and shimmer. */
  const BREEZE_SPEED = 1.0;
  /** Radius of the cursor's wind, in fractions of the screen height. */
  const WIND_RADIUS = 0.18;
  /** How far the wind pushes the shadows per unit of mouse speed. */
  const WIND_STRENGTH = 0.015;
  /** Per-frame decay of each gust (at 60fps). ~0.95 flows back within 1–2s. */
  const DECAY = 0.95;
  /** Max push of a single gust, in fractions of the screen height. */
  const MAX_PUSH = 0.03;
  /** Clear zone behind the hero text: shadow density there, and its size (fractions of the viewport). */
  const CLEAR_ZONE_DENSITY = 0.55;
  const CLEAR_ZONE_SIZE = [0.6, 0.4];
  /** Fraction of the cover-fitted photo shown, leaving a margin for the warps. */
  const OVERSCAN = 0.92;
  /** Duration (ms) of the ease to a new sun position. */
  const SUN_TRANSITION = 1200;
  /** Canvas pixels per CSS pixel. */
  const RESOLUTION = 0.6;
  /** Number of recent cursor samples kept as wind sources. */
  const RING_SIZE = 12;
  /** Minimum time (ms) between new cursor samples. */
  const SAMPLE_INTERVAL = 80;

  /** Wall and shadow colours, shadow strength and penumbra blur radius (CSS px) through the day. */
  const NIGHT = { wall: rgb('#EEF1F6'), shade: rgb('#BFC8D7'), strength: 0.8, blur: 5 }; // altitude ≤ -6°
  const GOLDEN = { wall: rgb('#FFF2E0'), shade: rgb('#C4C9D8'), strength: 1.15, blur: 4 }; // 0°–8°
  const MIDDAY = { wall: rgb('#FFFDF8'), shade: rgb('#D6DBE4'), strength: 1.0, blur: 1.5 }; // ≥ 38°
  /** Glow from the top-right (soft-light): warm at golden hour, cool at night. Colour and opacity. */
  const GLOW_WARM = rgb('#FFD6A0');
  const GLOW_WARM_MAX = 0.35;
  const GLOW_COOL = [190 / 255, 205 / 255, 235 / 255];
  const GLOW_COOL_MAX = 0.18;
  /** Night geometry: the sun is below the horizon, so a fixed gentle projection. */
  const NIGHT_LEN = 1.25;
  const NIGHT_SKEW = 0.15;
  /** Horizontal shear of the shadows per unit of height, with the sun due east / west. */
  const MAX_SKEW = 0.55;
  /** How far the composition mask turns with the sun's azimuth. */
  const MASK_TURN = 15;
  // -------------------------------------------------------------------------

  const VERTEX_SHADER = `
    attribute vec2 aPosition;
    void main() { gl_Position = vec4(aPosition, 0.0, 1.0); }
  `;

  const FRAGMENT_SHADER = `
    precision highp float;
    #define RING ${RING_SIZE}

    uniform sampler2D uImage;
    uniform vec2 uResolution;
    uniform vec2 uCover;          // fraction of the photo visible on each axis
    uniform vec2 uPx;             // photo UV size of one CSS pixel
    uniform vec2 uLevels;         // photo luminance black / white points
    uniform float uTime;
    uniform vec3 uTrail[RING];    // xy = position (screen-height units), z = strength
    uniform vec2 uTrailVel[RING]; // push vector
    uniform float uRadius;
    uniform float uBreeze;
    uniform float uContrast;
    uniform vec2 uFocus;          // clear zone centre and radii (screen-height units)
    uniform vec2 uFocusSize;
    uniform float uClearing;      // shadow density inside the clear zone
    // Sun-driven
    uniform float uLen;           // shadow length (1 = high sun)
    uniform float uSkew;          // horizontal shear per unit of height (morning vs evening)
    uniform float uBlur;          // penumbra radius, CSS px
    uniform vec3 uWall;           // lit wall colour
    uniform vec3 uShade;          // deepest shadow colour
    uniform float uStrength;
    uniform vec3 uGlowColor;
    uniform float uGlow;          // glow opacity
    uniform float uMaskAngle;     // direction the composition mask fades towards

    float hash12(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }

    float noise(vec2 p) {
      vec2 i = floor(p);
      vec2 f = fract(p);
      vec2 u = f * f * (3.0 - 2.0 * f);
      return mix(
        mix(hash12(i), hash12(i + vec2(1.0, 0.0)), u.x),
        mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0, 1.0)), u.x),
        u.y
      );
    }

    float fbm(vec2 p) {
      float v = 0.0;
      float a = 0.5;
      for (int i = 0; i < 4; i++) {
        v += a * noise(p);
        p = mat2(0.8, -0.6, 0.6, 0.8) * p * 2.02 + 17.0;
        a *= 0.5;
      }
      return v;
    }

    // The projection can reach past the photo's edges; mirror it there instead of smearing.
    float lum(vec2 uv) {
      vec2 m = 1.0 - abs(mod(uv, 2.0) - 1.0);
      return dot(texture2D(uImage, m).rgb, vec3(0.2126, 0.7152, 0.0722));
    }

    // W3C soft-light.
    vec3 softLight(vec3 b, vec3 s) {
      vec3 d = mix(sqrt(b), ((16.0 * b - 12.0) * b + 4.0) * b, step(b, vec3(0.25)));
      return mix(b - (1.0 - 2.0 * s) * b * (1.0 - b), b + (2.0 * s - 1.0) * (d - b), step(0.5, s));
    }

    void main() {
      vec2 s = gl_FragCoord.xy / uResolution;
      float aspect = uResolution.x / uResolution.y;
      vec2 p = vec2(s.x * aspect, s.y);

      // Cursor wind: recent gusts with a gaussian falloff, plus a slight swirl.
      vec2 wind = vec2(0.0);
      for (int i = 0; i < RING; i++) {
        vec3 source = uTrail[i];
        if (source.z < 0.001) continue;
        vec2 d = p - source.xy;
        float falloff = exp(-dot(d, d) / (uRadius * uRadius)) * source.z;
        vec2 push = uTrailVel[i];
        vec2 swirl = vec2(-d.y, d.x) / uRadius * length(push) * 0.25;
        wind += (push + swirl) * falloff;
      }

      // Breeze: slow drifting fbm sway plus a finer, quicker shimmer.
      float t = uTime;
      vec2 q = p * 2.5;
      vec2 breeze = vec2(
        fbm(q + vec2(t * 0.05, t * 0.03)),
        fbm(q + vec2(5.2, 1.3) - vec2(t * 0.04, t * 0.06))
      ) - 0.5;
      breeze += (vec2(noise(p * 9.0 + t * 0.5), noise(p * 9.0 + 7.1 - t * 0.45)) - 0.5) * 0.3;
      vec2 offset = breeze * 2.0 * uBreeze - wind;

      // Slow breathing: ~1.5% scale over 20s and a gentle drift.
      float breath = 1.0 + 0.0075 * sin(t * 0.31416);
      vec2 drift = vec2(sin(t * 0.23), cos(t * 0.19)) * 0.004;

      vec2 uv = (s - 0.5) * uCover / breath + 0.5 + drift;
      uv += offset * vec2(1.0 / aspect, 1.0) * uCover;

      // Sun projection, anchored at the top-right corner so the canopy stays rooted there:
      // stretched along the fall of the shadow (longer at a low sun), sheared by the azimuth.
      vec2 anchor = 0.5 + 0.5 * uCover;
      vec2 r = uv - anchor;
      r.y /= uLen;
      r.x += uSkew * r.y;
      uv = anchor + r;

      // Penumbra: a crisp sample and a 9-tap blur, mixed by slow noise so some leaves read as
      // near the wall (crisp) and others further away (diffuse).
      vec2 k = uPx * uBlur * 0.7;
      float sharp = lum(uv);
      float soft = (
        4.0 * sharp +
        2.0 * (lum(uv + vec2(k.x, 0.0)) + lum(uv - vec2(k.x, 0.0)) + lum(uv + vec2(0.0, k.y)) + lum(uv - vec2(0.0, k.y))) +
        lum(uv + k) + lum(uv - k) + lum(uv + vec2(k.x, -k.y)) + lum(uv + vec2(-k.x, k.y))
      ) / 16.0;
      float m = 0.3 + 0.5 * smoothstep(0.3, 0.7, fbm(p * 0.9 + vec2(t * 0.011, -t * 0.007)));
      float l = mix(sharp, soft, m);

      // Shadow density: the photo's own range, then a smooth S-curve (0 = lit, 1 = deepest).
      float v = clamp((l - uLevels.x) / (uLevels.y - uLevels.x), 0.0, 1.0);
      float x = clamp((v - 0.5) * uContrast + 0.58, 0.0, 1.0);
      float density = 1.0 - x * x * (3.0 - 2.0 * x);

      // Composition: full in the corner the light comes in from, ~35% mid-screen, 0 opposite.
      vec2 dir = vec2(cos(uMaskAngle), sin(uMaskAngle));
      float g = clamp(dot(s - 1.0, dir) / dot(vec2(-1.0), dir), 0.0, 1.0);
      density *= g < 0.5 ? mix(1.0, 0.35, g * 2.0) : mix(0.35, 0.0, g * 2.0 - 1.0);

      // Clear zone behind the text: an ellipse with feathered edges.
      float e = length((p - uFocus) / uFocusSize);
      density *= mix(uClearing, 1.0, smoothstep(0.6, 1.3, e));

      vec3 col = mix(uWall, uShade, density * uStrength);

      // Glow from the top-right: warm at golden hour, cool at night.
      vec2 gc = p - vec2(aspect, 1.0);
      col = mix(col, softLight(col, uGlowColor), uGlow * exp(-dot(gc, gc) / 0.9));

      // Sub-pixel dither hides 8-bit banding across such a narrow range.
      float dither = (hash12(gl_FragCoord.xy + fract(uTime)) - 0.5) / 255.0;
      gl_FragColor = vec4(clamp(col + dither, 0.0, 1.0), 1.0);
    }
  `;

  const DEG = Math.PI / 180;
  const clamp = (x: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, x));
  const clamp01 = (x: number) => clamp(x, 0, 1);
  /** Also runs backwards when a > b. */
  const smoothstep = (a: number, b: number, x: number) => {
    const t = clamp01((x - a) / (b - a));
    return t * t * (3 - 2 * t);
  };
  const mix = (a: number, b: number, t: number) => a + (b - a) * t;
  const easeInOutCubic = (p: number) => (p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2);

  /** Everything the sun drives, as one flat list so it can be eased as a whole. */
  type Look = {
    len: number;
    skew: number;
    blur: number;
    strength: number;
    glow: number;
    maskAngle: number;
    wall: number[];
    shade: number[];
    glowColor: number[];
  };

  /** How the wall looks with the sun here. */
  function lookFor({ altitude: alt, azimuth: az }: SunPosition): Look {
    // Night → golden hour over civil twilight, then golden hour → midday as the sun climbs.
    const dawn = smoothstep(-6, 0, alt);
    const day = smoothstep(8, 38, alt);
    const blend = (pick: (k: typeof NIGHT) => number) => mix(mix(pick(NIGHT), pick(GOLDEN), dawn), pick(MIDDAY), day);
    // Geometry follows the sun once it's up; below the horizon it settles to the night projection.
    const lean = -Math.sin((az - 180) * DEG);
    const sunLen = clamp(0.9 + 0.5 / Math.tan(Math.max(alt, 4) * DEG), 1, 2.6);
    return {
      len: mix(NIGHT_LEN, sunLen, dawn),
      skew: mix(NIGHT_SKEW, lean * MAX_SKEW, dawn),
      blur: blend((k) => k.blur),
      strength: blend((k) => k.strength),
      glow: mix(GLOW_COOL_MAX, GLOW_WARM_MAX, dawn) * (1 - day),
      maskAngle: (225 + dawn * lean * MASK_TURN) * DEG,
      wall: [0, 1, 2].map((i) => blend((k) => k.wall[i])),
      shade: [0, 1, 2].map((i) => blend((k) => k.shade[i])),
      glowColor: [0, 1, 2].map((i) => mix(GLOW_COOL[i], GLOW_WARM[i], dawn)),
    };
  }

  const flatten = (l: Look) => [
    l.len,
    l.skew,
    l.blur,
    l.strength,
    l.glow,
    l.maskAngle,
    ...l.wall,
    ...l.shade,
    ...l.glowColor,
  ];
  const unflatten = (a: number[]): Look => ({
    len: a[0],
    skew: a[1],
    blur: a[2],
    strength: a[3],
    glow: a[4],
    maskAngle: a[5],
    wall: a.slice(6, 9),
    shade: a.slice(9, 12),
    glowColor: a.slice(12, 15),
  });

  /** Luminance black/white points of the photo (2nd and 98th percentile). */
  function measureLevels(img: HTMLImageElement): [number, number] {
    try {
      const w = 96;
      const h = Math.max(1, Math.round((w * img.naturalHeight) / img.naturalWidth));
      const ctx = Object.assign(document.createElement('canvas'), { width: w, height: h }).getContext('2d')!;
      ctx.drawImage(img, 0, 0, w, h);
      const data = ctx.getImageData(0, 0, w, h).data;
      const lums: number[] = [];
      for (let i = 0; i < data.length; i += 4) {
        lums.push((0.2126 * data[i] + 0.7152 * data[i + 1] + 0.0722 * data[i + 2]) / 255);
      }
      lums.sort((a, b) => a - b);
      const lo = lums[Math.floor(lums.length * 0.02)];
      const hi = lums[Math.floor(lums.length * 0.98)];
      if (hi - lo > 0.05) return [lo, hi];
    } catch {
      // Cross-origin or decode failure: fall through to defaults.
    }
    return [0.5, 0.95];
  }

  /** Static CSS version: levels + contrast via filters, darkness via opacity over white. */
  function showFallback(el: HTMLElement, src: string, [lo, hi]: [number, number]) {
    el.style.backgroundImage = `url("${src}")`;
    // brightness(b) then contrast(c) maps lo -> 0 and hi -> 1.
    const b = 1 / (lo + hi);
    const c = (lo + hi) / (hi - lo);
    el.style.filter = `grayscale(1) brightness(${b}) contrast(${c}) contrast(${CONTRAST})`;
    el.style.opacity = String(1 - SHADOW_DARKNESS);
  }

  const canvas = document.querySelector<HTMLCanvasElement>('[data-leaf-shadow]');
  const fallback = document.querySelector<HTMLElement>('[data-leaf-fallback]');
  if (canvas && fallback && canvas.dataset.src) {
    const src = canvas.dataset.src;
    const img = new Image();
    img.onload = () => {
      const levels = measureLevels(img);
      if (!initLeafShadow(canvas, img, levels)) showFallback(fallback, src, levels);
    };
    img.src = src;
  }

  function compile(gl: WebGLRenderingContext, type: number, source: string) {
    const shader = gl.createShader(type)!;
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
      console.warn('LeafShadow shader error:', gl.getShaderInfoLog(shader));
      return null;
    }
    return shader;
  }

  /** Returns false if WebGL is unavailable, so the caller can show the CSS fallback. */
  function initLeafShadow(canvas: HTMLCanvasElement, img: HTMLImageElement, levels: [number, number]) {
    const gl = canvas.getContext('webgl', { antialias: false, alpha: false, premultipliedAlpha: false });
    if (!gl) return false;

    const vs = compile(gl, gl.VERTEX_SHADER, VERTEX_SHADER);
    const fs = compile(gl, gl.FRAGMENT_SHADER, FRAGMENT_SHADER);
    if (!vs || !fs) return false;
    const program = gl.createProgram()!;
    gl.attachShader(program, vs);
    gl.attachShader(program, fs);
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return false;
    gl.useProgram(program);

    const buffer = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const aPosition = gl.getAttribLocation(program, 'aPosition');
    gl.enableVertexAttribArray(aPosition);
    gl.vertexAttribPointer(aPosition, 2, gl.FLOAT, false, 0, 0);

    // Non-power-of-two textures in WebGL1 need clamp-to-edge and no mipmaps.
    const texture = gl.createTexture();
    gl.bindTexture(gl.TEXTURE_2D, texture);
    gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGB, gl.RGB, gl.UNSIGNED_BYTE, img);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);

    const u = (name: string) => gl.getUniformLocation(program, name);
    const uniforms = {
      resolution: u('uResolution'),
      cover: u('uCover'),
      px: u('uPx'),
      time: u('uTime'),
      trail: u('uTrail'),
      trailVel: u('uTrailVel'),
      focus: u('uFocus'),
      focusSize: u('uFocusSize'),
      len: u('uLen'),
      skew: u('uSkew'),
      blur: u('uBlur'),
      wall: u('uWall'),
      shade: u('uShade'),
      strength: u('uStrength'),
      glow: u('uGlow'),
      glowColor: u('uGlowColor'),
      maskAngle: u('uMaskAngle'),
    };
    gl.uniform1i(u('uImage'), 0);
    gl.uniform2f(u('uLevels'), levels[0], levels[1]);
    gl.uniform1f(u('uRadius'), WIND_RADIUS);
    gl.uniform1f(u('uBreeze'), BREEZE_AMOUNT);
    gl.uniform1f(u('uContrast'), CONTRAST);
    gl.uniform1f(u('uClearing'), CLEAR_ZONE_DENSITY);
    const section = canvas.closest('section') ?? canvas.parentElement!;
    const content = section.querySelector<HTMLElement>('[data-hero-content]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const imageAspect = img.naturalWidth / img.naturalHeight;

    const trail = new Float32Array(RING_SIZE * 3);
    const trailVel = new Float32Array(RING_SIZE * 2);
    let head = 0;
    let lastSampleTime = 0;
    let lastPointer: { x: number; y: number; t: number } | null = null;
    const velocity = { x: 0, y: 0 };

    // Random start so the breeze differs per visit; frozen here under reduced motion.
    const timeOffset = Math.random() * 1000;
    const startTime = performance.now();
    let rafId = 0;
    let lastFrame = performance.now();
    let visible = true;

    // The sun eases to each new position (every minute, or a new ?hour) instead of snapping.
    let look = flatten(lookFor(seattleSun(seattleNow())));
    let lookFrom = look;
    let lookTo = look;
    let tweenStart = 0;
    let tweening = false;

    function setSunTarget(next: Look) {
      lookFrom = look;
      lookTo = flatten(next);
      tweenStart = performance.now();
      tweening = true;
      start();
    }

    function updateSun(now: number) {
      if (!tweening) return;
      const p = easeInOutCubic(clamp01((now - tweenStart) / SUN_TRANSITION));
      look = lookFrom.map((a, i) => mix(a, lookTo[i], p));
      if (p >= 1) tweening = false;
    }

    function resize() {
      const rect = section.getBoundingClientRect();
      canvas.width = Math.max(1, Math.round(rect.width * RESOLUTION));
      canvas.height = Math.max(1, Math.round(rect.height * RESOLUTION));
      gl!.viewport(0, 0, canvas.width, canvas.height);
      gl!.uniform2f(uniforms.resolution, canvas.width, canvas.height);

      // Cover fit: the axis where the photo overflows shows only part of it.
      const aspect = rect.width / (rect.height || 1);
      const cover = aspect > imageAspect ? [1, imageAspect / aspect] : [aspect / imageAspect, 1];
      gl!.uniform2f(uniforms.cover, cover[0] * OVERSCAN, cover[1] * OVERSCAN);
      gl!.uniform2f(uniforms.px, (cover[0] * OVERSCAN) / (rect.width || 1), (cover[1] * OVERSCAN) / (rect.height || 1));

      gl!.uniform2f(uniforms.focusSize, (CLEAR_ZONE_SIZE[0] / 2) * aspect, CLEAR_ZONE_SIZE[1] / 2);
      if (content) {
        const c = content.getBoundingClientRect();
        const h = rect.height || 1;
        gl!.uniform2f(uniforms.focus, (c.left + c.width / 2 - rect.left) / h, (rect.bottom - (c.top + c.height / 2)) / h);
      } else {
        gl!.uniform2f(uniforms.focus, -10, -10);
      }
      render(performance.now());
    }

    function render(now: number) {
      const seconds = reducedMotion ? timeOffset : timeOffset + ((now - startTime) / 1000) * BREEZE_SPEED;
      const l = unflatten(look);
      gl!.uniform1f(uniforms.time, seconds);
      gl!.uniform1f(uniforms.len, l.len);
      gl!.uniform1f(uniforms.skew, l.skew);
      gl!.uniform1f(uniforms.blur, l.blur);
      gl!.uniform1f(uniforms.strength, l.strength);
      gl!.uniform1f(uniforms.glow, l.glow);
      gl!.uniform1f(uniforms.maskAngle, l.maskAngle);
      gl!.uniform3fv(uniforms.wall, l.wall);
      gl!.uniform3fv(uniforms.shade, l.shade);
      gl!.uniform3fv(uniforms.glowColor, l.glowColor);
      gl!.uniform3fv(uniforms.trail, trail);
      gl!.uniform2fv(uniforms.trailVel, trailVel);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
      syncShadowAlpha(l.strength);
    }

    // Keeps the cursor's cast shadow as dark as the leaf shadows (lighter at dusk / night).
    let sharedAlpha = '';
    function syncShadowAlpha(strength: number) {
      const alpha = (SHADOW_ALPHA * strength).toFixed(3);
      if (alpha === sharedAlpha) return;
      sharedAlpha = alpha;
      document.documentElement.style.setProperty('--shadow-alpha', alpha);
    }

    function frame(now: number) {
      const frames = Math.min(now - lastFrame, 100) / (1000 / 60);
      lastFrame = now;
      const decay = Math.pow(DECAY, frames);
      for (let i = 0; i < RING_SIZE; i++) trail[i * 3 + 2] *= decay;
      updateSun(now);
      render(now);
      // Under reduced motion the loop only runs while the sun is easing.
      rafId = visible && (!reducedMotion || tweening) ? requestAnimationFrame(frame) : 0;
    }

    function start() {
      if (rafId || !visible || (reducedMotion && !tweening)) return;
      lastFrame = performance.now();
      rafId = requestAnimationFrame(frame);
    }

    function stop() {
      cancelAnimationFrame(rafId);
      rafId = 0;
    }

    function onPointerMove(e: PointerEvent) {
      if (e.pointerType !== 'mouse' || !visible) return;
      const rect = section.getBoundingClientRect();
      const h = rect.height || 1;
      const x = (e.clientX - rect.left) / h;
      const y = (rect.bottom - e.clientY) / h;
      const now = performance.now();

      if (lastPointer) {
        const dt = Math.max(now - lastPointer.t, 1) / 1000;
        velocity.x = mix(velocity.x, (x - lastPointer.x) / dt, 0.5);
        velocity.y = mix(velocity.y, (y - lastPointer.y) / dt, 0.5);
      }
      lastPointer = { x, y, t: now };

      if (now - lastSampleTime > SAMPLE_INTERVAL) {
        head = (head + 1) % RING_SIZE;
        lastSampleTime = now;
      }

      let px = velocity.x * WIND_STRENGTH;
      let py = velocity.y * WIND_STRENGTH;
      const len = Math.hypot(px, py);
      if (len > MAX_PUSH) {
        px *= MAX_PUSH / len;
        py *= MAX_PUSH / len;
      }
      trail.set([x, y, 1], head * 3);
      trailVel.set([px, py], head * 2);
    }

    canvas.addEventListener('webglcontextlost', (e) => {
      e.preventDefault();
      stop();
      canvas.removeAttribute('data-ready');
    });

    resize();
    canvas.setAttribute('data-ready', '');

    new ResizeObserver(resize).observe(section);
    if (content) new ResizeObserver(resize).observe(content);

    everyMinute(() => setSunTarget(lookFor(seattleSun(seattleNow()))));
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) start();
      else stop();
    }).observe(section);
    if (!reducedMotion) window.addEventListener('pointermove', onPointerMove, { passive: true });
    start();
    return true;
  }
</script>
