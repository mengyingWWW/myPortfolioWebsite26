---
/**
 * Work grid card: a blurred grayscale cover under a frosted panel with the project
 * details. On hover / keyboard focus the panel fades and the cover turns sharp and
 * full color. Every card is 16:9, with or without a cover.
 */
import { Image } from 'astro:assets';
import CoverPlaceholder from '@/components/ui/CoverPlaceholder.astro';
import { workUrl, type WorkEntry } from '@/lib/work';

interface Props {
  project: WorkEntry;
}

const { project } = Astro.props;
const { title, year, type, method, medium, cover, summary } = project.data;
const meta = [year, type, method, medium];
---

<a
  href={workUrl(project)}
  class="work-card"
  aria-label={`${title}: view project`}
  data-cursor="view"
  data-project-card
>
  {
    cover ? (
      <Image src={cover} alt="" class="work-card-image" widths={[720, 1080, 1440, 2160]} sizes="50vw" />
    ) : (
      <CoverPlaceholder title={title} class="work-card-placeholder absolute inset-0" />
    )
  }
  <div class="work-card-frost" aria-hidden="true"></div>
  <div class="work-card-text" aria-hidden="true">
    <ul class="flex items-center text-[14px] text-[#777]">
      {
        meta.map((item, i) => (
          <>
            {i > 0 && <li class="mx-6 h-[18px] w-px bg-[#ddd]" role="presentation" />}
            <li>{item}</li>
          </>
        ))
      }
    </ul>
    <h3 class="mt-3 text-[32px] leading-tight font-medium text-[#111]">{title}</h3>
    <p class="mt-4 max-w-[520px] text-[18px] leading-normal text-[#222]">{summary}</p>
  </div>
</a>

<style>
  .work-card {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .work-card:focus-visible {
    outline: 2px solid #111;
    outline-offset: -2px;
  }

  .work-card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The scale hides the blur's soft edges; overflow keeps it inside the card. */
    filter: grayscale(1) blur(18px);
    transform: scale(1.08);
    transition:
      filter 600ms ease-out,
      transform 600ms ease-out;
  }

  /* The label would ghost through the frost beside the title, so it only appears with the cover. */
  .work-card :global(.work-card-placeholder) {
    color: transparent;
    transition: color 450ms ease;
  }
  .work-card:is(:hover, :focus-visible) :global(.work-card-placeholder) {
    color: #8a8a8a;
  }

  .work-card-frost {
    position: absolute;
    inset: 0;
    background-color: rgb(255 255 255 / 0.68);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: opacity 450ms ease;
  }

  .work-card-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 80px;
    transition: opacity 450ms ease;
  }

  .work-card:is(:hover, :focus-visible) .work-card-frost,
  .work-card:is(:hover, :focus-visible) .work-card-text {
    opacity: 0;
  }

  .work-card:is(:hover, :focus-visible) .work-card-image {
    filter: grayscale(0) blur(0);
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card-image,
    .work-card-frost,
    .work-card-text {
      transition: none;
    }

    .work-card-image {
      transform: none;
    }
  }
</style>
