---
import { workUrl, type WorkEntry } from '@/lib/work';

interface Props {
  project: WorkEntry;
}

const { project } = Astro.props;
const { title, year, status, category, medium, cover, subtitle } = project.data;
const meta = [year, status, category, medium];
---

<a href={workUrl(project)} class="group block" data-cursor="view">
  <div class="aspect-[5/3] overflow-hidden bg-surface">
    <img src={cover} alt={`${title} cover`} class="h-full w-full object-cover" loading="lazy" />
  </div>
  <ul class="mt-5 flex flex-wrap items-center text-sm text-muted">
    {
      meta.map((item, i) => (
        <li class:list={[i > 0 && 'border-l border-line pl-3', i < meta.length - 1 && 'pr-3']}>{item}</li>
      ))
    }
  </ul>
  <h3 class="mt-3 text-2xl font-medium tracking-tight group-hover:text-accent">{title}</h3>
  <p class="mt-3 leading-relaxed">{subtitle}</p>
</a>
