---
/**
 * Work grid card: a meta row (status | domains | role | platform) above a 16:9 cover,
 * then the title and year below it. The cover sits in grayscale and turns full color on hover / keyboard focus.
 */
import { Image } from 'astro:assets';
import CoverPlaceholder from '@/components/ui/CoverPlaceholder.astro';
import { workUrl, type WorkEntry } from '@/lib/work';

interface Props {
  project: WorkEntry;
}

const { project } = Astro.props;
const { title, year, status, domains, role, platform, cover } = project.data;
const { coverScale, coverFocusX, coverFocusY, coverBackground, coverBlend } = project.data;
const meta = [status, domains.join(', '), role, platform];
// Card width = half the container (max 1600px, 40px side padding) minus half the 40px gutter.
// Zooming the cover changes its size on screen, so ask the browser for a proportionally sized file.
const px = (n: number) => Math.round(n);
const coverSizes = `(min-width: 1600px) ${px(740 * coverScale)}px, calc(${px(50 * coverScale)}vw - ${px(60 * coverScale)}px)`;
// Scaled from the top-left corner, a focus point sits at focus × scale; shift it to the middle.
const shift = (focus: number) => `${+(50 - focus * coverScale).toFixed(3)}%`;
---

<a
  href={workUrl(project)}
  class="work-card block"
  aria-label={`${title}, ${year}`}
  data-cursor="view"
  data-project-card
>
  <ul class="work-card-meta mb-3 font-mono text-[13px] text-[#8a8a8a]" aria-hidden="true">
    {meta.map((item) => <li>{item}</li>)}
  </ul>
  <div
    class="work-card-cover"
    style={{
      '--cover-scale': coverScale,
      '--cover-shift-x': shift(coverFocusX),
      '--cover-shift-y': shift(coverFocusY),
      'background-color': coverBackground,
    }}
  >
    {
      cover ? (
        <Image
          src={cover}
          alt=""
          class="work-card-image"
          style={coverBlend && { 'mix-blend-mode': coverBlend }}
          widths={[800, 1200, 1600, 2400]}
          sizes={coverSizes}
          quality={90}
          format="webp"
        />
      ) : (
        <CoverPlaceholder title={title} class="work-card-placeholder absolute inset-0" />
      )
    }
  </div>
  <div class="mt-4 flex items-baseline justify-between gap-6" aria-hidden="true">
    <h3 class="line-clamp-2 text-[28px] leading-[1.2] font-semibold tracking-[-0.015em] text-[#111]">{title}</h3>
    <p class="shrink-0 font-mono text-[13px] text-[#8a8a8a]">{year}</p>
  </div>
</a>

<style>
  .work-card:focus-visible {
    outline: none;
  }

  /* Always one line. The row is one line tall and clipped, so a segment that doesn't fit wraps
     out of sight; segments drop from the end (platform first) and never mid-word. */
  .work-card-meta {
    display: flex;
    flex-wrap: wrap;
    height: 20px;
    overflow: hidden;
    line-height: 20px;
  }
  .work-card-meta li {
    position: relative;
    white-space: nowrap;
  }
  .work-card-meta li + li {
    margin-left: 17px;
  }
  .work-card-meta li + li::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -9px;
    width: 1px;
    height: 11px;
    background: #d4d4d4;
    transform: translateY(-50%);
  }

  .work-card-cover {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 6px;
    /* A blended cover mixes with this box's background only, not the page behind it. */
    isolation: isolate;
  }

  .work-card:focus-visible .work-card-cover {
    outline: 2px solid #111;
    outline-offset: -2px;
  }

  .work-card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translate(var(--cover-shift-x, 0%), var(--cover-shift-y, 0%)) scale(var(--cover-scale, 1));
    transform-origin: 0 0;
    filter: grayscale(1);
    transition: filter 500ms ease;
  }

  .work-card:is(:hover, :focus-visible) .work-card-image {
    filter: grayscale(0);
  }

  /* The label repeats the title under the cover, so it only appears on hover. */
  .work-card :global(.work-card-placeholder) {
    color: transparent;
    transition: color 500ms ease;
  }
  .work-card:is(:hover, :focus-visible) :global(.work-card-placeholder) {
    color: #8a8a8a;
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card-image,
    .work-card :global(.work-card-placeholder) {
      transition: none;
    }
  }
</style>
