---
/**
 * The hero tagline's rotating word, each with its own pencil mark in an SVG overlay, drawn in the
 * About page's sketch style (lines, greys and hatching from handDrawn.js):
 *   shape      one loop around the word, a grey echo loop behind it, hatching along its lower curve
 *   uncover    a cross-hatched patch hides the word; an eraser rubs it away, leaving grey crumbs
 *   translate  small footprints walk beneath the word, each turning grey, then fading
 *   build      a small brick archway over the word: ground line, two piers, voussoirs and a keystone
 * Light comes from the upper left: each mark casts a hatched shadow down and to the right.
 * The word is set a little smaller than the tagline (same face and weight), on its baseline. The first
 * word holds about 1.2s, then each holds about 2.6s; the rotation pauses while the tab is hidden.
 * After the hero has scrolled fully away, coming back to it switches to the next word after a short beat.
 * The slot is as wide as the current word, plus a constant gap each side (its margins); between words
 * its width glides, so only this line moves. Where the line wraps, the wrap is pinned where the widest
 * word puts it, so a narrower word never pulls text up from the line below.
 * Every mark starts once the width has settled and is sized to fit a safe box: the slot and its side
 * margins, between the glyphs of the lines above and below (measured, not guessed), and is clipped to
 * it, so it never covers other text. Purely visual: the caller puts it inside aria-hidden text and
 * gives screen readers the full sentence.
 * Reduced motion: no rotation; "shape" shows as the finished loop, with its echo, lower-curve hatching and cast shadow.
 * Ported from Claude outputs/hero-highlights.html.
 */
interface Props {
  /** In order; the first shows first. Each needs a mark in the script below. */
  words: string[];
}

const { words } = Astro.props;
---

<span class="slot" data-rw-slot data-words={words.join(' ')}
  ><span class="w" data-rw-word>{words[0]}</span><svg class="marks" data-rw-marks></svg></span
>

<style>
  .slot {
    position: relative;
    display: inline-block;
    vertical-align: baseline;
    text-align: center;
    /* The breathing gap: just enough for the archway's piers beside the word. */
    margin: 0 0.5em;
  }
  .w {
    display: inline-block;
    font-size: 0.9em;
    line-height: 1.2;
    transition: opacity 0.25s ease;
  }
  .w.hide {
    opacity: 0;
  }
  .marks {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
</style>

