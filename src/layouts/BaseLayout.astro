---
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@/styles/global.css';
import Nav from '@/components/layout/Nav.astro';
import Footer from '@/components/layout/Footer.astro';
import CustomCursor from '@/components/ui/CustomCursor.astro';
import { site } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  /** Transparent nav over a full-bleed hero (home page). */
  overlayNav?: boolean;
  /** Fade the nav in on load (home page hero entrance). */
  animateNav?: boolean;
}

const { title, description = site.description, overlayNav = false, animateNav = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1200" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Nav overlay={overlayNav} animateIn={animateNav} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CustomCursor />
  </body>
</html>
