---
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource/geist-mono/400.css';
import '@/styles/global.css';
import Nav from '@/components/layout/Nav.astro';
import Footer from '@/components/layout/Footer.astro';
import CustomCursor from '@/components/ui/CustomCursor.astro';
import { site } from '@/data/site';
import { SHADOW_ALPHA } from '@/data/shadow';

interface Props {
  title?: string;
  description?: string;
  /** Transparent nav over a full-bleed hero (home page). */
  overlayNav?: boolean;
  /** Fade the nav in on load (home page hero entrance). */
  animateNav?: boolean;
  /** Keep the page out of search results (e.g. a case study that's still a placeholder). */
  noindex?: boolean;
  /** Leave out the canonical link (e.g. the 404 page, which is served for any missing URL). */
  noCanonical?: boolean;
  /** Social share card (Open Graph / Twitter). Defaults to the homepage card. */
  share?: { title?: string; description?: string; image?: string; imageAlt?: string };
}

const {
  title,
  description = site.description,
  overlayNav = false,
  animateNav = false,
  noindex = false,
  noCanonical = false,
  share = {},
} = Astro.props;
const pageTitle = title ? `${title} — ${site.fullName}` : site.title;
// Always with a trailing slash, matching the sitemap's URLs.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = Astro.site && !noCanonical ? new URL(path, Astro.site).href : undefined;
const shareTitle = share.title ?? site.title;
const shareDescription = share.description ?? site.description;
const shareImage = new URL(share.image ?? site.shareImage.src, Astro.site ?? Astro.url).href;
const shareImageAlt = share.imageAlt ?? site.shareImage.alt;
---

<!doctype html>
<html lang="en" style={`--shadow-alpha: ${SHADOW_ALPHA}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.fullName} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content={String(site.shareImage.width)} />
    <meta property="og:image:height" content={String(site.shareImage.height)} />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={shareImage} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <!-- First in the body, so a page-load overlay (the homepage's EyesAdjustIntro) paints before anything else. -->
    <slot name="intro" />
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav overlay={overlayNav} animateIn={animateNav} />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer />
    <CustomCursor />
  </body>
</html>
